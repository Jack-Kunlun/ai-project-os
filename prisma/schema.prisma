// Email verification evidence contains only status transitions and email
// fingerprints; the raw email remains on AppUser and is never copied here.
// No foreign key is intentional so the evidence survives account cleanup.
model AppUserEmailVerificationAudit {
  id                    String                               @id @default(uuid()) @db.Uuid
  userId                String                               @db.Uuid
  event                 AppUserEmailVerificationAuditEvent
  emailFingerprintBefore String?                             @db.Char(64)
  emailFingerprintAfter  String?                             @db.Char(64)
  verifiedAtBefore      DateTime?
  verifiedAtAfter       DateTime?
  source                String                               @db.VarChar(32)
  reason                String                               @db.VarChar(180)
  transactionId         BigInt                               @default(dbgenerated("txid_current()")) @db.BigInt
  createdAt             DateTime                             @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

// Account access mutation previews are short-lived, single-use control-plane
// records.  They contain only aggregate impact fingerprints; private
// connection names, endpoints and credentials never cross this boundary.
model AccountAccessMutationPreview {
  id                 String              @id @default(uuid()) @db.Uuid
  actorId            String              @db.Uuid
  userId             String              @db.Uuid
  action             AccountAccessAction
  expectedVersion    Int
  impactFingerprint  String              @db.Char(64)
  requestFingerprint String              @db.Char(64)
  issuedAt           DateTime
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime            @default(now())
  actor              AppUser             @relation("AccountAccessPreviewActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  user               AppUser             @relation("AccountAccessPreviewUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  audits             AccountAccessAudit[]

  @@index([actorId, userId, createdAt])
  @@index([expiresAt, consumedAt])
}

// Append-only account lifecycle evidence.  It deliberately stores no email,
// token, endpoint, provider name, tool parameter or other private payload.
model AccountAccessAudit {
  id                       String                 @id @default(uuid()) @db.Uuid
  userId                   String                 @db.Uuid
  actorId                  String                 @db.Uuid
  event                    AccountAccessAuditEvent
  versionBefore            Int
  versionAfter             Int
  disabledAtBefore         DateTime?
  disabledAtAfter          DateTime?
  disabledReasonBefore     String?                @db.VarChar(500)
  disabledReasonAfter      String?                @db.VarChar(500)
  disabledByIdBefore       String?                @db.Uuid
  disabledByIdAfter        String?                @db.Uuid
  previewId                String                 @db.Uuid
  reason                   String                 @db.VarChar(500)
  requestKey               String                 @db.VarChar(180)
  requestFingerprint       String                 @db.Char(64)
  impactFingerprint        String                 @db.Char(64)
  transactionId            BigInt                 @default(dbgenerated("txid_current()")) @db.BigInt
  transitionAt             DateTime               @default(now())
  contractVersion          Int                    @default(1)
  createdAt                DateTime               @default(now())
  user                     AppUser                @relation("AccountAccessAuditUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  actor                    AppUser                @relation("AccountAccessAuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  preview                  AccountAccessMutationPreview @relation(fields: [previewId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([actorId, requestKey])
  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([previewId, createdAt])
}

