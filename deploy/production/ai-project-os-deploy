#!/usr/bin/env bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

readonly RELEASE_TAG=${1-}
readonly EXPECTED_REVISION=${2-}
readonly REPOSITORY_URL=https://github.com/Jack-Kunlun/ai-project-os.git
readonly REPOSITORY_DIR=/srv/ai-project-os/repository
readonly ENV_FILE=/etc/ai-project-os/production.env
readonly COMPOSE_PROJECT=ai-project-os
readonly BACKUP_SCRIPT=/usr/local/sbin/ai-project-os-backup
readonly PRODUCTION_COMPOSE_OVERRIDE=/etc/ai-project-os/compose.operations.yaml
readonly RESULT_FILE=/var/lib/ai-project-os/last-deployment
readonly LOCK_FILE=/run/lock/ai-project-os-deploy.lock

MUTATION_ATTEMPTED=0
WRITER_RECOVERY_REQUIRED=0
OLD_APP_ID=
OLD_WORKER_ID=

if [[ $EUID -ne 0 ]]; then
  printf 'DEPLOY_ROOT_REQUIRED\n' >&2
  exit 70
fi

if [[ "$RELEASE_TAG" != v0.2.0-dev.1 && ! "$RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  printf 'DEPLOY_TAG_INVALID\n' >&2
  exit 64
fi

if [[ ! "$EXPECTED_REVISION" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'DEPLOY_REVISION_INVALID\n' >&2
  exit 65
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  printf 'DEPLOY_ALREADY_RUNNING\n' >&2
  exit 75
fi

for required_command in curl docker flock git grep mktemp python3 sed sha256sum tar; do
  command -v "$required_command" >/dev/null
done

test -r "$ENV_FILE"
test "$(stat -c %U:%G "$ENV_FILE")" = root:root
test "$(stat -c %a "$ENV_FILE")" = 600
grep -qx 'POSTGRES_USER=ai_project_os_cluster_admin' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_USER_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_CLUSTER_ADMIN_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_CLUSTER_ADMIN_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_MIGRATOR_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_MIGRATOR_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -qx 'POSTGRES_RUNTIME_USER=ai_project_os_runtime' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_RUNTIME_USER_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_RUNTIME_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_RUNTIME_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -qx 'POSTGRES_ENTITLEMENT_WRITER_USER=ai_project_os_entitlement_writer' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_ENTITLEMENT_WRITER_USER_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_ENTITLEMENT_WRITER_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_ENTITLEMENT_WRITER_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_ENTITLEMENT_INVENTORY_READER_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_ENTITLEMENT_INVENTORY_READER_PASSWORD_INVALID\n' >&2
  exit 70
}
validate_optional_bootstrap_url() {
  local value
  local -a matches=()
  mapfile -t matches < <(grep -E '^DATABASE_PRINCIPAL_LEGACY_BOOTSTRAP_URL=' "$ENV_FILE" || true)
  (( ${#matches[@]} <= 1 )) || return 1
  if (( ${#matches[@]} == 0 )); then return 0; fi
  value=${matches[0]#*=}
  [[ -z "$value" || "$value" =~ ^postgres(ql)?://[^[:space:]?\#]+$ ]]
}
validate_optional_bootstrap_url || {
  printf 'DEPLOY_DATABASE_PRINCIPAL_LEGACY_BOOTSTRAP_URL_INVALID\n' >&2
  exit 70
}
grep -qx 'AI_PROJECT_OS_SECURE_COOKIES=true' "$ENV_FILE"
grep -qx 'AI_PROJECT_OS_PUBLIC_ORIGIN=https://ai-project-os.com' "$ENV_FILE" || {
  printf 'DEPLOY_PUBLIC_ORIGIN_INVALID\n' >&2
  exit 70
}

validate_github_oauth_env_value() {
  local key=$1
  local value
  local -a matches=()

  mapfile -t matches < <(grep -E "^${key}=" "$ENV_FILE" || true)
  (( ${#matches[@]} == 1 )) || return 1
  value=${matches[0]#*=}
  (( ${#value} >= 8 && ${#value} <= 512 )) || return 1
  [[ "$value" =~ ^[A-Za-z0-9._-]+$ ]]
}

validate_github_oauth_env_value AI_PROJECT_OS_GITHUB_OAUTH_CLIENT_ID || {
  printf 'DEPLOY_GITHUB_OAUTH_CLIENT_ID_INVALID\n' >&2
  exit 70
}
validate_github_oauth_env_value AI_PROJECT_OS_GITHUB_OAUTH_CLIENT_SECRET || {
  printf 'DEPLOY_GITHUB_OAUTH_CLIENT_SECRET_INVALID\n' >&2
  exit 70
}

install -d -o root -g root -m 0755 /srv/ai-project-os
install -d -o root -g root -m 0700 "$(dirname "$RESULT_FILE")"

if [[ ! -d "$REPOSITORY_DIR/.git" ]]; then
  temporary_repository="${REPOSITORY_DIR}.init.$$"
  trap 'rm -rf -- "${temporary_repository-}"' EXIT
  git clone --filter=blob:none --no-checkout "$REPOSITORY_URL" "$temporary_repository"
  chown -R root:root "$temporary_repository"
  mv -- "$temporary_repository" "$REPOSITORY_DIR"
  trap - EXIT
fi

test "$(stat -c %U:%G "$REPOSITORY_DIR")" = root:root
test "$(git -C "$REPOSITORY_DIR" remote get-url origin)" = "$REPOSITORY_URL"

git -C "$REPOSITORY_DIR" fetch --force --no-tags origin \
  "refs/tags/$RELEASE_TAG:refs/tags/$RELEASE_TAG"

if [[ "$(git -C "$REPOSITORY_DIR" cat-file -t "refs/tags/$RELEASE_TAG")" != tag ]]; then
  printf 'DEPLOY_TAG_NOT_ANNOTATED\n' >&2
  exit 66
fi

resolved_revision=$(git -C "$REPOSITORY_DIR" rev-parse "refs/tags/$RELEASE_TAG^{}")
if [[ "$resolved_revision" != "$EXPECTED_REVISION" ]]; then
  printf 'DEPLOY_TAG_REVISION_MISMATCH\n' >&2
  exit 67
fi

ci_runs_url="https://api.github.com/repos/Jack-Kunlun/ai-project-os/actions/workflows/ci.yml/runs?event=push&status=success&head_sha=$EXPECTED_REVISION&per_page=100"
ci_runs_json=$(curl --fail --silent --show-error \
  --header 'Accept: application/vnd.github+json' \
  --header 'X-GitHub-Api-Version: 2022-11-28' \
  "$ci_runs_url")

if ! python3 -c '
import json
import sys

payload = json.load(sys.stdin)
revision, tag = sys.argv[1:3]
accepted = any(
    run.get("head_sha") == revision
    and run.get("head_branch") == tag
    and run.get("event") == "push"
    and run.get("status") == "completed"
    and run.get("conclusion") == "success"
    for run in payload.get("workflow_runs", [])
)
raise SystemExit(0 if accepted else 1)
' "$EXPECTED_REVISION" "$RELEASE_TAG" <<<"$ci_runs_json"; then
  printf 'DEPLOY_TAG_SUCCESSFUL_CI_NOT_FOUND\n' >&2
  exit 72
fi

git -C "$REPOSITORY_DIR" checkout --detach --force "$EXPECTED_REVISION"
test -z "$(git -C "$REPOSITORY_DIR" status --porcelain)"

package_version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$REPOSITORY_DIR/package.json" | head -n 1)
if [[ "v$package_version" != "$RELEASE_TAG" ]]; then
  printf 'DEPLOY_PACKAGE_VERSION_MISMATCH\n' >&2
  exit 68
fi

compose() {
  test -f "$PRODUCTION_COMPOSE_OVERRIDE"
  docker compose \
    --project-name "$COMPOSE_PROJECT" \
    --env-file "$ENV_FILE" \
    --project-directory "$REPOSITORY_DIR" \
    --file "$REPOSITORY_DIR/compose.yaml" \
    --file "$PRODUCTION_COMPOSE_OVERRIDE" \
    "$@"
}

compose config --quiet

run_upgrade_preflight() {
  local phase=$1
  local preflight_output

  preflight_output=$(compose run --rm --no-deps production-upgrade-preflight \
    node node_modules/tsx/dist/cli.mjs scripts/production-upgrade-preflight.ts "$phase")
  grep -Eq '"ok"[[:space:]]*:[[:space:]]*true' <<<"$preflight_output" || {
    printf 'DEPLOY_PRODUCTION_UPGRADE_PREFLIGHT_RESULT_INVALID\n' >&2
    return 1
  }
  grep -Eq '"targetTag"[[:space:]]*:[[:space:]]*"v0\.2\.0-dev\.1"' <<<"$preflight_output" || {
    printf 'DEPLOY_PRODUCTION_UPGRADE_PREFLIGHT_TARGET_INVALID\n' >&2
    return 1
  }
  grep -Eq '"rollback"[[:space:]]*:[[:space:]]*"verified"' <<<"$preflight_output" || {
    printf 'DEPLOY_PRODUCTION_UPGRADE_PREFLIGHT_ROLLBACK_INVALID\n' >&2
    return 1
  }
  printf '%s\n' "$preflight_output"
}

assert_maintenance_isolation() {
  local -a running_services=()
  local postgres_id published_ports
  mapfile -t running_services < <(compose ps --services --status running)
  if (( ${#running_services[@]} != 1 )) || [[ "${running_services[0]}" != postgres ]]; then
    printf 'DEPLOY_MAINTENANCE_SERVICES_NOT_ISOLATED\n' >&2
    return 1
  fi
  postgres_id=$(compose ps -q postgres)
  [[ "$postgres_id" =~ ^[0-9a-f]{64}$ ]] || {
    printf 'DEPLOY_MAINTENANCE_POSTGRES_CONTAINER_INVALID\n' >&2
    return 1
  }
  published_ports=$(docker inspect --format '{{json (index .NetworkSettings.Ports "5432/tcp")}}' "$postgres_id")
  python3 -c '
import json
import sys
try:
    bindings = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    raise SystemExit(1)
accepted = (
    isinstance(bindings, list)
    and len(bindings) == 1
    and isinstance(bindings[0], dict)
    and bindings[0].get("HostIp") == "127.0.0.1"
    and isinstance(bindings[0].get("HostPort"), str)
    and bindings[0]["HostPort"].isdigit()
)
raise SystemExit(0 if accepted else 1)
' <<<"$published_ports" || {
    printf 'DEPLOY_MAINTENANCE_POSTGRES_PORT_NOT_ISOLATED\n' >&2
    return 1
  }
}

container_health() {
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$1"
}

wait_for_old_writers() {
  local attempt app_state worker_state health_body
  for attempt in $(seq 1 60); do
    app_state=$(container_health "$OLD_APP_ID" 2>/dev/null || true)
    worker_state=$(container_health "$OLD_WORKER_ID" 2>/dev/null || true)
    if [[ "$app_state" == healthy && "$worker_state" == healthy ]]; then
      health_body=$(curl --fail --silent --show-error http://127.0.0.1:3000/api/health || true)
      if grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$health_body" \
        && grep -Eq '"database"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body" \
        && grep -Eq '"worker"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body"; then
        return 0
      fi
    fi
    sleep 5
  done
  printf 'DEPLOY_OLD_WRITER_RECOVERY_TIMEOUT\n' >&2
  return 1
}

recover_old_writers_on_failure() {
  local exit_code=$?
  if (( exit_code != 0 && WRITER_RECOVERY_REQUIRED == 1 && MUTATION_ATTEMPTED == 0 )); then
    docker start "$OLD_APP_ID" "$OLD_WORKER_ID" >/dev/null || true
    wait_for_old_writers || true
  fi
  return "$exit_code"
}

trap recover_old_writers_on_failure EXIT

# Build every candidate image while the old app and worker are still serving.
# No database-mutating container has run at this point.
compose build principal-bootstrap migrate reconcile app worker production-upgrade-preflight
run_upgrade_preflight pre-stop

test -x "$BACKUP_SCRIPT"
backup_output=$(AI_PROJECT_OS_DEPLOY_LOCK_HELD=1 "$BACKUP_SCRIPT" pre-deploy "$RELEASE_TAG")
printf '%s\n' "$backup_output"

if grep -q '^BACKUP_SKIPPED_NO_STACK ' <<<"$backup_output"; then
  backup_path=none-first-deploy
  backup_object=none-first-deploy
else
  backup_path=$(sed -n 's/^BACKUP_OK .* source=\([^ ]*\) .*/\1/p' <<<"$backup_output" | tail -n 1)
  backup_object=$(sed -n 's/^BACKUP_OK .* object=\([^ ]*\) .*/\1/p' <<<"$backup_output" | tail -n 1)
  if [[ ! "$backup_path" =~ ^/var/backups/ai-project-os/[^/]+$ ]] || \
    [[ ! "$backup_object" =~ ^cos://[^/]+/production/backups/ ]]; then
    printf 'DEPLOY_PRE_BACKUP_RESULT_INVALID\n' >&2
    exit 69
  fi
fi
readonly backup_path backup_object

wait_for_stack() {
  local attempt postgres_id principal_bootstrap_id migrate_id reconcile_id app_id worker_id
  local postgres_state principal_bootstrap_state migrate_state reconcile_state app_state worker_state health_body

  for attempt in $(seq 1 60); do
    postgres_id=$(compose ps -q postgres)
    principal_bootstrap_id=$(compose ps -aq principal-bootstrap)
    migrate_id=$(compose ps -aq migrate)
    reconcile_id=$(compose ps -aq reconcile)
    app_id=$(compose ps -q app)
    worker_id=$(compose ps -q worker)

    if [[ -n "$postgres_id" && -n "$principal_bootstrap_id" && -n "$migrate_id" && -n "$reconcile_id" && -n "$app_id" && -n "$worker_id" ]]; then
      postgres_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$postgres_id")
      principal_bootstrap_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$principal_bootstrap_id")
      migrate_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$migrate_id")
      reconcile_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$reconcile_id")
      app_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$app_id")
      worker_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$worker_id")

      if [[ "$postgres_state" == healthy && "$principal_bootstrap_state" == exited:0 && "$migrate_state" == exited:0 && "$reconcile_state" == exited:0 && "$app_state" == healthy && "$worker_state" == healthy ]]; then
        health_body=$(curl --fail --silent --show-error http://127.0.0.1:3000/api/health)
        grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$health_body"
        grep -Eq '"version"[[:space:]]*:[[:space:]]*"'"${RELEASE_TAG#v}"'"' <<<"$health_body"
        grep -Eq '"database"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body"
        grep -Eq '"worker"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body"
        grep -Eq '"consecutiveFailures"[[:space:]]*:[[:space:]]*0' <<<"$health_body"
        STACK_HEALTH=$health_body
        STACK_STATES="postgres=$postgres_state principal-bootstrap=$principal_bootstrap_state migrate=$migrate_state reconcile=$reconcile_state app=$app_state worker=$worker_state"
        return 0
      fi
    fi

    sleep 5
  done

  printf 'DEPLOY_STACK_HEALTH_TIMEOUT\n' >&2
  compose ps -a >&2
  return 1
}

perform_writer_cutover() {
  local source_health
  OLD_APP_ID=$(compose ps -q app)
  OLD_WORKER_ID=$(compose ps -q worker)
  if [[ ! "$OLD_APP_ID" =~ ^[0-9a-f]{64}$ || ! "$OLD_WORKER_ID" =~ ^[0-9a-f]{64}$ ]]; then
    printf 'DEPLOY_OLD_WRITER_CONTAINER_INVALID\n' >&2
    return 69
  fi
  if [[ "$(container_health "$OLD_APP_ID")" != healthy || "$(container_health "$OLD_WORKER_ID")" != healthy ]]; then
    printf 'DEPLOY_OLD_WRITER_NOT_HEALTHY\n' >&2
    return 69
  fi
  source_health=$(curl --fail --silent --show-error http://127.0.0.1:3000/api/health) || {
    printf 'DEPLOY_SOURCE_HEALTH_UNAVAILABLE\n' >&2
    return 69
  }
  if ! grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$source_health" \
    || ! grep -Eq '"version"[[:space:]]*:[[:space:]]*"5\.1\.2"' <<<"$source_health" \
    || ! grep -Eq '"database"[[:space:]]*:[[:space:]]*"up"' <<<"$source_health" \
    || ! grep -Eq '"worker"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"up"' <<<"$source_health"; then
    printf 'DEPLOY_SOURCE_STACK_INVALID\n' >&2
    return 69
  fi

  # The clean-slate migration is a maintenance-window migration. Capture and
  # stop the exact healthy writer containers before the final read-only check.
  WRITER_RECOVERY_REQUIRED=1
  docker stop "$OLD_APP_ID" "$OLD_WORKER_ID" >/dev/null
  if [[ "$(docker inspect --format '{{.State.Running}}' "$OLD_APP_ID")" != false \
    || "$(docker inspect --format '{{.State.Running}}' "$OLD_WORKER_ID")" != false ]]; then
    printf 'DEPLOY_OLD_WRITER_STOP_FAILED\n' >&2
    return 69
  fi
  assert_maintenance_isolation
  run_upgrade_preflight post-stop
  assert_maintenance_isolation

  # From this point onward the database may have been changed. Never restart
  # an old application against a partially or fully upgraded schema.
  MUTATION_ATTEMPTED=1
  compose up -d --no-build --force-recreate principal-bootstrap migrate reconcile app worker
  wait_for_stack
  WRITER_RECOVERY_REQUIRED=0
}

perform_writer_cutover

public_health=$(curl --fail --silent --show-error https://ai-project-os.com/api/health)
grep -Eq '"version"[[:space:]]*:[[:space:]]*"'"${RELEASE_TAG#v}"'"' <<<"$public_health"
grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$public_health"

completed_at=$(date -Is)
{
  printf 'DEPLOY_OK\n'
  printf 'tag=%s\n' "$RELEASE_TAG"
  printf 'revision=%s\n' "$EXPECTED_REVISION"
  printf 'states=%s\n' "$STACK_STATES"
  printf 'health=%s\n' "$STACK_HEALTH"
  printf 'backup=%s\n' "$backup_path"
  printf 'backup_object=%s\n' "$backup_object"
  printf 'completed_at=%s\n' "$completed_at"
} > "$RESULT_FILE"

chmod 600 "$RESULT_FILE"

printf 'DEPLOY_OK tag=%s revision=%s backup=%s backup_object=%s\n' \
  "$RELEASE_TAG" "$EXPECTED_REVISION" "$backup_path" "$backup_object"
