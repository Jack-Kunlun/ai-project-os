model Project {
  id                                   String                                @id @default(uuid()) @db.Uuid
  workspaceId                          String                                @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  membershipInheritanceMode            ProjectMembershipInheritanceMode     @default(projectOnly)
  name                                 String
  slug                                 String                                @unique
  description                          String?                               @db.Text
  archivedAt                           DateTime?
  createdAt                            DateTime                              @default(now())
  updatedAt                            DateTime                              @updatedAt
  sources                              ProjectSource[]
  assets                               ProjectAsset[]
