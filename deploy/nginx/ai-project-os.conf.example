# Place this file inside nginx's http context after replacing the example
# hostname and certificate paths. Keep the application port private.

limit_req_zone $binary_remote_addr zone=ai_project_os_auth:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name project-os.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name project-os.example.com;

    ssl_certificate /etc/letsencrypt/live/project-os.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/project-os.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 56m;

    location = /api/auth/login {
        limit_req zone=ai_project_os_auth burst=5 nodelay;
        include /etc/nginx/snippets/ai-project-os-proxy.conf;
    }

    location = /api/setup {
        limit_req zone=ai_project_os_auth burst=3 nodelay;
        include /etc/nginx/snippets/ai-project-os-proxy.conf;
    }

    location ~ ^/api/auth/oidc/start/ {
        limit_req zone=ai_project_os_auth burst=5 nodelay;
        include /etc/nginx/snippets/ai-project-os-proxy.conf;
    }

    location / {
        include /etc/nginx/snippets/ai-project-os-proxy.conf;
    }
}
