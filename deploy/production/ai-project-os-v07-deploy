    return 69
  fi
  if [[ "$(container_health "$OLD_APP_ID")" != healthy || "$(container_health "$OLD_WORKER_ID")" != healthy ]]; then
    printf 'DEPLOY_OLD_WRITER_NOT_HEALTHY\n' >&2
    return 69
  fi
  unexpected_git_worker_ids=$(docker ps -aq --no-trunc \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter 'label=com.docker.compose.service=git-worker') || return 69
  if [[ -n "$unexpected_git_worker_ids" ]]; then
    printf 'V07_SOURCE_GIT_WORKER_UNEXPECTED\n' >&2
    return 69
  fi
  source_health=$(curl --fail --silent --show-error http://127.0.0.1:3000/api/health) || {
    printf 'DEPLOY_SOURCE_HEALTH_UNAVAILABLE\n' >&2
    return 69
  }
  if ! grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$source_health" \
    || ! grep -Fq '"version":"'"${SOURCE_TAG#v}"'"' <<<"$(tr -d '[:space:]' <<<"$source_health")" \
    || ! grep -Eq '"database"[[:space:]]*:[[:space:]]*"up"' <<<"$source_health" \
    || ! grep -Eq '"worker"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"up"' <<<"$source_health"; then
    printf 'DEPLOY_SOURCE_STACK_INVALID\n' >&2
    return 69
  fi

  WRITER_RECOVERY_REQUIRED=1
}

capture_source_writers

stop_source_writers() {
  if [[ ! "$OLD_APP_ID" =~ ^[0-9a-f]{64}$ || ! "$OLD_WORKER_ID" =~ ^[0-9a-f]{64}$ ]]; then
    printf 'DEPLOY_OLD_WRITER_CONTAINER_INVALID\n' >&2
    return 69
  fi

  # Stop the exact healthy writers before taking the final migration backup.
  # A Docker pause does not drain already-dispatched PostgreSQL transactions.
  docker stop "$OLD_APP_ID" "$OLD_WORKER_ID" >/dev/null
  if [[ "$(docker inspect --format '{{.State.Running}}:{{.State.Paused}}' "$OLD_APP_ID")" != false:false \
    || "$(docker inspect --format '{{.State.Running}}:{{.State.Paused}}' "$OLD_WORKER_ID")" != false:false ]]; then
    printf 'DEPLOY_OLD_WRITER_STOP_FAILED\n' >&2
    return 69
  fi

  assert_maintenance_isolation
  run_upgrade_preflight post-stop
  assert_maintenance_isolation
}

