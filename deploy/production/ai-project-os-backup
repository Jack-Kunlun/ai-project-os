  fi
fi

exec 9>"$LOCK_FILE"
if ! flock -w "$LOCK_WAIT_SECONDS" 9; then
  fail 'BACKUP_ALREADY_RUNNING' 75
fi

for required_command in age awk basename chmod chown cp cut date df dirname docker find flock getent gzip grep install ln mktemp mv openssl rm sed sha256sum sort stat tail tar timeout tr; do
  command -v "$required_command" >/dev/null || fail "BACKUP_COMMAND_MISSING command=$required_command" 70
done

