# Copy this file to .env and set the required local-only values before starting.
# Keep .env uncommitted; this example intentionally contains no usable secret.
POSTGRES_USER=ai_project_os
POSTGRES_PASSWORD=
POSTGRES_DB=ai_project_os
DATABASE_URL=
APP_PORT=3000
# Keep these defaults for the normal local deployment. Use unique values only
# for an explicitly isolated validation stack; never reuse production volumes.
POSTGRES_PORT=5433
AI_PROJECT_OS_PGDATA_VOLUME=ai-project-os-pgdata
AI_PROJECT_OS_SECRETS_VOLUME=ai-project-os-secrets
AI_PROJECT_OS_UPLOADS_VOLUME=ai-project-os-uploads
# Set to true only when every browser request is served through HTTPS.
AI_PROJECT_OS_SECURE_COOKIES=false
# Canonical browser origin used for OAuth callbacks and redirects.
AI_PROJECT_OS_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional GitHub OAuth App credentials. Leave both empty to keep GitHub login
# visibly unavailable. Register /api/auth/github/callback for this deployment.
AI_PROJECT_OS_GITHUB_OAUTH_CLIENT_ID=
AI_PROJECT_OS_GITHUB_OAUTH_CLIENT_SECRET=
# Lowercase deployment identifier shared by the app and automation worker.
AI_PROJECT_OS_WORKER_NAME=automation-primary

# Authoritative server-side upload policy for registered versions and durable
# upload reservations. These defaults are also shown in the project file page
# and guide; invalid overrides fail closed at request time. Disk waterline,
# backups and physical purge remain operational responsibilities.
AI_PROJECT_OS_UPLOAD_MAX_FILES=10
AI_PROJECT_OS_UPLOAD_MAX_FILE_BYTES=26214400
AI_PROJECT_OS_UPLOAD_MAX_IMAGE_BYTES=10485760
AI_PROJECT_OS_UPLOAD_MAX_REQUEST_BYTES=31457280
AI_PROJECT_OS_UPLOAD_MAX_PROJECT_BYTES=1073741824
AI_PROJECT_OS_UPLOAD_MAX_WORKSPACE_BYTES=5368709120
AI_PROJECT_OS_UPLOAD_MAX_DEPLOYMENT_BYTES=21474836480
AI_PROJECT_OS_UPLOAD_MAX_PROJECT_ASSETS=100
AI_PROJECT_OS_UPLOAD_MAX_PROJECT_RETAINED_OBJECTS=1000
AI_PROJECT_OS_UPLOAD_MAX_WORKSPACE_RETAINED_OBJECTS=5000
AI_PROJECT_OS_UPLOAD_MAX_DEPLOYMENT_RETAINED_OBJECTS=20000
AI_PROJECT_OS_UPLOAD_MAX_UPLOADS_PER_MINUTE=20
AI_PROJECT_OS_UPLOAD_MAX_CONCURRENT=2
AI_PROJECT_OS_UPLOAD_MAX_GLOBAL_CONCURRENT=2
AI_PROJECT_OS_UPLOAD_ADMISSION_LEASE_MS=900000
AI_PROJECT_OS_UPLOAD_PARSE_LEASE_MS=1800000
AI_PROJECT_OS_UPLOAD_BODY_TIMEOUT_MS=120000
