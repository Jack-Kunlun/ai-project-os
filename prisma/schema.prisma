  createdAt  DateTime              @default(now())
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor      AppUser               @relation("ProjectPlanAuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@index([projectId, entityType, entityId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model WebAiCandidate {
  id                   String               @id @default(uuid()) @db.Uuid
  projectId            String               @db.Uuid
  jobId                String               @db.Uuid
  sourceId             String               @db.Uuid
  projectItemId        String               @unique @db.Uuid
  providerConnectionId String               @db.Uuid
  modelId              String               @db.VarChar(128)
  candidateFingerprint String               @db.Char(64)
  reviewStatus         WebAiCandidateStatus @default(candidate)
  reviewedAt           DateTime?
  reviewedBy           String?              @db.VarChar(128)
  createdAt            DateTime             @default(now())
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job                  BackgroundJob        @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  source               ProjectSource        @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  projectItem          ProjectItem          @relation("WebAiCandidateItem", fields: [projectId, projectItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  providerConnection   AiProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, sourceId, candidateFingerprint])
  @@unique([projectId, projectItemId])
  @@index([projectId, reviewStatus, createdAt])
}

model ProviderCallAudit {
  id                   String               @id @default(uuid()) @db.Uuid
  jobId                String?              @db.Uuid
  webAiGrantId         String?              @db.Uuid
  /// Stable non-FK evidence identity retained when the project grant is cascaded.
  webAiGrantReferenceId String?             @db.Uuid
  webAiGrantProjectId   String?             @db.Uuid
  providerConnectionId String               @db.Uuid
  operation            AiOperation
  modelId              String               @db.VarChar(128)
  billingMode          AiBillingMode        @default(legacy)
  billingUserId        String               @db.Uuid
  callKey              String               @db.VarChar(128)
  reservationId        String?              @unique @db.Uuid
  routeSource          String?              @db.VarChar(32)
  routeId              String?              @db.Uuid
  routeVersion         Int?
  routeUpdatedAt       DateTime?
  providerConfigurationVersion Int?
  quotaMultiplierBps   Int?
  routeFenceFingerprint String?             @db.Char(64)
  credentialSecretFingerprint String?       @db.Char(64)
  personalDelegationId  String?             @db.Uuid
  personalDelegationVersion Int?
  personalDelegationFingerprint String?     @db.Char(64)
  effectiveRouteSelectionId String?         @db.Uuid
  effectiveRouteSelectionVersion Int?
  effectiveRouteSelectionUpdatedAt DateTime?
  payerKind             AiRuntimePayerKind?
  payerProviderConnectionId String?         @db.Uuid
  ownerProjectMembershipId String?           @db.Uuid
  ownerMembershipCreatedAt DateTime?
  ownerSubscriptionId   String?             @db.Uuid
  ownerSubscriptionVersion Int?
  ownerSubscriptionStartsAt DateTime?
  ownerSubscriptionExpiresAt DateTime?
  connectionOwnerAccountAccessVersion Int?
  projectConfirmedById String?               @db.Uuid
  projectConfirmedProjectMembershipId String? @db.Uuid
  projectConfirmedMembershipCreatedAt DateTime?
  selectedById          String?               @db.Uuid
  selectedByProjectMembershipId String?       @db.Uuid
  selectedByMembershipCreatedAt DateTime?
  embeddingDimensions   Int?
  maxOutputTokens       Int?
  status               String               @db.VarChar(32)
  safeErrorCode        String?              @db.VarChar(64)
  providerRequestId    String?              @db.VarChar(256)
  inputTokens          Int                  @default(0)
  outputTokens         Int                  @default(0)
  usageKnown            Boolean              @default(false)
  createdAt            DateTime             @default(now())
  completedAt          DateTime?
  job                  BackgroundJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  webAiGrant           WebAiGrant?          @relation("WebAiGrantProviderCalls", fields: [webAiGrantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  providerConnection   AiProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  reservation          PlatformTokenReservation? @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@index([jobId, createdAt])
  @@index([webAiGrantId, createdAt])
  @@index([webAiGrantReferenceId, createdAt])
  @@index([providerConnectionId, createdAt])
  @@index([billingUserId, createdAt])
  @@index([callKey])
  @@index([reservationId])
  @@index([webAiGrantReferenceId, personalDelegationId, effectiveRouteSelectionId], map: "ProviderCallAudit_personal_runtime_evidence_idx")
  @@unique([jobId, callKey])
}
