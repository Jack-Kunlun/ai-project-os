  @@index([email, expiresAt])
  @@index([projectId, expiresAt])
}

model OidcProvider {
  id                         String                  @id @default(uuid()) @db.Uuid
  workspaceId                String                  @db.Uuid
  name                       String                  @db.VarChar(100)
  issuerUrl                  String                  @db.VarChar(2048)
  clientId                   String                  @db.VarChar(512)
  credentialId               String                  @unique @db.Uuid
  tokenAuthMethod            OidcTokenAuthMethod     @default(clientSecretBasic)
  scopes                     Json                    @default("[\"openid\",\"profile\",\"email\"]") @db.JsonB
  allowPrivateNetwork        Boolean                 @default(false)
  autoProvision              Boolean                 @default(false)
  defaultWorkspaceRole       WorkspaceMembershipRole @default(viewer)
  allowedEmailDomains        Json                    @default("[]") @db.JsonB
  authorizationEndpoint      String?                 @db.VarChar(2048)
  tokenEndpoint              String?                 @db.VarChar(2048)
  jwksUri                    String?                 @db.VarChar(2048)
  endSessionEndpoint         String?                 @db.VarChar(2048)
  resolvedAddressFingerprint String?                 @db.Char(64)
  tokenAddressFingerprint    String?                 @db.Char(64)
  jwksAddressFingerprint     String?                 @db.Char(64)
  status                     OidcProviderStatus      @default(configured)
  lastTestedAt               DateTime?
  lastErrorCode              String?                 @db.VarChar(64)
  disabledAt                 DateTime?
  createdById                String                  @db.Uuid
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  workspace                  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  credential                 ExternalCredential      @relation(fields: [credentialId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  createdBy                  AppUser                 @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  identities                 OidcIdentity[]
  loginAttempts              OidcLoginAttempt[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, issuerUrl, clientId])
  @@index([workspaceId, status, updatedAt])
  @@index([createdById, createdAt])
}

