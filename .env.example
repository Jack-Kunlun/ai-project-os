# Copy this file to .env and set the required local-only values before starting.
# Keep .env uncommitted; this example intentionally contains no usable secret.
POSTGRES_USER=ai_project_os
POSTGRES_PASSWORD=
POSTGRES_DB=ai_project_os
DATABASE_URL=
APP_PORT=3000
# Keep these defaults for the normal local deployment. Use unique values only
# for an explicitly isolated validation stack; never reuse production volumes.
POSTGRES_PORT=5433
AI_PROJECT_OS_PGDATA_VOLUME=ai-project-os-pgdata
AI_PROJECT_OS_SECRETS_VOLUME=ai-project-os-secrets
AI_PROJECT_OS_UPLOADS_VOLUME=ai-project-os-uploads
# Set to true only when every browser request is served through HTTPS.
AI_PROJECT_OS_SECURE_COOKIES=false
# Lowercase deployment identifier shared by the app and automation worker.
AI_PROJECT_OS_WORKER_NAME=automation-primary
