generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectSourceKind {
  document
  screenshot
  github
  manual
}

enum ProjectItemType {
  decision
  progress
  issue
  risk
}

enum ProjectItemReviewStatus {
  candidate
  confirmed
  dismissed
  superseded
}

enum ContentOriginScope {
  project
  repository_link
}

enum ProjectItemEvidenceRole {
  primary
  supporting
}

enum ProjectItemEvidenceState {
  active
  purged
}

enum ProjectEvidenceRangeUnit {
  utf8_byte
  line
}

enum ProjectItemRevisionAction {
  legacyImport   @map("legacy_import")
  manualCreated  @map("manual_created")
  aiCreated      @map("ai_created")
  edited
  confirmed
  dismissed
  reopened
  rebindSource   @map("rebind_source")
  repairEvidence @map("repair_evidence")
}

enum ProjectItemRevisionIntegrityState {
  active
  purged_redacted
}

enum EmbeddingProvider {
  openai
}

enum EmbeddingNormalization {
  unit_length
}

enum SourceChunkState {
  active
  purged
}

enum ProjectCorpusGenerationStatus {
  staging
  complete
  failed
  ineligible
  superseded
}

enum IndexGenerationKind {
  projectCorpus      @map("project_corpus")
  repositoryMaterial @map("repository_material")
  repositoryCode     @map("repository_code")
}

enum IndexGenerationStatus {
  staging
  building
  ragReady                 @map("rag_ready")
  ragReadyEmpty            @map("rag_ready_empty")
  semanticDisabledByPolicy @map("semantic_disabled_by_policy")
  failed
  unknown
  cancelled
  ineligible
  superseded
}

enum IndexInputEntryKind {
  projectCorpus      @map("project_corpus")
  repositoryMaterial @map("repository_material")
  repositoryCode     @map("repository_code")
}

enum IndexBuildAttemptStatus {
  queued
  running
  succeeded
  failed
  unknown
  cancelled
}

enum IndexWorkItemStatus {
  queued
  running
  succeeded
  failed
  unknown
  cancelled
}

enum ProjectRagSnapshotStatus {
  staging
  complete
  ineligible
  superseded
}

enum AiDerivedArtifactKind {
  sourceSummary @map("source_summary")
  projectBrief @map("project_brief")
  ragAnswer @map("rag_answer")
  agentReport @map("agent_report")
}

enum AiDerivedArtifactState {
  active
  stale
  restricted
}

enum ArtifactDependencyKind {
  projectSource @map("project_source")
  projectRagSnapshot @map("project_rag_snapshot")
}

enum ArtifactRestrictionReasonCode {
  grantIneligible @map("GRANT_INELIGIBLE")
  policyIneligible @map("POLICY_INELIGIBLE")
  snapshotIneligible @map("SNAPSHOT_INELIGIBLE")
  dependencyMismatch @map("DEPENDENCY_MISMATCH")
}

enum ProjectScanTrigger {
  manual
  system
}

enum ProjectScanStatus {
  running
  completed
  failed
}

enum ModelProcessingGrantSourceKind {
  manual_text
}

enum ModelProcessingGrantStatus {
  draft
  issued
  revoked
}

enum ModelProcessingGrantRevocationReasonCode {
  userRequested
  policyChanged
  expired
  scannerFinding
  budgetExceeded
  securityReview
}

enum AiOperation {
  embedding
  autoExtract
  sourceSummary
  projectAnalysis
  generateWithContext
}

enum AiRunStatus {
  queued
  running
  succeeded
  failed
  unknown
  cancelled
}

enum AiRunAttemptStatus {
  sent
  succeeded
  failed
  unknown
  cancelled
}

enum AiBudgetProfile {
  standard
}

enum AiBudgetStatus {
  pending
  allowed
  exhausted
  exceeded
  rejected
}

enum AiSafeScanResult {
  passed
  blocked
  unavailable
}

enum AiAuditEventType {
  policyCreated
  policyAdvanced
  grantIssued
  grantRevoked
  preflightRejected
  scannerRejected
  budgetRejected
  runCreated
  runClaimed
  dispatchSent
  runSucceeded
  runFailed
  runUnknown
  runCancelled
  attemptSucceeded
  attemptFailed
  attemptUnknown
  attemptCancelled
}

enum AiSafeErrorCode {
  aiDisabled               @map("AI_DISABLED")
  aiProviderDisabled       @map("AI_PROVIDER_DISABLED")
  aiInvalidOperationKeyInput @map("AI_INVALID_OPERATION_KEY_INPUT")
  aiInvalidStateTransition @map("AI_INVALID_STATE_TRANSITION")
  aiRedispatchForbidden    @map("AI_REDISPATCH_FORBIDDEN")
  aiProviderIncomplete     @map("AI_PROVIDER_INCOMPLETE")
  aiProviderUnknown        @map("AI_PROVIDER_UNKNOWN")
  aiProviderFailed         @map("AI_PROVIDER_FAILED")
  aiProviderCancelled      @map("AI_PROVIDER_CANCELLED")
  aiDispatchNotSent        @map("AI_DISPATCH_NOT_SENT")
  aiPolicyDenied           @map("AI_POLICY_DENIED")
  aiGrantDenied            @map("AI_GRANT_DENIED")
  aiScannerDenied          @map("AI_SCANNER_DENIED")
  aiBudgetDenied           @map("AI_BUDGET_DENIED")
  aiInvalidProviderResponse @map("AI_INVALID_PROVIDER_RESPONSE")
  sourceInUse              @map("SOURCE_IN_USE")
}

enum AiCandidateReviewStatus {
  candidate
  accepted
  dismissed
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sources     ProjectSource[]
  items       ProjectItem[]
  scans       ProjectScan[]
  snapshots   ProjectSnapshot[]
  aiPolicy    ProjectAiPolicy?
  aiPolicyRevisions ProjectAiPolicyRevision[]
  aiPolicyOperationProfiles ProjectAiPolicyOperationProfile[]
  aiGrants    ModelProcessingGrant[]
  aiGrantSources ModelProcessingGrantSource[]
  aiGrantOperations ModelProcessingGrantOperation[]
  aiRuns      AiRun[]
  aiAttempts  AiRunAttempt[]
  aiInputSources AiRunInputSource[]
  aiAuditEvents AiAuditEvent[]
  aiCandidateBatches AiCandidateBatch[]
  aiCandidateClaims AiCandidateClaim[]
  itemEvidences ProjectItemEvidence[]
  itemRevisions ProjectItemRevision[]
  itemRevisionEvidences ProjectItemRevisionEvidence[]
  sourceChunks SourceChunk[]
  corpusGenerations ProjectCorpusGeneration[]
  indexGenerations IndexGeneration[]
  indexBuildAttempts IndexBuildAttempt[]
  indexWorkItems IndexWorkItem[]
  chunkEmbeddings ChunkEmbedding[]
  corpusIndexPointer ProjectCorpusIndexPointer?
  ragSnapshots ProjectRagSnapshot[]
  ragSnapshotPointer ProjectRagSnapshotPointer?
  aiDerivedArtifacts AiDerivedArtifact[]
  artifactDependencies ArtifactDependency[]

  @@index([updatedAt])
}

model ProjectSource {
  id                      String             @id @default(uuid()) @db.Uuid
  projectId               String             @db.Uuid
  kind                    ProjectSourceKind
  originScope             ContentOriginScope @default(project)
  projectRepositoryLinkId String?            @db.Uuid
  sourceIdentity          String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionKey             String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalRef             String?
  contentText             String             @db.Text
  contentHash             String
  manualContentDedupeKey  String?            @db.VarChar(64)
  storageKey              String?
  capturedAt              DateTime?
  ingestedAt              DateTime           @default(now())
  project                 Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items                   ProjectItem[]       @relation("SourceItems")
  itemEvidences           ProjectItemEvidence[] @relation("EvidenceProjectSource")
  grantSources            ModelProcessingGrantSource[]
  aiRunInputs             AiRunInputSource[]
  aiCandidateClaims       AiCandidateClaim[]
  sourceChunks            SourceChunk[]       @relation("ChunkProjectSource")
  corpusGenerationEntries ProjectCorpusGenerationEntry[]
  artifactDependencies    ArtifactDependency[]

  @@index([projectId, capturedAt])
  @@unique([projectId, id])
  @@unique([projectId, id, originScope])
  @@unique([projectId, id, originScope, projectRepositoryLinkId])
  @@unique([projectId, sourceIdentity, revisionKey])
  @@unique([projectId, id, originScope, revisionKey, contentHash])
}

model ProjectItem {
  id               String                   @id @default(uuid()) @db.Uuid
  projectId        String                   @db.Uuid
  type             ProjectItemType
  reviewStatus     ProjectItemReviewStatus  @default(candidate)
  sourceId         String                   @db.Uuid
  title            String
  content          String                   @db.Text
  sourceExcerpt    String?                  @db.Text
  occurredAt       DateTime?
  confirmedAt      DateTime?
  supersedesItemId String?                  @db.Uuid
  metadata         Json                     @default("{}") @db.JsonB
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source           ProjectSource            @relation("SourceItems", fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  supersedesItem   ProjectItem?             @relation("ItemSupersession", fields: [projectId, supersedesItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  supersededBy     ProjectItem[]            @relation("ItemSupersession")
  aiCandidateClaim AiCandidateClaim?        @relation("AiCandidateItem")
  evidences        ProjectItemEvidence[]
  revisions        ProjectItemRevision[]

  @@index([projectId, reviewStatus])
  @@index([projectId, type])
  @@index([sourceId])
  @@index([supersedesItemId])
  @@unique([projectId, id])
}

model ProjectItemEvidence {
  id                       String                   @id @default(uuid()) @db.Uuid
  projectId                String                   @db.Uuid
  projectItemId            String                   @db.Uuid
  role                     ProjectItemEvidenceRole
  evidenceState            ProjectItemEvidenceState @default(active)
  originScope              ContentOriginScope       @default(project)
  projectRepositoryLinkId  String?                  @db.Uuid
  projectSourceId          String?                  @db.Uuid
  sourceExcerpt            String?                  @db.Text
  sourceExcerptFingerprint String?                  @db.VarChar(64)
  rangeUnit                ProjectEvidenceRangeUnit?
  rangeStart               Int?
  rangeEnd                 Int?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  supersededAt             DateTime?
  purgedAt                 DateTime?
  deletionReceipt          String?                  @db.Uuid
  project                  Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item                     ProjectItem              @relation(fields: [projectId, projectItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  projectSource            ProjectSource?           @relation("EvidenceProjectSource", fields: [projectId, projectSourceId, originScope], references: [projectId, id, originScope], onDelete: NoAction, onUpdate: Cascade)
  revisionLinks            ProjectItemRevisionEvidence[]

  @@unique([projectId, id])
  @@unique([projectId, projectItemId, id])
  @@index([projectId, projectItemId, isActive])
  @@index([projectId, projectSourceId])
}

model ProjectItemRevision {
  id                          String                            @id @default(uuid()) @db.Uuid
  projectId                   String                            @db.Uuid
  projectItemId               String                            @db.Uuid
  revisionNumber              Int
  action                      ProjectItemRevisionAction
  actorId                     String                            @db.VarChar(128)
  reason                      String?                           @db.Text
  itemType                    ProjectItemType
  reviewStatus                ProjectItemReviewStatus
  title                       String
  content                     String                            @db.Text
  sourceId                    String?                           @db.Uuid
  sourceExcerpt               String?                           @db.Text
  occurredAt                  DateTime?
  confirmedAt                 DateTime?
  supersedesItemId            String?                           @db.Uuid
  metadata                    Json                              @db.JsonB
  evidenceManifestFingerprint String?                           @db.VarChar(64)
  integrityState              ProjectItemRevisionIntegrityState @default(active)
  deletionReceipt             String?                           @db.Uuid
  createdAt                   DateTime                          @default(now())
  project                     Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item                        ProjectItem                       @relation(fields: [projectId, projectItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  evidenceLinks               ProjectItemRevisionEvidence[]

  @@unique([projectId, id])
  @@unique([projectId, projectItemId, id])
  @@unique([projectId, projectItemId, revisionNumber])
  @@index([projectId, projectItemId, createdAt])
}

model ProjectItemRevisionEvidence {
  id            String                  @id @default(uuid()) @db.Uuid
  projectId     String                  @db.Uuid
  projectItemId String                  @db.Uuid
  revisionId    String                  @db.Uuid
  evidenceId    String                  @db.Uuid
  role          ProjectItemEvidenceRole
  createdAt     DateTime                @default(now())
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision      ProjectItemRevision     @relation(fields: [projectId, projectItemId, revisionId], references: [projectId, projectItemId, id], onDelete: NoAction, onUpdate: Cascade)
  evidence      ProjectItemEvidence     @relation(fields: [projectId, projectItemId, evidenceId], references: [projectId, projectItemId, id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, revisionId, evidenceId])
  @@index([projectId, projectItemId, revisionId])
  @@index([projectId, projectItemId, evidenceId])
}

model EmbeddingProfile {
  id                 String                 @id @default(uuid()) @db.Uuid
  provider           EmbeddingProvider
  modelId            String                 @db.VarChar(128)
  dimensions         Int
  normalization      EmbeddingNormalization
  profileVersion     String                 @db.VarChar(128)
  profileFingerprint String                 @unique @db.VarChar(64)
  createdAt          DateTime               @default(now())
  indexGenerations   IndexGeneration[]
  chunkEmbeddings    ChunkEmbedding[]

  @@unique([provider, modelId, dimensions, normalization, profileVersion])
}

model SourceChunk {
  id                       String             @id @default(uuid()) @db.Uuid
  projectId                String             @db.Uuid
  originScope              ContentOriginScope @default(project)
  projectRepositoryLinkId  String?            @db.Uuid
  projectSourceId          String?            @db.Uuid
  sourceRevisionKey        String?            @db.Uuid
  sourceContentHash        String?            @db.VarChar(64)
  ordinal                  Int
  rangeUnit                ProjectEvidenceRangeUnit
  rangeStart               Int
  rangeEnd                 Int
  chunkerVersion           String             @db.VarChar(128)
  contentText              String?            @db.Text
  contentHash              String?            @db.VarChar(64)
  contentBytes             Int?
  state                    SourceChunkState   @default(active)
  createdAt                DateTime           @default(now())
  purgedAt                 DateTime?
  deletionReceipt          String?            @db.Uuid
  project                  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSource            ProjectSource?     @relation("ChunkProjectSource", fields: [projectId, projectSourceId, originScope, sourceRevisionKey, sourceContentHash], references: [projectId, id, originScope, revisionKey, contentHash], onDelete: NoAction, onUpdate: Cascade)
  corpusGenerationEntries ProjectCorpusGenerationEntry[]
  indexInputEntries       IndexGenerationInputEntry[]
  chunkEmbeddings         ChunkEmbedding[]

  @@unique([projectId, id])
  @@unique([projectId, id, originScope])
  @@unique([projectId, id, originScope, projectRepositoryLinkId])
  @@unique([projectId, id, projectSourceId, originScope])
  @@unique([projectId, id, projectSourceId, originScope, sourceRevisionKey, sourceContentHash, contentHash], map: "SourceChunk_exact_revision_content_key")
  @@index([projectId, projectSourceId, ordinal])
  @@index([projectId, state, createdAt])
}

model ProjectCorpusGeneration {
  id                        String                          @id @default(uuid()) @db.Uuid
  projectId                 String                          @db.Uuid
  grantId                   String                          @db.Uuid
  policyRevisionId          String                          @db.Uuid
  status                    ProjectCorpusGenerationStatus   @default(staging)
  generationKey             String                          @db.VarChar(64)
  sourceManifestFingerprint String                          @db.VarChar(64)
  chunkManifestFingerprint  String                          @db.VarChar(64)
  sourceCount               Int
  expectedChunkCount        Int
  chunkerVersion            String                          @db.VarChar(128)
  failureCode               String?                         @db.VarChar(64)
  createdAt                 DateTime                        @default(now())
  completedAt               DateTime?
  supersededAt              DateTime?
  project                   Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant                     ModelProcessingGrant            @relation(fields: [projectId, grantId, policyRevisionId], references: [projectId, id, policyRevisionId], map: "ProjectCorpusGeneration_grant_fkey", onDelete: NoAction, onUpdate: Cascade)
  entries                   ProjectCorpusGenerationEntry[]
  projectIndexes            ProjectCorpusIndexGeneration[]

  @@unique([projectId, id])
  @@unique([projectId, id, grantId])
  @@unique([projectId, id, grantId, policyRevisionId], map: "ProjectCorpusGeneration_index_grant_policy_key")
  @@unique([projectId, generationKey])
  @@index([projectId, status, createdAt])
  @@index([projectId, grantId])
}

model ProjectCorpusGenerationEntry {
  id                       String                   @id @default(uuid()) @db.Uuid
  projectId                String                   @db.Uuid
  corpusGenerationId       String                   @db.Uuid
  grantId                  String                   @db.Uuid
  grantSourceId            String                   @db.Uuid
  projectSourceId          String                   @db.Uuid
  originScope              ContentOriginScope
  sourceRevisionKey        String                   @db.Uuid
  sourceContentHash        String                   @db.VarChar(64)
  sourceChunkId            String                   @db.Uuid
  ordinal                  Int
  chunkContentHash         String                   @db.VarChar(64)
  chunkContentBytes        Int
  createdAt                DateTime                 @default(now())
  generation               ProjectCorpusGeneration @relation(fields: [projectId, corpusGenerationId, grantId], references: [projectId, id, grantId], map: "ProjectCorpusGenerationEntry_generation_fkey", onDelete: NoAction, onUpdate: Cascade)
  grantSource              ModelProcessingGrantSource @relation(fields: [projectId, grantSourceId, grantId, projectSourceId], references: [projectId, id, grantId, sourceId], map: "ProjectCorpusGenerationEntry_grant_source_fkey", onDelete: NoAction, onUpdate: Cascade)
  projectSource            ProjectSource            @relation(fields: [projectId, projectSourceId, originScope, sourceRevisionKey, sourceContentHash], references: [projectId, id, originScope, revisionKey, contentHash], map: "ProjectCorpusGenerationEntry_source_revision_fkey", onDelete: NoAction, onUpdate: Cascade)
  sourceChunk              SourceChunk              @relation(fields: [projectId, sourceChunkId, projectSourceId, originScope, sourceRevisionKey, sourceContentHash, chunkContentHash], references: [projectId, id, projectSourceId, originScope, sourceRevisionKey, sourceContentHash, contentHash], map: "ProjectCorpusGenerationEntry_source_chunk_fkey", onDelete: NoAction, onUpdate: Cascade)
  projectCorpusInputs      ProjectCorpusIndexInput[]

  @@unique([projectId, id])
  @@unique([projectId, corpusGenerationId, id], map: "CorpusEntry_generation_id_key")
  @@unique([projectId, corpusGenerationId, id, sourceChunkId], map: "CorpusEntry_generation_chunk_key")
  @@unique([projectId, corpusGenerationId, sourceChunkId], map: "ProjectCorpusGenerationEntry_generation_sourceChunk_key")
  @@unique([projectId, corpusGenerationId, ordinal], map: "ProjectCorpusGenerationEntry_generation_ordinal_key")
  @@index([projectId, projectSourceId, ordinal], map: "ProjectCorpusGenerationEntry_project_source_ordinal_idx")
}

model IndexGeneration {
  id                            String                 @id @default(uuid()) @db.Uuid
  projectId                     String                 @db.Uuid
  kind                          IndexGenerationKind
  grantId                       String                 @db.Uuid
  policyRevisionId              String                 @db.Uuid
  embeddingProfileId            String                 @db.Uuid
  status                        IndexGenerationStatus   @default(staging)
  generationKey                 String                 @db.VarChar(64)
  inputManifestFingerprint      String                 @db.VarChar(64)
  processingBoundaryFingerprint String                 @db.VarChar(64)
  expectedInputCount            Int
  indexedInputCount             Int                    @default(0)
  failureCode                   String?                @db.VarChar(64)
  createdAt                     DateTime               @default(now())
  buildStartedAt                DateTime?
  completedAt                   DateTime?
  publishedAt                   DateTime?
  supersededAt                  DateTime?
  project                       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant                         ModelProcessingGrant   @relation(fields: [projectId, grantId, policyRevisionId], references: [projectId, id, policyRevisionId], map: "IndexGeneration_grant_fkey", onDelete: NoAction, onUpdate: Cascade)
  embeddingProfile              EmbeddingProfile       @relation(fields: [embeddingProfileId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  projectCorpus                 ProjectCorpusIndexGeneration?
  inputs                        IndexGenerationInputEntry[]
  attempts                      IndexBuildAttempt[]
  workItems                     IndexWorkItem[]
  embeddings                    ChunkEmbedding[]
  publishedPointer              ProjectCorpusIndexPointer?

  @@unique([projectId, id])
  @@unique([projectId, id, embeddingProfileId])
  @@unique([projectId, id, grantId, policyRevisionId])
  @@unique([projectId, generationKey])
  @@index([projectId, status, createdAt])
  @@index([projectId, kind, createdAt])
}

model ProjectCorpusIndexGeneration {
  projectId          String                  @db.Uuid
  indexGenerationId  String                  @db.Uuid
  corpusGenerationId String                  @db.Uuid
  grantId            String                  @db.Uuid
  policyRevisionId   String                  @db.Uuid
  createdAt          DateTime                @default(now())
  indexGeneration    IndexGeneration         @relation(fields: [projectId, indexGenerationId, grantId, policyRevisionId], references: [projectId, id, grantId, policyRevisionId], map: "ProjectCorpusIndexGeneration_index_fkey", onDelete: NoAction, onUpdate: Cascade)
  corpusGeneration   ProjectCorpusGeneration @relation(fields: [projectId, corpusGenerationId, grantId, policyRevisionId], references: [projectId, id, grantId, policyRevisionId], map: "ProjectCorpusIndexGeneration_corpus_fkey", onDelete: NoAction, onUpdate: Cascade)
  inputs             ProjectCorpusIndexInput[]
  publishedPointer   ProjectCorpusIndexPointer?
  ragSnapshots       ProjectRagSnapshot[]

  @@id([projectId, indexGenerationId])
  @@unique([projectId, indexGenerationId, grantId, policyRevisionId], map: "ProjectCorpusIndexGeneration_index_grant_policy_key")
  @@unique([projectId, indexGenerationId, corpusGenerationId], map: "ProjectCorpusIndexGeneration_index_corpus_key")
  @@unique([projectId, indexGenerationId, corpusGenerationId, grantId, policyRevisionId], map: "ProjectCorpusIndexGeneration_exact_boundary_key")
  @@index([projectId, corpusGenerationId], map: "ProjectCorpusIndexGeneration_project_corpus_idx")
}

model IndexGenerationInputEntry {
  id                 String                  @id @default(uuid()) @db.Uuid
  projectId          String                  @db.Uuid
  indexGenerationId  String                  @db.Uuid
  ordinal            Int
  entryKind          IndexInputEntryKind
  sourceChunkId      String                  @db.Uuid
  contentHash        String                  @db.VarChar(64)
  contentBytes       Int
  createdAt          DateTime                @default(now())
  indexGeneration    IndexGeneration         @relation(fields: [projectId, indexGenerationId], references: [projectId, id], map: "IndexGenerationInputEntry_index_fkey", onDelete: NoAction, onUpdate: Cascade)
  sourceChunk        SourceChunk             @relation(fields: [projectId, sourceChunkId], references: [projectId, id], map: "IndexGenerationInputEntry_source_chunk_fkey", onDelete: NoAction, onUpdate: Cascade)
  projectCorpusInput ProjectCorpusIndexInput?
  workItem           IndexWorkItem?
  embedding          ChunkEmbedding?

  @@unique([projectId, indexGenerationId, id], map: "IndexGenerationInputEntry_project_index_id_key")
  @@unique([projectId, indexGenerationId, id, sourceChunkId], map: "IndexGenerationInputEntry_project_index_id_chunk_key")
  @@unique([projectId, indexGenerationId, ordinal], map: "IndexGenerationInputEntry_project_index_ordinal_key")
  @@unique([projectId, indexGenerationId, sourceChunkId], map: "IndexGenerationInputEntry_project_index_chunk_key")
  @@index([projectId, sourceChunkId], map: "IndexGenerationInputEntry_project_chunk_idx")
}

model ProjectCorpusIndexInput {
  projectId          String                       @db.Uuid
  indexGenerationId  String                       @db.Uuid
  inputEntryId       String                       @db.Uuid
  corpusGenerationId String                       @db.Uuid
  corpusEntryId      String                       @db.Uuid
  sourceChunkId      String                       @db.Uuid
  createdAt          DateTime                     @default(now())
  indexGeneration    ProjectCorpusIndexGeneration @relation(fields: [projectId, indexGenerationId, corpusGenerationId], references: [projectId, indexGenerationId, corpusGenerationId], map: "ProjectCorpusIndexInput_index_generation_fkey", onDelete: NoAction, onUpdate: Cascade)
  inputEntry         IndexGenerationInputEntry    @relation(fields: [projectId, indexGenerationId, inputEntryId, sourceChunkId], references: [projectId, indexGenerationId, id, sourceChunkId], map: "ProjectCorpusIndexInput_input_entry_fkey", onDelete: NoAction, onUpdate: Cascade)
  corpusEntry        ProjectCorpusGenerationEntry @relation(fields: [projectId, corpusGenerationId, corpusEntryId, sourceChunkId], references: [projectId, corpusGenerationId, id, sourceChunkId], map: "ProjectCorpusIndexInput_corpus_entry_fkey", onDelete: NoAction, onUpdate: Cascade)

  @@id([projectId, indexGenerationId, inputEntryId])
  @@unique([projectId, indexGenerationId, inputEntryId, sourceChunkId], map: "ProjectCorpusIndexInput_exact_input_key")
  @@unique([projectId, indexGenerationId, corpusEntryId], map: "ProjectCorpusIndexInput_corpus_entry_key")
  @@index([projectId, corpusGenerationId, corpusEntryId], map: "ProjectCorpusIndexInput_corpus_entry_idx")
}

model IndexBuildAttempt {
  id                 String                  @id @default(uuid()) @db.Uuid
  projectId          String                  @db.Uuid
  indexGenerationId  String                  @db.Uuid
  grantId            String                  @db.Uuid
  policyRevisionId   String                  @db.Uuid
  attemptNumber      Int
  operationKey       String                  @db.VarChar(64)
  status             IndexBuildAttemptStatus @default(queued)
  expectedInputCount Int
  requestCount       Int                     @default(0)
  inputTokens        Int                     @default(0)
  safeErrorCode      String?                 @db.VarChar(64)
  providerRequestId  String?                 @db.VarChar(512)
  createdAt          DateTime                @default(now())
  startedAt          DateTime?
  sentAt             DateTime?
  completedAt        DateTime?
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  indexGeneration    IndexGeneration         @relation(fields: [projectId, indexGenerationId, grantId, policyRevisionId], references: [projectId, id, grantId, policyRevisionId], map: "IndexBuildAttempt_index_fkey", onDelete: NoAction, onUpdate: Cascade)
  workItems          IndexWorkItem[]
  embeddings         ChunkEmbedding[]

  @@unique([projectId, id])
