// Append-only scalar evidence for each V2 grant version.  This model has no
// relations by design: deleting a project, connection, user, or grant must
// not erase the durable lifecycle ledger.
model ProjectMcpToolGrantLedger {
  id                              String                           @id @default(uuid()) @db.Uuid
  projectId                       String                           @db.Uuid
  grantId                         String                           @db.Uuid
  connectionId                    String                           @db.Uuid
  delegationId                    String                           @db.Uuid
  toolDefinitionId                String                           @db.Uuid
  attestationId                   String                           @db.Uuid
  connectionOwnerId               String?                          @db.Uuid
  connectionOwnerAccountAccessVersion Int?
  toolName                        String                           @db.VarChar(128)
  controlPlaneVersion             Int
  grantVersion                    Int
  event                           ProjectMcpToolGrantLedgerEvent
  statusBefore                    ProjectMcpToolGrantStatus?
  statusAfter                     ProjectMcpToolGrantStatus
  actorId                         String                           @db.Uuid
  actorProjectMembershipId        String                           @db.Uuid
  actorMembershipCreatedAt        DateTime
  delegationVersion               Int
  delegationFingerprint           String                           @db.Char(64)
  connectionConfigurationRevision Int
  grantorProjectMembershipId      String                           @db.Uuid
  grantorMembershipCreatedAt      DateTime
  revokerProjectMembershipId      String?                          @db.Uuid
  revokerMembershipCreatedAt      DateTime?
  definitionFingerprint           String                           @db.Char(64)
  networkFingerprint              String                           @db.Char(64)
  credentialFingerprint           String                           @db.Char(64)
  acknowledgedAt                  DateTime
  transactionId                   BigInt                           @db.BigInt
  transitionAt                    DateTime
  createdAt                       DateTime                         @default(now())

  @@unique([grantId, grantVersion])
  @@index([projectId, createdAt])
  @@index([grantId, createdAt])
  @@index([transactionId, createdAt])
}

// Isolated, single-use MCP action approval record.  Snapshot identifiers and
// fingerprints are deliberately scalar evidence: the action must remain
// inspectable while its source rows are later revoked or rotated, and the
// append-only ledger below must survive project deletion.
model ProjectMcpAction {
  id                              String                   @id @default(uuid()) @db.Uuid
  projectId                       String                   @db.Uuid
  clientRequestId                 String                   @db.Uuid
  grantId                         String                   @db.Uuid
  delegationId                    String                   @db.Uuid
  toolDefinitionId                String                   @db.Uuid
  attestationId                   String                   @db.Uuid
  connectionId                    String                   @db.Uuid
  toolName                        String                   @db.VarChar(128)
  inputSchema                     Json                     @db.JsonB
  canonicalArguments              Json                     @db.JsonB
  canonicalArgumentsHash          String                   @db.Char(64)
  actionFingerprint               String                   @db.Char(64)
  status                          ProjectMcpActionStatus   @default(waitingApproval)
  stateVersion                    Int                      @default(1)
  proposerProjectMembershipId     String                   @db.Uuid
  proposerMembershipCreatedAt     DateTime
  lastActorId                     String                   @db.Uuid
  lastActorProjectMembershipId    String                   @db.Uuid
  lastActorMembershipCreatedAt    DateTime
  grantVersion                    Int
  delegationVersion               Int
  attestationVersion              Int
  delegationFingerprint           String                   @db.Char(64)
  definitionFingerprint            String                   @db.Char(64)
  networkFingerprint               String                   @db.Char(64)
  credentialFingerprint            String                   @db.Char(64)
  connectionConfigurationRevision  Int
  connectionOwnerId               String                   @db.Uuid
  connectionOwnerAccountAccessVersion Int?
  connectionOwnershipState        ResourceOwnershipState
  connectionAllowPrivateNetwork   Boolean
  connectionUpdatedAt             DateTime
  credentialUpdatedAt             DateTime?
  createdAt                       DateTime                 @default(now())
  transitionAt                    DateTime                 @default(now())
  approvedAt                      DateTime?
  approvalExpiresAt               DateTime?
  rejectedAt                      DateTime?
  cancelledAt                     DateTime?
  creationTransactionId           BigInt                   @default(dbgenerated("txid_current()")) @db.BigInt
  transitionTransactionId         BigInt                   @default(dbgenerated("txid_current()")) @db.BigInt
  project                         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dispatchResult                  ProjectMcpActionDispatchResult?

  @@unique([projectId, id])
  @@unique([projectId, clientRequestId])
  @@index([projectId, status, createdAt])
  @@index([projectId, createdAt])
  @@index([grantId, status])
}

// A single reservation is the linearization point for a single-use dispatch.
// This table intentionally has no foreign keys: scalar evidence survives
// project/action deletion and never stores endpoint, arguments, credentials,
// or response payloads.
model ProjectMcpActionDispatchAttempt {
  id                    String                                  @id @default(uuid()) @db.Uuid
  projectId             String                                  @db.Uuid
  actionId              String                                  @db.Uuid
  actorKind             ProjectMcpActionRuntimeActorKind         @default(owner)
  actorId               String                                  @db.Uuid
  actorProjectMembershipId String                               @db.Uuid
  actorMembershipCreatedAt DateTime
  rpcRequestId          String                                  @db.Uuid
  reservationTokenHash  String                                  @db.Char(64)
  connectionOwnerId     String?                                 @db.Uuid
  connectionOwnerAccountAccessVersion Int?
  status                ProjectMcpActionDispatchAttemptStatus   @default(reserved)
  actionFingerprint     String                                  @db.Char(64)
  definitionFingerprint String                                  @db.Char(64)
  networkFingerprint    String                                  @db.Char(64)
  credentialFingerprint String                                  @db.Char(64)
  connectionConfigurationRevision Int
  reservationTransactionId BigInt
  reservationExpiresAt  DateTime
  reservedAt            DateTime
  boundaryReachedAt     DateTime?
  completedAt           DateTime?
  safeErrorCode         String?                                 @db.VarChar(64)
  httpStatus            Int?
  resultFingerprint     String?                                 @db.Char(64)
  resultBytes           Int?
  resultNodes           Int?
  resultDepth           Int?
  createdAt             DateTime                                @default(now())

  @@unique([actionId])
  @@unique([projectId, actionId])
  @@unique([rpcRequestId])
  @@index([status, reservationExpiresAt])
  @@index([projectId, createdAt])
}

// Runtime transition evidence is append-only and deliberately has no foreign
// keys, so project deletion retains status/fingerprints/counts/timestamps and
// safe error codes without retaining endpoint, bearer, arguments, or body.
model ProjectMcpActionRuntimeLedger {
  id                    String                              @id @default(uuid()) @db.Uuid
  projectId             String                              @db.Uuid
  actionId              String                              @db.Uuid
  attemptId             String?                             @db.Uuid
  rpcRequestId          String?                             @db.Uuid
  actorKind             ProjectMcpActionRuntimeActorKind     @default(owner)
  actorId               String                              @db.Uuid
  actorProjectMembershipId String                           @db.Uuid
  actorMembershipCreatedAt DateTime
  event                 ProjectMcpActionRuntimeLedgerEvent
  statusBefore          ProjectMcpActionStatus?
  statusAfter           ProjectMcpActionStatus
  stateVersion          Int
  actionFingerprint     String                              @db.Char(64)
  definitionFingerprint String                              @db.Char(64)
  networkFingerprint    String                              @db.Char(64)
  credentialFingerprint String                              @db.Char(64)
  connectionConfigurationRevision Int
  connectionOwnerId     String?                             @db.Uuid
  connectionOwnerAccountAccessVersion Int?
  safeErrorCode         String?                             @db.VarChar(64)
  resultFingerprint     String?                             @db.Char(64)
  resultBytes           Int?
  resultNodes           Int?
  resultDepth           Int?
  transactionId         BigInt
  transitionAt          DateTime
  createdAt             DateTime                            @default(now())

  @@unique([actionId, stateVersion])
  @@index([projectId, createdAt])
  @@index([actionId, createdAt])
  @@index([transactionId, createdAt])
}

// Sanitized, bounded result content is owned by the action and is removed by
// the existing ProjectMcpAction/Project cascade. The durable attempt/runtime
// evidence above never stores raw HTTP bodies or authorization material.
model ProjectMcpActionDispatchResult {
  id                  String          @id @default(uuid()) @db.Uuid
  projectId           String          @db.Uuid
  actionId            String          @unique @db.Uuid
  sanitizedPayload    Json            @db.JsonB
  resultFingerprint   String          @db.Char(64)
  resultBytes         Int
  resultNodes         Int
  resultDepth         Int
  omittedContentCount Int
  createdAt           DateTime        @default(now())
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  action              ProjectMcpAction @relation(fields: [projectId, actionId], references: [projectId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, actionId])
  @@index([projectId, createdAt])
}

model ProjectMcpActionDecision {
  id                          String                    @id @default(uuid()) @db.Uuid
  projectId                   String                    @db.Uuid
  actionId                   String                    @db.Uuid
  decision                    ProjectMcpActionDecisionKind
