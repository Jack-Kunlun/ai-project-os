  revocationTransactionId BigInt?             @db.BigInt
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  toolDefinition    McpToolDefinition         @relation(fields: [toolDefinitionId, connectionId, toolName], references: [id, connectionId, name], onDelete: NoAction, onUpdate: Cascade)
  delegation        ProjectMcpConnectionDelegation? @relation(fields: [delegationId, projectId, connectionId], references: [id, projectId, mcpConnectionId], onDelete: NoAction, onUpdate: NoAction)
  managedBy         AppUser                   @relation("ProjectMcpToolGrantManagedBy", fields: [managedById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  revokedBy         AppUser?                  @relation("ProjectMcpToolGrantRevokedBy", fields: [revokedById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  grantorProjectMembership ProjectMembership? @relation("ProjectMcpToolGrantGrantorMembership", fields: [grantorProjectMembershipId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  revokerProjectMembership ProjectMembership? @relation("ProjectMcpToolGrantRevokerMembership", fields: [revokerProjectMembershipId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  audits            ProjectMcpToolGrantAudit[]
  attestation       McpToolAttestation?       @relation(fields: [attestationId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  // Active-row uniqueness is enforced by a migration-managed partial index;
