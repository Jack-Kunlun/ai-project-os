  statusAfter                     ProjectMcpActionStatus
  stateVersion                    Int
  actorId                         String                    @db.Uuid
  actorProjectMembershipId        String                    @db.Uuid
  actorMembershipCreatedAt        DateTime
  grantVersion                    Int
  delegationVersion               Int
