require_root_owned_file "$COSCLI_CONFIG" 600
require_root_owned_file "$AGE_RECIPIENT_FILE" 644
[[ "$("$COSCLI" --version)" == 'coscli version v1.0.9' ]] || fail 'BACKUP_COSCLI_VERSION_INVALID' 70
mapfile -t age_recipients < "$AGE_RECIPIENT_FILE"
(( ${#age_recipients[@]} == 1 )) || fail 'BACKUP_AGE_RECIPIENT_INVALID' 71
[[ "${age_recipients[0]}" =~ ^age1[0-9a-z]{58}$ ]] || fail 'BACKUP_AGE_RECIPIENT_INVALID' 71

