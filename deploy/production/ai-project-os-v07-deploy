# Wait for the database mutation and principal reconciliation chain to finish
# before any 0.7 application writer is allowed to start.
wait_for_migration_services() {
  local attempt postgres_id principal_bootstrap_id migrate_id reconcile_id
  local postgres_state principal_bootstrap_state migrate_state reconcile_state

  for attempt in $(seq 1 60); do
    postgres_id=$(compose ps -q postgres)
    principal_bootstrap_id=$(compose ps -aq principal-bootstrap)
    migrate_id=$(compose ps -aq migrate)
    reconcile_id=$(compose ps -aq reconcile)
    if [[ -n "$postgres_id" && -n "$principal_bootstrap_id" && -n "$migrate_id" && -n "$reconcile_id" ]]; then
      postgres_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$postgres_id")
      principal_bootstrap_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$principal_bootstrap_id")
      migrate_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$migrate_id")
      reconcile_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$reconcile_id")
      if [[ "$postgres_state" == healthy && "$principal_bootstrap_state" == exited:0 \
        && "$migrate_state" == exited:0 && "$reconcile_state" == exited:0 ]]; then
        return 0
      fi
    fi
    sleep 5
  done

  printf 'DEPLOY_MIGRATION_SERVICES_TIMEOUT\n' >&2
  compose ps -a >&2
  return 1
}

wait_for_stack() {
  local attempt postgres_id principal_bootstrap_id migrate_id reconcile_id app_id worker_id git_worker_id
  local postgres_state principal_bootstrap_state migrate_state reconcile_state app_state worker_state git_worker_state health_body

  for attempt in $(seq 1 60); do
    postgres_id=$(compose ps -q postgres)
    principal_bootstrap_id=$(compose ps -aq principal-bootstrap)
    migrate_id=$(compose ps -aq migrate)
    reconcile_id=$(compose ps -aq reconcile)
    app_id=$(compose ps -q app)
    worker_id=$(compose ps -q worker)
    git_worker_id=$(compose ps -q git-worker)

    if [[ -n "$postgres_id" && -n "$principal_bootstrap_id" && -n "$migrate_id" && -n "$reconcile_id" && -n "$app_id" && -n "$worker_id" && -n "$git_worker_id" ]]; then
      postgres_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$postgres_id")
      principal_bootstrap_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$principal_bootstrap_id")
      migrate_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$migrate_id")
      reconcile_state=$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$reconcile_id")
      app_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$app_id")
      worker_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$worker_id")
      git_worker_state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$git_worker_id")

      if [[ "$postgres_state" == healthy && "$principal_bootstrap_state" == exited:0 && "$migrate_state" == exited:0 && "$reconcile_state" == exited:0 && "$app_state" == healthy && "$worker_state" == healthy && "$git_worker_state" == healthy ]]; then
        health_body=$(curl --fail --silent --show-error http://127.0.0.1:3000/api/health)
        grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$health_body"
        grep -Eq '"version"[[:space:]]*:[[:space:]]*"'"${RELEASE_TAG#v}"'"' <<<"$health_body"
        grep -Eq '"database"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body"
        grep -Eq '"worker"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body"
        grep -Eq '"consecutiveFailures"[[:space:]]*:[[:space:]]*0' <<<"$health_body"
        STACK_HEALTH=$health_body
        STACK_STATES="postgres=$postgres_state principal-bootstrap=$principal_bootstrap_state migrate=$migrate_state reconcile=$reconcile_state app=$app_state worker=$worker_state git-worker=$git_worker_state"
        return 0
      fi
    fi

    sleep 5
  done

  printf 'DEPLOY_STACK_HEALTH_TIMEOUT\n' >&2
  compose ps -a >&2
  return 1
}

perform_writer_cutover() {
  if [[ ! "$OLD_APP_ID" =~ ^[0-9a-f]{64}$ || ! "$OLD_WORKER_ID" =~ ^[0-9a-f]{64}$ ]]; then
    printf 'DEPLOY_OLD_WRITER_CONTAINER_INVALID\n' >&2
    return 69
  fi
  if (( PRE_DEPLOY_BACKUP_SOURCE_QUIESCED != 1 )); then
    printf 'DEPLOY_PRE_BACKUP_SOURCE_NOT_QUIESCED\n' >&2
    return 69
  fi

  # The verified pre-deploy backup was taken after these exact writers were
  # stopped and the database was isolated. Never restart old code after the
  # mutation boundary below.
  if [[ "$(docker inspect --format '{{.State.Running}}:{{.State.Paused}}' "$OLD_APP_ID")" != false:false \
    || "$(docker inspect --format '{{.State.Running}}:{{.State.Paused}}' "$OLD_WORKER_ID")" != false:false ]]; then
    printf 'DEPLOY_OLD_WRITER_STOP_FAILED\n' >&2
    return 69
  fi

  # From this point onward the database may have been changed. Never restart
  # an old application against a partially or fully upgraded schema.
  MUTATION_ATTEMPTED=1
  compose up -d --no-build --force-recreate principal-bootstrap migrate reconcile
  wait_for_migration_services
  assert_maintenance_isolation
  run_upgrade_preflight post-migration
  assert_maintenance_isolation
  compose up -d --no-deps --no-build --force-recreate app worker git-worker
  wait_for_stack
  NEW_WRITERS_CONFIRMED_HEALTHY=1
  WRITER_RECOVERY_REQUIRED=0
}

perform_writer_cutover

