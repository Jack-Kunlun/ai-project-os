generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectSourceKind {
  document
  screenshot
  github
  manual
}

enum ProjectItemType {
  decision
  progress
  issue
  risk
}

enum ProjectItemReviewStatus {
  candidate
  confirmed
  dismissed
  superseded
}

enum ProjectScanTrigger {
  manual
  system
}

enum ProjectScanStatus {
  running
  completed
  failed
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sources     ProjectSource[]
  items       ProjectItem[]
  scans       ProjectScan[]
  snapshots   ProjectSnapshot[]

  @@index([updatedAt])
}

model ProjectSource {
  id           String            @id @default(uuid()) @db.Uuid
  projectId    String            @db.Uuid
  kind         ProjectSourceKind
  externalRef  String?
  contentText  String            @db.Text
  contentHash  String
  storageKey   String?
  capturedAt   DateTime?
  ingestedAt   DateTime          @default(now())
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items        ProjectItem[]      @relation("SourceItems")

  @@index([projectId, capturedAt])
  @@unique([projectId, contentHash])
  @@unique([projectId, id])
}

model ProjectItem {
  id               String                   @id @default(uuid()) @db.Uuid
  projectId        String                   @db.Uuid
  type             ProjectItemType
  reviewStatus     ProjectItemReviewStatus  @default(candidate)
  sourceId         String                   @db.Uuid
  title            String
  content          String                   @db.Text
  sourceExcerpt    String?                  @db.Text
  occurredAt       DateTime?
  confirmedAt      DateTime?
  supersedesItemId String?                  @db.Uuid
  metadata         Json                     @default("{}") @db.JsonB
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source           ProjectSource            @relation("SourceItems", fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  supersedesItem   ProjectItem?             @relation("ItemSupersession", fields: [projectId, supersedesItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  supersededBy     ProjectItem[]            @relation("ItemSupersession")

  @@index([projectId, reviewStatus])
  @@index([projectId, type])
  @@index([sourceId])
  @@index([supersedesItemId])
  @@unique([projectId, id])
}

model ProjectScan {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  trigger     ProjectScanTrigger
  status      ProjectScanStatus @default(running)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  error       String?           @db.Text
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots   ProjectSnapshot[] @relation("ScanSnapshots")

  @@index([projectId, startedAt])
  @@index([projectId, status])
  @@unique([projectId, id])
}

model ProjectSnapshot {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  scanId      String?      @db.Uuid
  payload     Json         @db.JsonB
  generatedAt DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan        ProjectScan? @relation("ScanSnapshots", fields: [projectId, scanId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)

  @@index([projectId, generatedAt])
  @@index([scanId])
}
