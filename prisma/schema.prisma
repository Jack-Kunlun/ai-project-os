// Historical membership decisions are applied only from an offline,
// two-signer governance manifest.  These evidence rows intentionally do not
// relate to AppUser: signer identities are external trust anchors, not
// application accounts, and must never be inferred from an app-admin role.
model MembershipGovernanceExecution {
  id                         String                         @id @default(uuid()) @db.Uuid
  manifestFingerprint        String                         @unique @db.Char(64)
  executionNonce             String                         @unique @db.Uuid
  expectedInventoryFingerprint String                       @db.Char(64)
  trustedSignerRegistryFingerprint String                    @db.Char(64)
  version                    Int                            @default(1)
  coverage                   String                         @db.VarChar(32)
  expiresAt                  DateTime
  reason                     String                         @db.VarChar(500)
  itemCount                  Int
  canonicalManifest          String                         @db.Text
  snapshot                   Json                           @db.JsonB
  executorLabel              String                         @db.VarChar(128)
  transactionId              BigInt                         @default(dbgenerated("txid_current()")) @db.BigInt
  appliedAt                  DateTime                       @default(now())
  createdAt                  DateTime                       @default(now())
  approvals                  MembershipGovernanceApproval[]

  @@index([expiresAt])
  @@index([executionNonce])
}

model MembershipGovernanceApproval {
  id                    String                         @id @default(uuid()) @db.Uuid
  executionId           String                         @db.Uuid
