# Copy this file to .env and set the required local-only values before starting.
# Keep .env uncommitted; this example intentionally contains no usable secret.
POSTGRES_USER=ai_project_os
POSTGRES_PASSWORD=
POSTGRES_DB=ai_project_os
DATABASE_URL=
APP_PORT=3000
AI_ENABLED=false
AI_PROVIDER=openai
# Local CLI only. Keep the real value in the uncommitted .env.
OPENAI_API_KEY=
GITHUB_ENABLED=false
# Absolute path to a read-only token file outside this repository.
GITHUB_TOKEN_FILE=
