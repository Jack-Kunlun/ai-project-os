#!/usr/bin/env bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 077

readonly MODE=${1-}
readonly TARGET_TAG=${2-}
readonly COMPOSE_PROJECT=ai-project-os
readonly BACKUP_ROOT=/var/backups/ai-project-os
readonly BACKUP_STATE_ROOT=/var/lib/ai-project-os-backup
readonly STAGING_ROOT=$BACKUP_STATE_ROOT/staging
readonly RESULT_FILE=$BACKUP_STATE_ROOT/last-success
readonly PUBLIC_STATUS_ROOT=/var/lib/ai-project-os-operations/backups
readonly PUBLIC_HISTORY_ROOT=$PUBLIC_STATUS_ROOT/history
readonly PUBLIC_CURRENT_FILE=$PUBLIC_STATUS_ROOT/current.json
readonly PUBLIC_HISTORY_MAX=120
readonly LOCK_FILE=/run/lock/ai-project-os-backup.lock
readonly DEPLOY_LOCK_FILE=/run/lock/ai-project-os-deploy.lock
readonly COS_ENV_FILE=/etc/ai-project-os/cos-backup.env
readonly COSCLI_CONFIG=/etc/ai-project-os/coscli.yaml
readonly AGE_RECIPIENT_FILE=/etc/ai-project-os/production-backup-age.pub
readonly PRODUCTION_ENV_FILE=/etc/ai-project-os/production.env
readonly TLS_CERTIFICATE_FILE=/etc/nginx/ssl/ai-project-os.com/fullchain.crt
readonly TLS_PRIVATE_KEY_FILE=/etc/nginx/ssl/ai-project-os.com/privkey.key
readonly DEPLOY_AUTHORIZED_KEYS=/home/deploy/.ssh/authorized_keys
readonly ACTIONS_AUTHORIZED_KEYS=/var/lib/ai-project-os-actions/.ssh/authorized_keys
readonly COSCLI=/usr/local/bin/coscli
readonly MIN_FREE_BYTES=5368709120
readonly LOCAL_RETENTION_DAYS_DEFAULT=14
readonly LOCAL_MIN_VERIFIED_DEFAULT=3
readonly LOCK_WAIT_SECONDS=600
readonly COS_STAT_VERIFY_ATTEMPTS=8
readonly COS_STAT_VERIFY_INITIAL_DELAY_SECONDS=1
readonly COS_STAT_VERIFY_MAX_DELAY_SECONDS=8

declare -a PAUSED_WRITERS=()
INCOMPLETE_DIR=
STAGING_ARCHIVE=
STAGING_CHECKSUM=
STAGING_MANIFEST=
RETENTION_REMOVED=0
PUBLIC_STATUS_ACTIVE=0
PUBLIC_STATUS_FINALIZED=0
PUBLIC_RUN_ID=
PUBLIC_STARTED_AT=
PUBLIC_STARTED_EPOCH=0
PUBLIC_FAILURE_CODE_FILE=
PUBLIC_BACKUP_NAME=
PUBLIC_ARCHIVE_OBJECT=
PUBLIC_ARCHIVE_SHA256=
PUBLIC_ARCHIVE_BYTES=
PUBLIC_VERIFICATION_ATTEMPTS=0
KEEP_WRITERS_QUIESCED=0
CUTOVER_MODE=0

fail() {
  local marker=$1
  local exit_code=${2-1}
  local error_code=${marker%% *}

  if (( PUBLIC_STATUS_ACTIVE == 1 )) &&
    [[ "$error_code" =~ ^[A-Z][A-Z0-9_]{2,127}$ ]] &&
    [[ -n "$PUBLIC_FAILURE_CODE_FILE" ]]; then
    printf '%s\n' "$error_code" > "$PUBLIC_FAILURE_CODE_FILE" 2>/dev/null || true
  fi

  printf '%s\n' "$marker" >&2
  exit "$exit_code"
}

timer_next_at() {
  local raw_next parsed_next

  command -v systemctl >/dev/null 2>&1 || return 0
  raw_next=$(systemctl show ai-project-os-backup.timer \
    --property=NextElapseUSecRealtime \
    --value 2>/dev/null || true)
  [[ -n "$raw_next" && "$raw_next" != n/a ]] || return 0
  parsed_next=$(date -d "$raw_next" -Is 2>/dev/null || true)
  if [[ "$parsed_next" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$ ]]; then
    printf '%s' "$parsed_next"
  fi
}

json_string_or_null() {
  local value=$1

  if [[ -z "$value" ]]; then
    printf 'null'
  else
    printf '"%s"' "$value"
  fi
}

write_public_status_json() {
  local output_file=$1
  local state=$2
  local completed_at=$3
  local duration_seconds=$4
  local error_code=$5
  local next_run_at=$6

  [[ "$PUBLIC_RUN_ID" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]] || return 1
  [[ "$MODE" =~ ^(daily|manual|pre-deploy)$ ]] || return 1
  [[ "$PUBLIC_STARTED_AT" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$ ]] || return 1
  [[ "$state" =~ ^(running|succeeded|failed|skipped)$ ]] || return 1
  [[ -z "$TARGET_TAG" || "$TARGET_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ -z "$completed_at" || "$completed_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$ ]] || return 1
  [[ -z "$duration_seconds" || "$duration_seconds" =~ ^[0-9]+$ ]] || return 1
  [[ -z "$PUBLIC_BACKUP_NAME" || "$PUBLIC_BACKUP_NAME" =~ ^[0-9]{8}T[0-9]{6}Z-(daily|manual|pre-deploy-to-v[0-9]+\.[0-9]+\.[0-9]+)\.[A-Za-z0-9]{6}$ ]] || return 1
  [[ -z "$PUBLIC_ARCHIVE_OBJECT" || "$PUBLIC_ARCHIVE_OBJECT" =~ ^cos://ai-project-os-backup-[0-9]+/[A-Za-z0-9][A-Za-z0-9._/-]+$ ]] || return 1
  [[ -z "$PUBLIC_ARCHIVE_SHA256" || "$PUBLIC_ARCHIVE_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ -z "$PUBLIC_ARCHIVE_BYTES" || "$PUBLIC_ARCHIVE_BYTES" =~ ^[0-9]+$ ]] || return 1
  [[ "$RETENTION_REMOVED" =~ ^[0-9]+$ ]] || return 1
  [[ "$PUBLIC_VERIFICATION_ATTEMPTS" =~ ^[0-9]+$ ]] || return 1
  [[ -z "$error_code" || "$error_code" =~ ^[A-Z][A-Z0-9_]{2,127}$ ]] || return 1
  [[ -z "$next_run_at" || "$next_run_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$ ]] || return 1

  {
    printf '{\n'
    printf '  "formatVersion": 1,\n'
    printf '  "runId": "%s",\n' "$PUBLIC_RUN_ID"
    printf '  "state": "%s",\n' "$state"
    printf '  "trigger": "%s",\n' "$MODE"
    printf '  "targetTag": '
    json_string_or_null "$TARGET_TAG"
    printf ',\n'
    printf '  "startedAt": "%s",\n' "$PUBLIC_STARTED_AT"
    printf '  "completedAt": '
    json_string_or_null "$completed_at"
    printf ',\n'
    printf '  "durationSeconds": %s,\n' "${duration_seconds:-null}"
    printf '  "backupName": '
    json_string_or_null "$PUBLIC_BACKUP_NAME"
    printf ',\n'
    printf '  "archiveObject": '
    json_string_or_null "$PUBLIC_ARCHIVE_OBJECT"
    printf ',\n'
    printf '  "archiveSha256": '
    json_string_or_null "$PUBLIC_ARCHIVE_SHA256"
    printf ',\n'
    printf '  "archiveBytes": %s,\n' "${PUBLIC_ARCHIVE_BYTES:-null}"
    printf '  "retentionRemoved": %s,\n' "$RETENTION_REMOVED"
    printf '  "verificationAttempts": %s,\n' "$PUBLIC_VERIFICATION_ATTEMPTS"
    printf '  "errorCode": '
    json_string_or_null "$error_code"
    printf ',\n'
    printf '  "nextRunAt": '
    json_string_or_null "$next_run_at"
    printf '\n}\n'
  } > "$output_file"
}

prune_public_status_history() {
  local index history_file
  local -a history_files=()

  mapfile -t history_files < <(find -P "$PUBLIC_HISTORY_ROOT" \
    -mindepth 1 -maxdepth 1 -type f \
    -name '[0-9]*.json' -print | sort -r)
  for (( index = PUBLIC_HISTORY_MAX; index < ${#history_files[@]}; index++ )); do
    history_file=${history_files[$index]}
    [[ "$(dirname -- "$history_file")" == "$PUBLIC_HISTORY_ROOT" ]] || continue
    [[ "$(basename -- "$history_file")" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+\.json$ ]] || continue
    rm -f -- "$history_file"
  done
}

publish_public_status() {
  local state=$1
  local error_code=${2-}
  local completed_at= duration_seconds= next_run_at=
  local temporary_current temporary_history history_file

  (( PUBLIC_STATUS_ACTIVE == 1 )) || return 1
  if [[ "$state" != running ]]; then
    completed_at=$(date -Is)
    duration_seconds=$(( $(date +%s) - PUBLIC_STARTED_EPOCH ))
  fi
  next_run_at=$(timer_next_at)

  temporary_current=$(mktemp "$PUBLIC_STATUS_ROOT/.current.XXXXXX") || return 1
  if ! write_public_status_json "$temporary_current" "$state" "$completed_at" \
    "$duration_seconds" "$error_code" "$next_run_at"; then
    rm -f -- "$temporary_current"
    return 1
  fi
  chmod 644 "$temporary_current" || { rm -f -- "$temporary_current"; return 1; }

  if [[ "$state" != running ]]; then
    history_file=$PUBLIC_HISTORY_ROOT/$PUBLIC_RUN_ID.json
    temporary_history=$(mktemp "$PUBLIC_HISTORY_ROOT/.${PUBLIC_RUN_ID}.XXXXXX") || {
      rm -f -- "$temporary_current"
      return 1
    }
    if ! cp -- "$temporary_current" "$temporary_history" ||
      ! chmod 644 "$temporary_history" ||
      ! ln -- "$temporary_history" "$history_file"; then
      rm -f -- "$temporary_current" "$temporary_history"
      return 1
    fi
    rm -f -- "$temporary_history"
  fi

  mv -f -- "$temporary_current" "$PUBLIC_CURRENT_FILE" || {
    rm -f -- "$temporary_current"
    return 1
  }
  if [[ "$state" != running ]]; then
    prune_public_status_history
  fi
}

begin_public_status() {
  if [[ -L /var/lib/ai-project-os-operations || -L "$PUBLIC_STATUS_ROOT" || -L "$PUBLIC_HISTORY_ROOT" ]]; then
    printf 'BACKUP_PUBLIC_STATUS_PATH_UNSAFE\n' >&2
    return 1
  fi
  install -d -o root -g root -m 0755 \
    /var/lib/ai-project-os-operations \
    "$PUBLIC_STATUS_ROOT" \
    "$PUBLIC_HISTORY_ROOT" || return 1
  [[ "$(stat -c %U:%G "$PUBLIC_STATUS_ROOT")" == root:root ]] || return 1
  [[ "$(stat -c %a "$PUBLIC_STATUS_ROOT")" == 755 ]] || return 1
  [[ "$(stat -c %U:%G "$PUBLIC_HISTORY_ROOT")" == root:root ]] || return 1
  [[ "$(stat -c %a "$PUBLIC_HISTORY_ROOT")" == 755 ]] || return 1

  PUBLIC_RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$(date +%s%N)"
  PUBLIC_STARTED_AT=$(date -Is)
  PUBLIC_STARTED_EPOCH=$(date +%s)
  PUBLIC_FAILURE_CODE_FILE=$PUBLIC_STATUS_ROOT/.${PUBLIC_RUN_ID}.error
  printf 'BACKUP_UNEXPECTED_FAILURE\n' > "$PUBLIC_FAILURE_CODE_FILE"
  chmod 600 "$PUBLIC_FAILURE_CODE_FILE"
  PUBLIC_STATUS_ACTIVE=1
  publish_public_status running
}

finish_public_status() {
  local state=$1
  local error_code=${2-}

  (( PUBLIC_STATUS_ACTIVE == 1 )) || return 0
  if ! publish_public_status "$state" "$error_code"; then
    printf 'BACKUP_PUBLIC_STATUS_WRITE_FAILED state=%s\n' "$state" >&2
  fi
  PUBLIC_STATUS_FINALIZED=1
  rm -f -- "$PUBLIC_FAILURE_CODE_FILE" ||
    printf 'BACKUP_PUBLIC_STATUS_ERROR_MARKER_CLEANUP_FAILED\n' >&2
}

resume_writers() {
  local container_id
  local resume_failed=0
  local -a still_paused=()

  for container_id in "${PAUSED_WRITERS[@]}"; do
    if [[ "$(docker inspect --format '{{.State.Paused}}' "$container_id" 2>/dev/null || true)" == true ]]; then
      if ! docker unpause "$container_id" >/dev/null; then
        resume_failed=1
        still_paused+=("$container_id")
      fi
    fi
  done
  PAUSED_WRITERS=("${still_paused[@]}")
  return "$resume_failed"
}

cleanup_on_exit() {
  local exit_status=$?
  local error_code=BACKUP_UNEXPECTED_FAILURE

  if ! (( exit_status == 0 && KEEP_WRITERS_QUIESCED == 1 )); then
    if ! resume_writers; then
      printf 'BACKUP_WRITER_RESUME_FAILED\n' >&2
    fi
  fi

  if [[ -n "$INCOMPLETE_DIR" && -d "$INCOMPLETE_DIR" ]]; then
    rm -rf --one-file-system -- "$INCOMPLETE_DIR"
  fi
  if [[ -n "$STAGING_ARCHIVE" && -f "$STAGING_ARCHIVE" ]]; then
    rm -f -- "$STAGING_ARCHIVE"
  fi
  if [[ -n "$STAGING_CHECKSUM" && -f "$STAGING_CHECKSUM" ]]; then
    rm -f -- "$STAGING_CHECKSUM"
  fi
  if [[ -n "$STAGING_MANIFEST" && -f "$STAGING_MANIFEST" ]]; then
    rm -f -- "$STAGING_MANIFEST"
  fi

  if (( PUBLIC_STATUS_ACTIVE == 1 && PUBLIC_STATUS_FINALIZED == 0 )); then
    if [[ -f "$PUBLIC_FAILURE_CODE_FILE" ]]; then
      read -r error_code < "$PUBLIC_FAILURE_CODE_FILE" || error_code=BACKUP_UNEXPECTED_FAILURE
    fi
    if [[ ! "$error_code" =~ ^[A-Z][A-Z0-9_]{2,127}$ ]]; then
      error_code=BACKUP_UNEXPECTED_FAILURE
    fi
    finish_public_status failed "$error_code"
  fi

  return "$exit_status"
}

trap cleanup_on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

require_root_owned_file() {
  local path=$1
  local expected_mode=$2

  [[ -f "$path" && ! -L "$path" ]] || fail "BACKUP_REQUIRED_FILE_MISSING path=$path" 70
  [[ "$(stat -c %U:%G "$path")" == root:root ]] ||
    fail "BACKUP_REQUIRED_FILE_OWNER_INVALID path=$path" 70
  [[ "$(stat -c %a "$path")" == "$expected_mode" ]] ||
    fail "BACKUP_REQUIRED_FILE_MODE_INVALID path=$path" 70
}

require_owned_file() {
  local path=$1
  local expected_owner=$2
  local expected_mode=$3

  [[ -f "$path" && ! -L "$path" ]] || fail "BACKUP_REQUIRED_FILE_MISSING path=$path" 70
  [[ "$(stat -c %U:%G "$path")" == "$expected_owner" ]] ||
    fail "BACKUP_REQUIRED_FILE_OWNER_INVALID path=$path" 70
  [[ "$(stat -c %a "$path")" == "$expected_mode" ]] ||
    fail "BACKUP_REQUIRED_FILE_MODE_INVALID path=$path" 70
}

build_host_config_archive() {
  local output_file=$1
  local backup_directory=$2
  local host_config_root=$backup_directory/.host-config
  local deploy_password_hash actions_public_key
  local certificate_public_key private_public_key
  local -a action_keys=()

  [[ "$(dirname -- "$host_config_root")" == "$backup_directory" ]] ||
    fail 'BACKUP_HOST_CONFIG_PATH_INVALID' 73
  [[ ! -e "$host_config_root" ]] || fail 'BACKUP_HOST_CONFIG_PATH_EXISTS' 73

  require_root_owned_file "$PRODUCTION_ENV_FILE" 600
  require_root_owned_file "$COSCLI_CONFIG" 600
  require_root_owned_file "$COS_ENV_FILE" 600
  require_root_owned_file "$AGE_RECIPIENT_FILE" 644
  require_owned_file "$TLS_CERTIFICATE_FILE" root:root 644
  require_owned_file "$TLS_PRIVATE_KEY_FILE" root:root 600
  require_owned_file "$DEPLOY_AUTHORIZED_KEYS" deploy:deploy 600
  require_owned_file "$ACTIONS_AUTHORIZED_KEYS" ai-project-os-actions:ai-project-os-actions 600

  openssl x509 -in "$TLS_CERTIFICATE_FILE" -noout >/dev/null ||
    fail 'BACKUP_TLS_CERTIFICATE_INVALID' 71
  openssl pkey -in "$TLS_PRIVATE_KEY_FILE" -check -noout >/dev/null ||
    fail 'BACKUP_TLS_PRIVATE_KEY_INVALID' 71
  certificate_public_key=$(openssl x509 -in "$TLS_CERTIFICATE_FILE" -pubkey -noout | sha256sum | awk '{print $1}')
  private_public_key=$(openssl pkey -in "$TLS_PRIVATE_KEY_FILE" -pubout | sha256sum | awk '{print $1}')
  [[ "$certificate_public_key" == "$private_public_key" ]] || fail 'BACKUP_TLS_KEY_MISMATCH' 71

  grep -Eq '^ssh-ed25519 [A-Za-z0-9+/]+={0,2}( [^[:cntrl:]]+)?$' "$DEPLOY_AUTHORIZED_KEYS" ||
    fail 'BACKUP_DEPLOY_AUTHORIZED_KEYS_INVALID' 71
  if grep -Evq '^ssh-ed25519 [A-Za-z0-9+/]+={0,2}( [^[:cntrl:]]+)?$' "$DEPLOY_AUTHORIZED_KEYS"; then
    fail 'BACKUP_DEPLOY_AUTHORIZED_KEYS_INVALID' 71
  fi

  mapfile -t action_keys < <(grep -oE 'ssh-ed25519 [A-Za-z0-9+/]+={0,2}( [^[:cntrl:]]+)?$' "$ACTIONS_AUTHORIZED_KEYS")
  (( ${#action_keys[@]} == 1 )) || fail 'BACKUP_ACTIONS_AUTHORIZED_KEY_INVALID' 71
  actions_public_key=${action_keys[0]}

  deploy_password_hash=$(getent shadow deploy | cut -d: -f2)
  [[ "$deploy_password_hash" == '$y$'* || "$deploy_password_hash" == '$6$'* ]] ||
    fail 'BACKUP_DEPLOY_PASSWORD_HASH_INVALID' 71
  [[ "$deploy_password_hash" =~ ^[^[:space:]:]{20,255}$ ]] ||
    fail 'BACKUP_DEPLOY_PASSWORD_HASH_INVALID' 71

  install -d -o root -g root -m 0700 \
    "$host_config_root/etc/ai-project-os" \
    "$host_config_root/etc/nginx/ssl/ai-project-os.com" \
    "$host_config_root/bootstrap"
  install -o root -g root -m 0600 "$PRODUCTION_ENV_FILE" "$host_config_root/etc/ai-project-os/production.env"
  install -o root -g root -m 0600 "$COS_ENV_FILE" "$host_config_root/etc/ai-project-os/cos-backup.env"
  install -o root -g root -m 0600 "$COSCLI_CONFIG" "$host_config_root/etc/ai-project-os/coscli.yaml"
  install -o root -g root -m 0644 "$AGE_RECIPIENT_FILE" "$host_config_root/etc/ai-project-os/production-backup-age.pub"
  install -o root -g root -m 0644 "$TLS_CERTIFICATE_FILE" "$host_config_root/etc/nginx/ssl/ai-project-os.com/fullchain.crt"
  install -o root -g root -m 0600 "$TLS_PRIVATE_KEY_FILE" "$host_config_root/etc/nginx/ssl/ai-project-os.com/privkey.key"
  install -o root -g root -m 0600 "$DEPLOY_AUTHORIZED_KEYS" "$host_config_root/bootstrap/deploy-authorized_keys"
  printf '%s\n' "$deploy_password_hash" > "$host_config_root/bootstrap/deploy-password.hash"
  printf '%s\n' "$actions_public_key" > "$host_config_root/bootstrap/github-actions.pub"
  chmod 600 "$host_config_root/bootstrap/deploy-password.hash" "$host_config_root/bootstrap/github-actions.pub"

  tar -C "$host_config_root" -czf "$output_file" .
  chmod 600 "$output_file"
  rm -rf --one-file-system -- "$host_config_root"
  tar -tzf "$output_file" >/dev/null || fail 'BACKUP_HOST_CONFIG_ARCHIVE_INVALID' 73
}

read_config_value() {
  local key=$1
  local required=${2-required}
  local line value
  local -a matches=()

  mapfile -t matches < <(grep -E "^${key}=" "$COS_ENV_FILE" || true)
  if (( ${#matches[@]} == 0 )) && [[ "$required" == optional ]]; then
    return 1
  fi
  (( ${#matches[@]} == 1 )) || fail "BACKUP_CONFIG_KEY_INVALID key=$key" 71

  line=${matches[0]}
  value=${line#*=}
  if [[ "$value" == \'*\' || "$value" == \"*\" ]]; then
    [[ ${#value} -ge 2 && "${value:0:1}" == "${value: -1}" ]] ||
      fail "BACKUP_CONFIG_VALUE_INVALID key=$key" 71
    value=${value:1:${#value}-2}
  fi
  [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] ||
    fail "BACKUP_CONFIG_VALUE_INVALID key=$key" 71

  printf '%s' "$value"
}

read_optional_positive_integer() {
  local key=$1
  local default_value=$2
  local value

  if ! value=$(read_config_value "$key" optional); then
    printf '%s' "$default_value"
    return
  fi
  [[ "$value" =~ ^[0-9]+$ ]] || fail "BACKUP_CONFIG_VALUE_INVALID key=$key" 71
  (( value >= 1 && value <= 3650 )) || fail "BACKUP_CONFIG_VALUE_INVALID key=$key" 71
  printf '%s' "$value"
}

service_container_ids() {
  local service=$1

  docker ps -q \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=$service"
}

all_stack_container_ids() {
  docker ps -aq --filter "label=com.docker.compose.project=$COMPOSE_PROJECT"
}

require_single_running_container() {
  local service=$1
  local state
  local -a ids=()

  mapfile -t ids < <(service_container_ids "$service")
  (( ${#ids[@]} == 1 )) || fail "BACKUP_STACK_SERVICE_INVALID service=$service count=${#ids[@]}" 72
  state=$(docker inspect --format '{{.State.Status}}:{{.State.Paused}}:{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "${ids[0]}")
  [[ "$state" == running:false:healthy ]] ||
    fail "BACKUP_STACK_SERVICE_NOT_HEALTHY service=$service state=$state" 72

  printf '%s' "${ids[0]}"
}

wait_for_writer_health() {
  local attempt container_id state
  local all_healthy

  for (( attempt = 1; attempt <= 36; attempt++ )); do
    all_healthy=1
    for container_id in "$@"; do
      state=$(docker inspect --format '{{.State.Status}}:{{.State.Paused}}:{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "$container_id" 2>/dev/null || true)
      if [[ "$state" != running:false:healthy ]]; then
        all_healthy=0
        break
      fi
    done
    if (( all_healthy == 1 )); then
      printf 'BACKUP_WRITERS_HEALTHY wait_attempt=%s\n' "$attempt"
      return 0
    fi
    sleep 5
  done

  return 1
}

write_result() {
  local status=$1
  local result_reason=$2
  local source_path=$3
  local archive_object=$4
  local checksum_object=$5
  local archive_sha256=$6
  local manifest_object=$7
  local latest_manifest_object=$8
  local completed_at=$9
  local temporary_result

  temporary_result=$(mktemp "$BACKUP_STATE_ROOT/.last-success.XXXXXX")
  {
    printf 'status=%s\n' "$status"
    printf 'reason=%s\n' "$result_reason"
    printf 'source=%s\n' "$source_path"
    printf 'archive_object=%s\n' "$archive_object"
    printf 'checksum_object=%s\n' "$checksum_object"
    printf 'archive_sha256=%s\n' "$archive_sha256"
    printf 'manifest_object=%s\n' "$manifest_object"
    printf 'latest_manifest_object=%s\n' "$latest_manifest_object"
    printf 'completed_at=%s\n' "$completed_at"
  } > "$temporary_result"
  chmod 600 "$temporary_result"
  mv -f -- "$temporary_result" "$RESULT_FILE"
}

verify_remote_object() {
  local object_uri=$1
  local local_path=$2
  local kind=$3
  local stat_output remote_size remote_crc local_size
  local attempt stat_status verify_delay

  local_size=$(stat -c %s "$local_path")
  verify_delay=$COS_STAT_VERIFY_INITIAL_DELAY_SECONDS

  for (( attempt = 1; attempt <= COS_STAT_VERIFY_ATTEMPTS; attempt++ )); do
    PUBLIC_VERIFICATION_ATTEMPTS=$(( PUBLIC_VERIFICATION_ATTEMPTS + 1 ))
    stat_output=
    remote_size=
    remote_crc=
    stat_status=0

    if stat_output=$(timeout 30 "$COSCLI" stat "$object_uri" \
      -c "$COSCLI_CONFIG" \
      --init-skip 2>&1); then
      stat_status=0
    else
      stat_status=$?
    fi

    remote_size=$(sed -n 's/.*Content-Length:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$stat_output" | tail -n 1)
    remote_crc=$(sed -n 's/.*x-cos-hash-crc64ecma:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$stat_output" | tail -n 1)

    if (( stat_status == 0 )) &&
      [[ "$remote_size" == "$local_size" ]] &&
      [[ "$remote_crc" =~ ^[0-9]+$ ]]; then
      printf 'BACKUP_COS_OBJECT_VERIFIED type=%s bytes=%s crc64=%s object=%s attempt=%s\n' \
        "$kind" "$remote_size" "$remote_crc" "$object_uri" "$attempt"
      return 0
    fi

    if (( attempt < COS_STAT_VERIFY_ATTEMPTS )); then
      printf 'BACKUP_COS_OBJECT_VERIFY_RETRY type=%s attempt=%s status=%s local=%s remote=%s crc64=%s delay=%s\n' \
        "$kind" "$attempt" "$stat_status" "$local_size" "${remote_size:-missing}" \
        "${remote_crc:-missing}" "$verify_delay"
      sleep "$verify_delay"
      verify_delay=$(( verify_delay * 2 ))
      if (( verify_delay > COS_STAT_VERIFY_MAX_DELAY_SECONDS )); then
        verify_delay=$COS_STAT_VERIFY_MAX_DELAY_SECONDS
      fi
    fi
  done

  printf '%s\n' "$stat_output" >&2
  if (( stat_status != 0 )); then
    fail "BACKUP_COS_STAT_FAILED type=$kind status=$stat_status attempts=$COS_STAT_VERIFY_ATTEMPTS" 74
  fi

  [[ "$remote_size" == "$local_size" ]] ||
    fail "BACKUP_COS_SIZE_MISMATCH type=$kind local=$local_size remote=${remote_size:-missing} attempts=$COS_STAT_VERIFY_ATTEMPTS" 74
  fail "BACKUP_COS_CRC64_MISSING type=$kind attempts=$COS_STAT_VERIFY_ATTEMPTS" 74
}

upload_object() {
  local local_path=$1
  local object_uri=$2
  local kind=$3

  "$COSCLI" cp "$local_path" "$object_uri" \
    -c "$COSCLI_CONFIG" \
    --init-skip \
    --disable-log \
    --process-log=false \
    --fail-output=false \
    --disable-checksum=false \
    --disable-crc64=false \
    --check-point=false \
    --err-retry-num 5 \
    --err-retry-interval 3

  verify_remote_object "$object_uri" "$local_path" "$kind"
}

cleanup_verified_local_backups() {
  local current_backup=$1
  local retention_days=$2
  local minimum_verified=$3
  local now cutoff path name marker created_at
  local verified_count removable_count
  local -a verified_backups=()
  local -a expired_backups=()

  now=$(date +%s)
  cutoff=$(( now - retention_days * 86400 ))

  while IFS= read -r -d '' path; do
    [[ ! -L "$path" ]] || continue
    [[ "$(dirname -- "$path")" == "$BACKUP_ROOT" ]] || continue
    name=$(basename -- "$path")
    [[ "$name" =~ ^[0-9]{8}T[0-9]{6}Z-(daily|manual|pre-deploy-to-v[0-9]+\.[0-9]+\.[0-9]+)\.[A-Za-z0-9]{6}$ ]] || continue

    marker=$path/.cos-upload-verified
    [[ -f "$marker" && ! -L "$marker" ]] || continue
    [[ "$(stat -c %U:%G "$marker")" == root:root ]] || continue
    [[ "$(stat -c %a "$marker")" == 600 ]] || continue
    grep -qx 'status=COS_UPLOAD_VERIFIED' "$marker" || continue

    verified_backups+=("$path")
    created_at=$(stat -c %Y "$path")
    if (( created_at < cutoff )); then
      expired_backups+=("$path")
    fi
  done < <(find -P "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -print0)

  verified_count=${#verified_backups[@]}
  removable_count=$(( verified_count - minimum_verified ))
  if (( removable_count <= 0 || ${#expired_backups[@]} == 0 )); then
    return
  fi

  mapfile -t expired_backups < <(printf '%s\n' "${expired_backups[@]}" | sort)
  for path in "${expired_backups[@]}"; do
    (( removable_count > 0 )) || break
    [[ "$path" != "$current_backup" ]] || continue

    name=$(basename -- "$path")
    [[ "$(dirname -- "$path")" == "$BACKUP_ROOT" ]] || fail "BACKUP_RETENTION_PATH_INVALID" 75
    [[ "$name" =~ ^[0-9]{8}T[0-9]{6}Z-(daily|manual|pre-deploy-to-v[0-9]+\.[0-9]+\.[0-9]+)\.[A-Za-z0-9]{6}$ ]] ||
      fail "BACKUP_RETENTION_NAME_INVALID name=$name" 75
    [[ -f "$path/.cos-upload-verified" ]] || fail "BACKUP_RETENTION_MARKER_MISSING name=$name" 75
    grep -qx 'status=COS_UPLOAD_VERIFIED' "$path/.cos-upload-verified" ||
      fail "BACKUP_RETENTION_MARKER_INVALID name=$name" 75

    rm -rf --one-file-system -- "$path"
    removable_count=$(( removable_count - 1 ))
    RETENTION_REMOVED=$(( RETENTION_REMOVED + 1 ))
    printf 'BACKUP_LOCAL_VERIFIED_REMOVED name=%s\n' "$name"
  done
}

