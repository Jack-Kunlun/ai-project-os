#!/usr/bin/env bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

readonly SOURCE_TAG=${1-}
readonly RELEASE_TAG=${2-}
readonly EXPECTED_SOURCE_REVISION=${3-}
readonly EXPECTED_REVISION=${4-}
readonly CONFIRMATION=${5-}
readonly REPOSITORY_URL=https://github.com/Jack-Kunlun/ai-project-os.git
readonly REPOSITORY_DIR=/srv/ai-project-os/repository
readonly ENV_FILE=/etc/ai-project-os/production.env
readonly COMPOSE_PROJECT=ai-project-os
readonly BACKUP_SCRIPT=/usr/local/sbin/ai-project-os-backup
readonly RELEASE_TOOLING_SCRIPT=/usr/local/sbin/ai-project-os-install-release-tooling
readonly RELEASE_TOOLING_STATE=/etc/ai-project-os/release-tooling-v07-state
readonly GIT_AUTOMATION_SECRET_HELPER=/usr/local/sbin/ai-project-os-prepare-git-automation-secret
readonly PRODUCTION_COMPOSE_OVERRIDE=/etc/ai-project-os/compose.operations.yaml
readonly RESULT_FILE=/var/lib/ai-project-os/last-deployment
readonly LOCK_FILE=/run/lock/ai-project-os-deploy.lock

MUTATION_ATTEMPTED=0
WRITER_RECOVERY_REQUIRED=0
NEW_WRITERS_CONFIRMED_HEALTHY=0
OLD_APP_ID=
OLD_WORKER_ID=
PRE_DEPLOY_BACKUP_SOURCE_QUIESCED=0

if [[ $EUID -ne 0 ]]; then
  printf 'DEPLOY_ROOT_REQUIRED\n' >&2
  exit 70
fi

if [[ ! "$SOURCE_TAG" =~ ^v0\.6\.0-dev\.[1-9][0-9]+$ ]]; then
  printf 'V07_DEPLOY_SOURCE_TAG_INVALID\n' >&2
  exit 64
fi

if [[ "$RELEASE_TAG" != v0.7.0 ]]; then
  printf 'DEPLOY_TAG_INVALID\n' >&2
  exit 64
fi

if [[ ! "$EXPECTED_REVISION" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'DEPLOY_REVISION_INVALID\n' >&2
  exit 65
fi
if [[ ! "$EXPECTED_SOURCE_REVISION" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'DEPLOY_SOURCE_REVISION_INVALID\n' >&2
  exit 65
fi

if [[ "$CONFIRMATION" != CONFIRM_V07_MIGRATION_V1 ]]; then
  printf 'V07_DEPLOY_CONFIRMATION_INVALID\n' >&2
  exit 66
fi

command -v python3 >/dev/null || {
  printf 'DEPLOY_PYTHON_REQUIRED\n' >&2
  exit 69
}
# /run/lock is writable by other users on common hosts. Create or reopen
# only a root-owned regular lock file without following a planted symlink.
python3 - "$LOCK_FILE" <<'PY' || {
import os
import stat
import sys

lock_path = sys.argv[1]
directory = os.lstat(os.path.dirname(lock_path))
if not stat.S_ISDIR(directory.st_mode) or (directory.st_uid, directory.st_gid) != (0, 0):
    raise SystemExit(1)
if stat.S_IMODE(directory.st_mode) != 0o1777:
    raise SystemExit(1)
flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(lock_path, flags | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    descriptor = os.open(lock_path, flags)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or (metadata.st_uid, metadata.st_gid) != (0, 0):
        raise SystemExit(1)
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise SystemExit(1)
finally:
    os.close(descriptor)
PY
  printf 'DEPLOY_LOCK_FILE_INVALID\n' >&2
  exit 70
}
exec 9>>"$LOCK_FILE"
if ! flock -n 9; then
  printf 'DEPLOY_ALREADY_RUNNING\n' >&2
  exit 75
fi

for required_command in chmod chown curl date dirname docker flock git grep head install mktemp mv python3 rm sed seq sha256sum sleep sort stat tail tar; do
  command -v "$required_command" >/dev/null
done

# These host files are interpreted or executed as root during the cutover.
# Reject permission drift in the files and every directory on their paths.
python3 - "$GIT_AUTOMATION_SECRET_HELPER" "$BACKUP_SCRIPT" "$PRODUCTION_COMPOSE_OVERRIDE" "$RELEASE_TOOLING_SCRIPT" <<'PY' || {
import os
import stat
import sys

for path in sys.argv[1:]:
    current = "/"
    components = [part for part in path.split("/") if part]
    for index, part in enumerate(components):
        current = os.path.join(current, part)
        metadata = os.lstat(current)
        mode = metadata.st_mode
        if (metadata.st_uid, metadata.st_gid) != (0, 0) or mode & 0o022:
            raise SystemExit(1)
        if index < len(components) - 1:
            if not stat.S_ISDIR(mode):
                raise SystemExit(1)
        elif not stat.S_ISREG(mode):
            raise SystemExit(1)
        elif path != sys.argv[3] and not mode & 0o111:
            raise SystemExit(1)
PY
  printf 'V07_HOST_CONTROL_FILE_UNTRUSTED\n' >&2
  exit 70
}

"$RELEASE_TOOLING_SCRIPT" --status >/dev/null || {
  printf 'V07_TOOLING_STATUS_INVALID\n' >&2
  exit 70
}
grep -Fqx "tag=$RELEASE_TAG revision=$EXPECTED_REVISION" "$RELEASE_TOOLING_STATE" || {
  printf 'V07_TOOLING_RELEASE_MISMATCH\n' >&2
  exit 70
}

test -r "$ENV_FILE"
test "$(stat -c %U:%G "$ENV_FILE")" = root:root
test "$(stat -c %a "$ENV_FILE")" = 600
grep -qx 'POSTGRES_USER=ai_project_os_cluster_admin' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_USER_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_CLUSTER_ADMIN_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_CLUSTER_ADMIN_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_MIGRATOR_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_MIGRATOR_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -qx 'POSTGRES_RUNTIME_USER=ai_project_os_runtime' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_RUNTIME_USER_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_RUNTIME_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_RUNTIME_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -qx 'POSTGRES_ENTITLEMENT_WRITER_USER=ai_project_os_entitlement_writer' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_ENTITLEMENT_WRITER_USER_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_ENTITLEMENT_WRITER_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_ENTITLEMENT_WRITER_PASSWORD_INVALID\n' >&2
  exit 70
}
grep -Eq '^POSTGRES_ENTITLEMENT_INVENTORY_READER_PASSWORD=[0-9a-f]{64}$' "$ENV_FILE" || {
  printf 'DEPLOY_POSTGRES_ENTITLEMENT_INVENTORY_READER_PASSWORD_INVALID\n' >&2
  exit 70
}
validate_optional_bootstrap_url() {
  local value
  local -a matches=()
  mapfile -t matches < <(grep -E '^DATABASE_PRINCIPAL_LEGACY_BOOTSTRAP_URL=' "$ENV_FILE" || true)
  (( ${#matches[@]} <= 1 )) || return 1
  if (( ${#matches[@]} == 0 )); then return 0; fi
  value=${matches[0]#*=}
  [[ -z "$value" || "$value" =~ ^postgres(ql)?://[^[:space:]?\#]+$ ]]
}
validate_optional_bootstrap_url || {
  printf 'DEPLOY_DATABASE_PRINCIPAL_LEGACY_BOOTSTRAP_URL_INVALID\n' >&2
  exit 70
}
validate_exact_env_value() {
  local key=$1
  local expected=$2
  local line
  local -a matches=()
  while IFS= read -r line; do
    matches+=("$line")
  done < <(grep -E "^${key}=" "$ENV_FILE" || true)
  (( ${#matches[@]} == 1 )) && [[ "${matches[0]}" == "$key=$expected" ]]
}

validate_exact_env_value AI_PROJECT_OS_SECURE_COOKIES true || {
  printf 'DEPLOY_SECURE_COOKIES_INVALID\n' >&2
  exit 70
}
validate_exact_env_value AI_PROJECT_OS_PUBLIC_ORIGIN https://ai-project-os.com || {
  printf 'DEPLOY_PUBLIC_ORIGIN_INVALID\n' >&2
  exit 70
}

validate_github_oauth_env_value() {
  local key=$1
  local value
  local -a matches=()

  mapfile -t matches < <(grep -E "^${key}=" "$ENV_FILE" || true)
  (( ${#matches[@]} == 1 )) || return 1
  value=${matches[0]#*=}
  (( ${#value} >= 8 && ${#value} <= 512 )) || return 1
  [[ "$value" =~ ^[A-Za-z0-9._-]+$ ]]
}

validate_github_oauth_env_value AI_PROJECT_OS_GITHUB_OAUTH_CLIENT_ID || {
  printf 'DEPLOY_GITHUB_OAUTH_CLIENT_ID_INVALID\n' >&2
  exit 70
}
validate_github_oauth_env_value AI_PROJECT_OS_GITHUB_OAUTH_CLIENT_SECRET || {
  printf 'DEPLOY_GITHUB_OAUTH_CLIENT_SECRET_INVALID\n' >&2
  exit 70
}

validate_optional_boolean_env_value() {
  local key=$1
  local value
  local -a matches=()
  mapfile -t matches < <(grep -E "^${key}=" "$ENV_FILE" || true)
  (( ${#matches[@]} <= 1 )) || return 1
  (( ${#matches[@]} == 0 )) && return 0
  value=${matches[0]#*=}
  [[ "$value" == true || "$value" == false ]]
}

for feature_flag in LOCAL_REGISTRATION_ENABLED AI_PROJECT_OS_MCP_ACTIONS_ENABLED AI_PROJECT_OS_MCP_EXPORT_ENABLED AI_PROJECT_OS_MCP_EXPORT_OAUTH_ENABLED; do
  validate_optional_boolean_env_value "$feature_flag" || {
    printf 'DEPLOY_FEATURE_FLAG_INVALID key=%s\n' "$feature_flag" >&2
    exit 70
  }
done

if grep -qx 'AI_PROJECT_OS_MCP_EXPORT_OAUTH_ENABLED=true' "$ENV_FILE"; then
  grep -qx 'AI_PROJECT_OS_MCP_EXPORT_ENABLED=true' "$ENV_FILE" || {
    printf 'DEPLOY_MCP_EXPORT_OAUTH_REQUIRES_EXPORT\n' >&2
    exit 70
  }
  validate_exact_env_value AI_PROJECT_OS_MCP_EXPORT_PUBLIC_ORIGIN https://ai-project-os.com || {
    printf 'DEPLOY_MCP_EXPORT_PUBLIC_ORIGIN_INVALID\n' >&2
    exit 70
  }
fi

install -d -o root -g root -m 0755 /srv/ai-project-os
install -d -o root -g root -m 0700 "$(dirname "$RESULT_FILE")"

if [[ ! -d "$REPOSITORY_DIR/.git" ]]; then
  temporary_repository="${REPOSITORY_DIR}.init.$$"
  trap 'rm -rf -- "${temporary_repository-}"' EXIT
  git clone --filter=blob:none --no-checkout "$REPOSITORY_URL" "$temporary_repository"
  chown -R root:root "$temporary_repository"
  mv -- "$temporary_repository" "$REPOSITORY_DIR"
  trap - EXIT
fi

test "$(stat -c %U:%G "$REPOSITORY_DIR")" = root:root
test "$(git -C "$REPOSITORY_DIR" remote get-url origin)" = "$REPOSITORY_URL"

git -C "$REPOSITORY_DIR" fetch --force --no-tags origin \
  "refs/tags/$SOURCE_TAG:refs/tags/$SOURCE_TAG" \
  "refs/tags/$RELEASE_TAG:refs/tags/$RELEASE_TAG"

if [[ "$(git -C "$REPOSITORY_DIR" cat-file -t "refs/tags/$SOURCE_TAG")" != tag \
  || "$(git -C "$REPOSITORY_DIR" cat-file -t "refs/tags/$RELEASE_TAG")" != tag ]]; then
  printf 'DEPLOY_TAG_NOT_ANNOTATED\n' >&2
  exit 66
fi

resolved_source_revision=$(git -C "$REPOSITORY_DIR" rev-parse "refs/tags/$SOURCE_TAG^{}")
resolved_revision=$(git -C "$REPOSITORY_DIR" rev-parse "refs/tags/$RELEASE_TAG^{}")
if [[ "$resolved_source_revision" != "$EXPECTED_SOURCE_REVISION" ]]; then
  printf 'DEPLOY_SOURCE_TAG_REVISION_MISMATCH\n' >&2
  exit 67
fi
if [[ "$resolved_revision" != "$EXPECTED_REVISION" ]]; then
  printf 'DEPLOY_TAG_REVISION_MISMATCH\n' >&2
  exit 67
fi
if [[ "$resolved_source_revision" == "$resolved_revision" ]] \
  || ! git -C "$REPOSITORY_DIR" merge-base --is-ancestor "$resolved_source_revision" "$resolved_revision" \
  || [[ -n "$(git -C "$REPOSITORY_DIR" rev-list --merges "$resolved_source_revision..$resolved_revision")" ]]; then
  printf 'DEPLOY_SOURCE_TARGET_NOT_LINEAR\n' >&2
  exit 67
fi

require_release_ci_evidence() {
  local revision=$1 tag=$2 tag_runs_url tag_runs_json main_runs_url main_runs_json main_run_id jobs_url jobs_json
  tag_runs_url="https://api.github.com/repos/Jack-Kunlun/ai-project-os/actions/workflows/ci.yml/runs?event=push&status=success&head_sha=$revision&per_page=100"
  tag_runs_json=$(curl --fail --silent --show-error \
    --header 'Accept: application/vnd.github+json' \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    "$tag_runs_url") || return 1
  python3 -c '
import json
import sys

payload = json.load(sys.stdin)
revision, tag = sys.argv[1:3]
accepted = any(
    run.get("head_sha") == revision
    and run.get("head_branch") == tag
    and run.get("event") == "push"
    and run.get("status") == "completed"
    and run.get("conclusion") == "success"
    for run in payload.get("workflow_runs", [])
)
raise SystemExit(0 if accepted else 1)
' "$revision" "$tag" <<<"$tag_runs_json" || return 2

  main_runs_url="https://api.github.com/repos/Jack-Kunlun/ai-project-os/actions/workflows/ci.yml/runs?event=push&status=success&head_sha=$revision&per_page=100"
  main_runs_json=$(curl --fail --silent --show-error \
    --header 'Accept: application/vnd.github+json' \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    "$main_runs_url") || return 3
  main_run_id=$(python3 -c '
import json
import sys
payload = json.load(sys.stdin)
revision = sys.argv[1]
for run in payload.get("workflow_runs", []):
    if (run.get("head_sha") == revision and run.get("head_branch") == "main"
            and run.get("event") == "push" and run.get("status") == "completed"
            and run.get("conclusion") == "success"):
        print(run.get("id", ""))
        break
' "$revision" <<<"$main_runs_json") || return 4
  [[ "$main_run_id" =~ ^[1-9][0-9]*$ ]] || return 5
  jobs_url="https://api.github.com/repos/Jack-Kunlun/ai-project-os/actions/runs/$main_run_id/jobs?per_page=100"
  jobs_json=$(curl --fail --silent --show-error \
    --header 'Accept: application/vnd.github+json' \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    "$jobs_url") || return 6
  python3 -c '
import json
import sys
payload = json.load(sys.stdin)
accepted = any(job.get("name") == "Verify database and release candidate" and job.get("conclusion") == "success" for job in payload.get("jobs", []))
raise SystemExit(0 if accepted else 1)
' <<<"$jobs_json" || return 7
}

require_release_ci_evidence "$resolved_source_revision" "$SOURCE_TAG" || {
  printf 'DEPLOY_SOURCE_MAIN_AND_TAG_FULL_CI_REQUIRED\n' >&2
  exit 72
}
require_release_ci_evidence "$EXPECTED_REVISION" "$RELEASE_TAG" || {
  printf 'DEPLOY_TARGET_MAIN_AND_TAG_FULL_CI_REQUIRED\n' >&2
  exit 72
}

git -C "$REPOSITORY_DIR" checkout --detach --force "$EXPECTED_REVISION"
test -z "$(git -C "$REPOSITORY_DIR" status --porcelain)"

package_version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$REPOSITORY_DIR/package.json" | head -n 1)
if [[ "v$package_version" != "$RELEASE_TAG" ]]; then
  printf 'DEPLOY_PACKAGE_VERSION_MISMATCH\n' >&2
  exit 68
fi

# The target Compose requires a dedicated Git Worker password. Prepare it
# under the deployment lock before parsing Compose or taking the cutover
# backup, so the encrypted host-config archive contains the same secret.
(
  # The helper's standalone main takes the same lock, so call its validated
  # preparation function inside this already-locked deployment process.
  source "$GIT_AUTOMATION_SECRET_HELPER"
  trap cleanup_temporary_env EXIT
  prepare_worker_password "$ENV_FILE" 0 0
) || {
  printf 'V07_GIT_AUTOMATION_SECRET_PREPARATION_FAILED\n' >&2
  exit 70
}

compose() {
  test -f "$PRODUCTION_COMPOSE_OVERRIDE"
  docker compose \
    --project-name "$COMPOSE_PROJECT" \
    --env-file "$ENV_FILE" \
    --project-directory "$REPOSITORY_DIR" \
    --file "$REPOSITORY_DIR/compose.yaml" \
    --file "$PRODUCTION_COMPOSE_OVERRIDE" \
    "$@"
}

compose config --quiet

run_upgrade_preflight() {
  local phase=$1
  local preflight_output
  local expected_count=117
  [[ "$phase" != post-migration ]] || expected_count=135

  preflight_output=$(compose run --rm --no-deps production-upgrade-preflight \
    node node_modules/tsx/dist/cli.mjs scripts/production-v07-upgrade-preflight.ts "$phase" "$RELEASE_TAG")
  python3 -c '
import json, sys
try:
    report = json.load(sys.stdin)
except (ValueError, UnicodeError):
    raise SystemExit(1)
phase, target, expected_count = sys.argv[1:]
accepted = (
    isinstance(report, dict)
    and report.get("ok") is True
    and report.get("phase") == phase
    and report.get("targetTag") == target
    and report.get("migrationCount") == int(expected_count)
    and report.get("writerSessions") == ("stopped" if phase == "post-stop" else "not-checked")
)
raise SystemExit(0 if accepted else 1)
' "$phase" "$RELEASE_TAG" "$expected_count" <<<"$preflight_output" || {
    printf 'DEPLOY_PRODUCTION_UPGRADE_PREFLIGHT_RESULT_INVALID\n' >&2
    return 1
  }
  printf '%s\n' "$preflight_output"
}

assert_maintenance_isolation() {
  local -a running_services=()
  local postgres_id published_ports
  mapfile -t running_services < <(compose ps --services --status running)
  if (( ${#running_services[@]} != 1 )) || [[ "${running_services[0]}" != postgres ]]; then
    printf 'DEPLOY_MAINTENANCE_SERVICES_NOT_ISOLATED\n' >&2
    return 1
  fi
  postgres_id=$(compose ps -q postgres)
  [[ "$postgres_id" =~ ^[0-9a-f]{64}$ ]] || {
    printf 'DEPLOY_MAINTENANCE_POSTGRES_CONTAINER_INVALID\n' >&2
    return 1
  }
  published_ports=$(docker inspect --format '{{json (index .NetworkSettings.Ports "5432/tcp")}}' "$postgres_id")
  python3 -c '
import json
import sys
try:
    bindings = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    raise SystemExit(1)
accepted = (
    isinstance(bindings, list)
    and len(bindings) == 1
    and isinstance(bindings[0], dict)
    and bindings[0].get("HostIp") == "127.0.0.1"
    and isinstance(bindings[0].get("HostPort"), str)
    and bindings[0]["HostPort"].isdigit()
)
raise SystemExit(0 if accepted else 1)
' <<<"$published_ports" || {
    printf 'DEPLOY_MAINTENANCE_POSTGRES_PORT_NOT_ISOLATED\n' >&2
    return 1
  }
}

container_health() {
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$1"
}

wait_for_old_writers() {
  local attempt app_state worker_state health_body
  for attempt in $(seq 1 60); do
    app_state=$(container_health "$OLD_APP_ID" 2>/dev/null || true)
    worker_state=$(container_health "$OLD_WORKER_ID" 2>/dev/null || true)
    if [[ "$app_state" == healthy && "$worker_state" == healthy ]]; then
      health_body=$(curl --fail --silent --show-error http://127.0.0.1:3000/api/health || true)
      if grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$health_body" \
        && grep -Eq '"database"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body" \
        && grep -Eq '"worker"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"up"' <<<"$health_body"; then
        return 0
      fi
    fi
    sleep 5
  done
  printf 'DEPLOY_OLD_WRITER_RECOVERY_TIMEOUT\n' >&2
  return 1
}

# Stop every running writer container in the Compose project and prove the
# database is the only remaining service before claiming post-mutation safety.
quiesce_current_writers_after_failure() {
  local writer_ids remaining_app_ids remaining_worker_ids remaining_git_worker_ids writer_id
  writer_ids=$(
    {
      docker ps --no-trunc -q --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
        --filter "label=com.docker.compose.service=app"
      docker ps --no-trunc -q --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
        --filter "label=com.docker.compose.service=worker"
      docker ps --no-trunc -q --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
        --filter "label=com.docker.compose.service=git-worker"
    } | sort -u
  ) || return 1

  while IFS= read -r writer_id; do
    [[ -z "$writer_id" ]] && continue
    [[ "$writer_id" =~ ^[0-9a-f]{64}$ ]] || return 1
    docker stop "$writer_id" >/dev/null || return 1
  done <<<"$writer_ids"

  remaining_app_ids=$(docker ps --no-trunc -q \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=app") || return 1
  remaining_worker_ids=$(docker ps --no-trunc -q \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=worker") || return 1
  remaining_git_worker_ids=$(docker ps --no-trunc -q \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=git-worker") || return 1
  [[ -z "$remaining_app_ids" && -z "$remaining_worker_ids" && -z "$remaining_git_worker_ids" ]] || return 1
  assert_maintenance_isolation
}

recover_old_writers_on_failure() {
  local exit_code=$?
  local app_paused worker_paused app_running worker_running
  trap - EXIT
  set +e
  if (( exit_code != 0 && WRITER_RECOVERY_REQUIRED == 1 && MUTATION_ATTEMPTED == 0 )); then
    app_paused=$(docker inspect --format '{{.State.Paused}}' "$OLD_APP_ID" 2>/dev/null || true)
    worker_paused=$(docker inspect --format '{{.State.Paused}}' "$OLD_WORKER_ID" 2>/dev/null || true)
    app_running=$(docker inspect --format '{{.State.Running}}' "$OLD_APP_ID" 2>/dev/null || true)
    worker_running=$(docker inspect --format '{{.State.Running}}' "$OLD_WORKER_ID" 2>/dev/null || true)
    [[ "$app_paused" != true ]] || docker unpause "$OLD_APP_ID" >/dev/null || true
    [[ "$worker_paused" != true ]] || docker unpause "$OLD_WORKER_ID" >/dev/null || true
    if [[ "$app_running" == false && "$worker_running" == false ]]; then
      docker start "$OLD_APP_ID" "$OLD_WORKER_ID" >/dev/null || true
    else
      [[ "$app_running" != false ]] || docker start "$OLD_APP_ID" >/dev/null || true
      [[ "$worker_running" != false ]] || docker start "$OLD_WORKER_ID" >/dev/null || true
    fi
    wait_for_old_writers || true
  elif (( exit_code != 0 && MUTATION_ATTEMPTED == 1 && NEW_WRITERS_CONFIRMED_HEALTHY == 0 )); then
    # The schema may already be at 0.7. Keep every application writer stopped
    # and expose the verified stopped-writer backup needed by the runbook.
    if quiesce_current_writers_after_failure; then
      printf 'V07_DEPLOY_RECOVERY_REQUIRED source=%s target=%s backup=%s backup_object=%s backup_manifest=%s writers_stopped=true\n' \
        "$SOURCE_TAG" "$RELEASE_TAG" "${backup_path-unavailable}" "${backup_object-unavailable}" "${backup_manifest-unavailable}" >&2
    else
      printf 'V07_DEPLOY_EMERGENCY source=%s target=%s backup=%s backup_object=%s backup_manifest=%s writers_may_be_running=true action=manual_intervention_required\n' \
        "$SOURCE_TAG" "$RELEASE_TAG" "${backup_path-unavailable}" "${backup_object-unavailable}" "${backup_manifest-unavailable}" >&2
    fi
  elif (( exit_code != 0 && NEW_WRITERS_CONFIRMED_HEALTHY == 1 )); then
    # A public probe or final result write can fail after all three writers'
    # health is proven. Keep the new, schema-compatible writers serving.
    printf 'V07_DEPLOY_POST_CUTOVER_INCOMPLETE source=%s target=%s local_writers_healthy=true external_verification_required=true\n' \
      "$SOURCE_TAG" "$RELEASE_TAG" >&2
  fi
  set -e
  return "$exit_code"
}

trap recover_old_writers_on_failure EXIT

