  batchId                   String                    @db.Uuid
  aiRunId                   String                    @db.Uuid
  sourceId                  String                    @db.Uuid
  itemType                  ProjectItemType
  statement                 String                    @db.Text
  statementFingerprint      String                    @db.VarChar(64)
  sourceExcerpt             String                    @db.Text
  sourceExcerptFingerprint  String                    @db.VarChar(64)
  sourceStart               Int
  sourceEnd                 Int
  reviewStatus              AiCandidateReviewStatus   @default(candidate)
  reviewedAt                DateTime?
  reviewedBy                String?                   @db.VarChar(128)
  projectItemId             String                    @db.Uuid
  createdAt                 DateTime                  @default(now())
  project                   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch                     AiCandidateBatch          @relation(fields: [projectId, batchId, aiRunId], references: [projectId, id, aiRunId], onDelete: NoAction, onUpdate: Cascade)
  runInput                   AiRunInputSource          @relation(fields: [projectId, aiRunId, sourceId], references: [projectId, aiRunId, sourceId], onDelete: NoAction, onUpdate: Cascade)
  source                     ProjectSource             @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  projectItem                ProjectItem               @relation("AiCandidateItem", fields: [projectId, projectItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, batchId, sourceId, statementFingerprint, sourceExcerptFingerprint], map: "AiCandidateClaim_batch_source_statement_excerpt_key")
  @@unique([projectId, projectItemId])
  @@index([projectId, reviewStatus, createdAt])
  @@index([projectId, sourceId])
}
