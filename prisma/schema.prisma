  @@unique([projectId, sourceId, candidateFingerprint])
  @@unique([projectId, projectItemId])
  @@index([projectId, reviewStatus, createdAt])
}

model ProviderCallAudit {
  id                   String               @id @default(uuid()) @db.Uuid
  jobId                String               @db.Uuid
  providerConnectionId String               @db.Uuid
  operation            AiOperation
  modelId              String               @db.VarChar(128)
  status               String               @db.VarChar(32)
  safeErrorCode        String?              @db.VarChar(64)
  providerRequestId    String?              @db.VarChar(256)
  inputTokens          Int                  @default(0)
  outputTokens         Int                  @default(0)
  createdAt            DateTime             @default(now())
  completedAt          DateTime?
  job                  BackgroundJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerConnection   AiProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@index([jobId, createdAt])
  @@index([providerConnectionId, createdAt])
}
