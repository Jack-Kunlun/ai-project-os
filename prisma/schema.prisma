  id                       String                       @id @default(uuid()) @db.Uuid
  workspaceId              String                       @db.Uuid
  actorId                  String                       @db.Uuid
  subjectId                String                       @db.Uuid
  previewId                String                       @db.Uuid
  event                    WorkspaceRoleMutationAuditEvent @default(roleChanged)
  oldMembershipId          String                       @db.Uuid
  newMembershipId          String                       @db.Uuid
  oldRole                  WorkspaceMembershipRole
  newRole                  WorkspaceMembershipRole
  actorAccountAccessVersion Int
  subjectAccountAccessVersionBefore Int
  subjectAccountAccessVersionAfter  Int
  ownerCountBefore         Int
  ownerCountAfter          Int
  projectGrantCount        Int
  projectGrantFingerprint  String                       @db.Char(64)
  reason                   String                       @db.VarChar(500)
  requestKey               String                       @db.VarChar(180)
  requestFingerprint       String                       @db.Char(64)
  impactFingerprint        String                       @db.Char(64)
  transactionId            BigInt                       @default(dbgenerated("txid_current()")) @db.BigInt
  transitionAt             DateTime                     @default(now())
  contractVersion          Int                          @default(1)
  createdAt                DateTime                     @default(now())
  workspace                Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  actor                    AppUser                      @relation("WorkspaceRoleMutationAuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  subject                  AppUser                      @relation("WorkspaceRoleMutationAuditSubject", fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  preview                  WorkspaceRoleMutationPreview @relation(fields: [previewId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([previewId])
  @@unique([actorId, requestKey])
  @@index([workspaceId, createdAt])
  @@index([subjectId, createdAt])
  @@index([oldMembershipId, createdAt])
  @@index([newMembershipId, createdAt])
}

