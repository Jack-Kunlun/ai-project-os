generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectSourceKind {
  document
  screenshot
  github
  manual
}

enum ProjectItemType {
  decision
  progress
  issue
  risk
}

enum ProjectItemReviewStatus {
  candidate
  confirmed
  dismissed
  superseded
}

enum ContentOriginScope {
  project
  repository_link
}

enum ProjectItemEvidenceRole {
  primary
  supporting
}

enum ProjectItemEvidenceState {
  active
  purged
}

enum ProjectEvidenceRangeUnit {
  utf8_byte
  line
}

enum ProjectItemRevisionAction {
  legacyImport   @map("legacy_import")
  manualCreated  @map("manual_created")
  aiCreated      @map("ai_created")
  edited
  confirmed
  dismissed
  reopened
  rebindSource   @map("rebind_source")
  repairEvidence @map("repair_evidence")
}

enum ProjectItemRevisionIntegrityState {
  active
  purged_redacted
}

enum EmbeddingProvider {
  openai
}

enum EmbeddingNormalization {
  unit_length
}

enum SourceChunkState {
  active
  purged
}

enum ProjectScanTrigger {
  manual
  system
}

enum ProjectScanStatus {
  running
  completed
  failed
}

enum ModelProcessingGrantSourceKind {
  manual_text
}

enum ModelProcessingGrantStatus {
  draft
  issued
  revoked
}

enum ModelProcessingGrantRevocationReasonCode {
  userRequested
  policyChanged
  expired
  scannerFinding
  budgetExceeded
  securityReview
}

enum AiOperation {
  embedding
  autoExtract
  sourceSummary
  projectAnalysis
  generateWithContext
}

enum AiRunStatus {
  queued
  running
  succeeded
  failed
  unknown
  cancelled
}

enum AiRunAttemptStatus {
  sent
  succeeded
  failed
  unknown
  cancelled
}

enum AiBudgetProfile {
  standard
}

enum AiBudgetStatus {
  pending
  allowed
  exhausted
  exceeded
  rejected
}

enum AiSafeScanResult {
  passed
  blocked
  unavailable
}

enum AiAuditEventType {
  policyCreated
  policyAdvanced
  grantIssued
  grantRevoked
  preflightRejected
  scannerRejected
  budgetRejected
  runCreated
  runClaimed
  dispatchSent
  runSucceeded
  runFailed
  runUnknown
  runCancelled
  attemptSucceeded
  attemptFailed
  attemptUnknown
  attemptCancelled
}

enum AiSafeErrorCode {
  aiDisabled               @map("AI_DISABLED")
  aiProviderDisabled       @map("AI_PROVIDER_DISABLED")
  aiInvalidOperationKeyInput @map("AI_INVALID_OPERATION_KEY_INPUT")
  aiInvalidStateTransition @map("AI_INVALID_STATE_TRANSITION")
  aiRedispatchForbidden    @map("AI_REDISPATCH_FORBIDDEN")
  aiProviderIncomplete     @map("AI_PROVIDER_INCOMPLETE")
  aiProviderUnknown        @map("AI_PROVIDER_UNKNOWN")
  aiProviderFailed         @map("AI_PROVIDER_FAILED")
  aiProviderCancelled      @map("AI_PROVIDER_CANCELLED")
  aiDispatchNotSent        @map("AI_DISPATCH_NOT_SENT")
  aiPolicyDenied           @map("AI_POLICY_DENIED")
  aiGrantDenied            @map("AI_GRANT_DENIED")
  aiScannerDenied          @map("AI_SCANNER_DENIED")
  aiBudgetDenied           @map("AI_BUDGET_DENIED")
  aiInvalidProviderResponse @map("AI_INVALID_PROVIDER_RESPONSE")
  sourceInUse              @map("SOURCE_IN_USE")
}

enum AiCandidateReviewStatus {
  candidate
  accepted
  dismissed
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sources     ProjectSource[]
  items       ProjectItem[]
  scans       ProjectScan[]
  snapshots   ProjectSnapshot[]
  aiPolicy    ProjectAiPolicy?
  aiPolicyRevisions ProjectAiPolicyRevision[]
  aiGrants    ModelProcessingGrant[]
  aiGrantSources ModelProcessingGrantSource[]
  aiGrantOperations ModelProcessingGrantOperation[]
  aiRuns      AiRun[]
  aiAttempts  AiRunAttempt[]
  aiInputSources AiRunInputSource[]
  aiAuditEvents AiAuditEvent[]
  aiCandidateBatches AiCandidateBatch[]
  aiCandidateClaims AiCandidateClaim[]
  itemEvidences ProjectItemEvidence[]
  itemRevisions ProjectItemRevision[]
  itemRevisionEvidences ProjectItemRevisionEvidence[]
  sourceChunks SourceChunk[]

  @@index([updatedAt])
}

model ProjectSource {
  id                      String             @id @default(uuid()) @db.Uuid
  projectId               String             @db.Uuid
  kind                    ProjectSourceKind
  originScope             ContentOriginScope @default(project)
  projectRepositoryLinkId String?            @db.Uuid
  sourceIdentity          String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionKey             String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalRef             String?
  contentText             String             @db.Text
  contentHash             String
  manualContentDedupeKey  String?            @db.VarChar(64)
  storageKey              String?
  capturedAt              DateTime?
  ingestedAt              DateTime           @default(now())
  project                 Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items                   ProjectItem[]       @relation("SourceItems")
  itemEvidences           ProjectItemEvidence[] @relation("EvidenceProjectSource")
  grantSources            ModelProcessingGrantSource[]
  aiRunInputs             AiRunInputSource[]
  aiCandidateClaims       AiCandidateClaim[]
  sourceChunks            SourceChunk[]       @relation("ChunkProjectSource")

  @@index([projectId, capturedAt])
  @@unique([projectId, id])
  @@unique([projectId, id, originScope])
  @@unique([projectId, id, originScope, projectRepositoryLinkId])
  @@unique([projectId, sourceIdentity, revisionKey])
  @@unique([projectId, id, originScope, revisionKey, contentHash])
}

model ProjectItem {
  id               String                   @id @default(uuid()) @db.Uuid
  projectId        String                   @db.Uuid
  type             ProjectItemType
  reviewStatus     ProjectItemReviewStatus  @default(candidate)
  sourceId         String                   @db.Uuid
  title            String
  content          String                   @db.Text
  sourceExcerpt    String?                  @db.Text
  occurredAt       DateTime?
  confirmedAt      DateTime?
  supersedesItemId String?                  @db.Uuid
  metadata         Json                     @default("{}") @db.JsonB
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source           ProjectSource            @relation("SourceItems", fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  supersedesItem   ProjectItem?             @relation("ItemSupersession", fields: [projectId, supersedesItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  supersededBy     ProjectItem[]            @relation("ItemSupersession")
  aiCandidateClaim AiCandidateClaim?        @relation("AcceptedCandidateItem")
  evidences        ProjectItemEvidence[]
  revisions        ProjectItemRevision[]

  @@index([projectId, reviewStatus])
  @@index([projectId, type])
  @@index([sourceId])
  @@index([supersedesItemId])
  @@unique([projectId, id])
}

model ProjectItemEvidence {
  id                       String                   @id @default(uuid()) @db.Uuid
  projectId                String                   @db.Uuid
  projectItemId            String                   @db.Uuid
  role                     ProjectItemEvidenceRole
  evidenceState            ProjectItemEvidenceState @default(active)
  originScope              ContentOriginScope       @default(project)
  projectRepositoryLinkId  String?                  @db.Uuid
  projectSourceId          String?                  @db.Uuid
  sourceExcerpt            String?                  @db.Text
  sourceExcerptFingerprint String?                  @db.VarChar(64)
  rangeUnit                ProjectEvidenceRangeUnit?
  rangeStart               Int?
  rangeEnd                 Int?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  supersededAt             DateTime?
  purgedAt                 DateTime?
  deletionReceipt          String?                  @db.Uuid
  project                  Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item                     ProjectItem              @relation(fields: [projectId, projectItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  projectSource            ProjectSource?           @relation("EvidenceProjectSource", fields: [projectId, projectSourceId, originScope], references: [projectId, id, originScope], onDelete: NoAction, onUpdate: Cascade)
  revisionLinks            ProjectItemRevisionEvidence[]

  @@unique([projectId, id])
  @@unique([projectId, projectItemId, id])
  @@index([projectId, projectItemId, isActive])
  @@index([projectId, projectSourceId])
}

model ProjectItemRevision {
  id                          String                            @id @default(uuid()) @db.Uuid
  projectId                   String                            @db.Uuid
  projectItemId               String                            @db.Uuid
  revisionNumber              Int
  action                      ProjectItemRevisionAction
  actorId                     String                            @db.VarChar(128)
  reason                      String?                           @db.Text
  itemType                    ProjectItemType
  reviewStatus                ProjectItemReviewStatus
  title                       String
  content                     String                            @db.Text
  sourceId                    String?                           @db.Uuid
  sourceExcerpt               String?                           @db.Text
  occurredAt                  DateTime?
  confirmedAt                 DateTime?
  supersedesItemId            String?                           @db.Uuid
  metadata                    Json                              @db.JsonB
  evidenceManifestFingerprint String?                           @db.VarChar(64)
  integrityState              ProjectItemRevisionIntegrityState @default(active)
  deletionReceipt             String?                           @db.Uuid
  createdAt                   DateTime                          @default(now())
  project                     Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item                        ProjectItem                       @relation(fields: [projectId, projectItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  evidenceLinks               ProjectItemRevisionEvidence[]

  @@unique([projectId, id])
  @@unique([projectId, projectItemId, id])
  @@unique([projectId, projectItemId, revisionNumber])
  @@index([projectId, projectItemId, createdAt])
}

model ProjectItemRevisionEvidence {
  id            String                  @id @default(uuid()) @db.Uuid
  projectId     String                  @db.Uuid
  projectItemId String                  @db.Uuid
  revisionId    String                  @db.Uuid
  evidenceId    String                  @db.Uuid
  role          ProjectItemEvidenceRole
  createdAt     DateTime                @default(now())
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision      ProjectItemRevision     @relation(fields: [projectId, projectItemId, revisionId], references: [projectId, projectItemId, id], onDelete: NoAction, onUpdate: Cascade)
  evidence      ProjectItemEvidence     @relation(fields: [projectId, projectItemId, evidenceId], references: [projectId, projectItemId, id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, revisionId, evidenceId])
  @@index([projectId, projectItemId, revisionId])
  @@index([projectId, projectItemId, evidenceId])
}

model EmbeddingProfile {
  id                 String                 @id @default(uuid()) @db.Uuid
  provider           EmbeddingProvider
  modelId            String                 @db.VarChar(128)
  dimensions         Int
  normalization      EmbeddingNormalization
  profileVersion     String                 @db.VarChar(128)
  profileFingerprint String                 @unique @db.VarChar(64)
  createdAt          DateTime               @default(now())

  @@unique([provider, modelId, dimensions, normalization, profileVersion])
}

model SourceChunk {
  id                       String             @id @default(uuid()) @db.Uuid
  projectId                String             @db.Uuid
  originScope              ContentOriginScope @default(project)
  projectRepositoryLinkId  String?            @db.Uuid
  projectSourceId          String?            @db.Uuid
  sourceRevisionKey        String?            @db.Uuid
  sourceContentHash        String?            @db.VarChar(64)
  ordinal                  Int
  rangeUnit                ProjectEvidenceRangeUnit
  rangeStart               Int
  rangeEnd                 Int
  chunkerVersion           String             @db.VarChar(128)
  contentText              String?            @db.Text
  contentHash              String?            @db.VarChar(64)
  contentBytes             Int?
  state                    SourceChunkState   @default(active)
  createdAt                DateTime           @default(now())
  purgedAt                 DateTime?
  deletionReceipt          String?            @db.Uuid
  project                  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSource            ProjectSource?     @relation("ChunkProjectSource", fields: [projectId, projectSourceId, originScope, sourceRevisionKey, sourceContentHash], references: [projectId, id, originScope, revisionKey, contentHash], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, id, originScope])
  @@unique([projectId, id, originScope, projectRepositoryLinkId])
  @@unique([projectId, id, projectSourceId, originScope])
  @@index([projectId, projectSourceId, ordinal])
  @@index([projectId, state, createdAt])
}

model ProjectScan {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  trigger     ProjectScanTrigger
  status      ProjectScanStatus @default(running)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  error       String?           @db.Text
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots   ProjectSnapshot[] @relation("ScanSnapshots")

  @@index([projectId, startedAt])
  @@index([projectId, status])
  @@unique([projectId, id])
}

model ProjectSnapshot {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  scanId      String?      @db.Uuid
  payload     Json         @db.JsonB
  generatedAt DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan        ProjectScan? @relation("ScanSnapshots", fields: [projectId, scanId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)

  @@index([projectId, generatedAt])
  @@index([scanId])
}

model ProjectAiPolicyRevision {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  revision             Int
  policyFingerprint    String   @db.VarChar(64)
  outboundEnabled      Boolean  @default(false)
  embeddingEnabled     Boolean  @default(false)
  autoExtractEnabled   Boolean  @default(false)
  sourceSummaryEnabled Boolean  @default(false)
  projectAnalysisEnabled Boolean @default(false)
  generateWithContextEnabled Boolean @default(false)
  profileFingerprint   String   @db.VarChar(64)
  processorFingerprint String   @db.VarChar(64)
  regionFingerprint    String   @db.VarChar(64)
  retentionFingerprint String   @db.VarChar(64)
  endpointFingerprint  String   @db.VarChar(64)
  budgetFingerprint    String   @db.VarChar(64)
  scannerFingerprint   String   @db.VarChar(64)
  createdAt            DateTime @default(now())
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentPolicy        ProjectAiPolicy?
  grants               ModelProcessingGrant[]
  runs                 AiRun[]
  auditEvents          AiAuditEvent[]

  @@unique([projectId, id])
  @@unique([projectId, revision])
  @@index([projectId, revision])
}

model ProjectAiPolicy {
  projectId        String                     @id @db.Uuid
  currentRevisionId String                    @db.Uuid
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  project          Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentRevision  ProjectAiPolicyRevision    @relation(fields: [projectId, currentRevisionId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, currentRevisionId])
}

model ModelProcessingGrant {
  id                         String                         @id @default(uuid()) @db.Uuid
  projectId                  String                         @db.Uuid
  sourceKind                 ModelProcessingGrantSourceKind @default(manual_text)
  status                     ModelProcessingGrantStatus     @default(draft)
  policyRevisionId           String                         @db.Uuid
  profileFingerprint         String                         @db.VarChar(64)
  providerFingerprint        String                         @db.VarChar(64)
  modelFingerprint           String                         @db.VarChar(64)
  modelId                    String                         @db.VarChar(128)
  processorFingerprint       String                         @db.VarChar(64)
  regionFingerprint          String                         @db.VarChar(64)
  retentionFingerprint       String                         @db.VarChar(64)
  endpointFingerprint        String                         @db.VarChar(64)
  grantFingerprint           String                         @db.VarChar(64)
  effectivePolicyVersion     Int
  budgetFingerprint           String                         @db.VarChar(64)
  scannerFingerprint         String                         @db.VarChar(64)
  scannerVersion             String                         @db.VarChar(64)
  budgetProfile              AiBudgetProfile
  issuedBy                   String                         @db.VarChar(128)
  purposeCode                String                         @db.VarChar(64)
  issuedAt                   DateTime?
  expiresAt                  DateTime?
  revokedAt                  DateTime?
  revocationReasonCode       ModelProcessingGrantRevocationReasonCode?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  project                    Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policyRevision             ProjectAiPolicyRevision        @relation(fields: [projectId, policyRevisionId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  sources                    ModelProcessingGrantSource[]
  operations                 ModelProcessingGrantOperation[]
  runs                       AiRun[]
  auditEvents                AiAuditEvent[]

  @@unique([projectId, id])
  @@unique([projectId, id, policyRevisionId])
  @@index([projectId, expiresAt])
  @@index([projectId, revokedAt])
  @@index([projectId, status])
}

model ModelProcessingGrantSource {
  id                String                @id @default(uuid()) @db.Uuid
  projectId         String                @db.Uuid
  grantId           String                @db.Uuid
  sourceId          String                @db.Uuid
  contentFingerprint String                @db.VarChar(64)
  contentBytes      Int
  createdAt         DateTime              @default(now())
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant             ModelProcessingGrant  @relation(fields: [projectId, grantId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  inputSources      AiRunInputSource[]
  source            ProjectSource         @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, grantId, sourceId])
  @@index([projectId, sourceId])
}

model ModelProcessingGrantOperation {
  id         String                 @id @default(uuid()) @db.Uuid
  projectId  String                 @db.Uuid
  grantId    String                 @db.Uuid
  operation  AiOperation
  createdAt  DateTime               @default(now())
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant      ModelProcessingGrant  @relation(fields: [projectId, grantId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  runs       AiRun[]

  @@unique([projectId, id])
  @@unique([projectId, grantId, operation])
  @@index([projectId, operation])
}

model AiRun {
  id                            String                       @id @default(uuid()) @db.Uuid
  projectId                     String                       @db.Uuid
  grantId                       String                       @db.Uuid
  policyRevisionId              String                       @db.Uuid
  operation                     AiOperation
  operationKey                  String                       @db.VarChar(64)
  operationKeySchemaVersion     String                       @db.VarChar(32)
  inputManifestFingerprint     String                       @db.VarChar(64)
  promptFingerprint             String                       @db.VarChar(64)
  promptVersion                String                       @db.VarChar(128)
  providerFingerprint          String                       @db.VarChar(64)
  modelId                      String                       @db.VarChar(128)
  modelFingerprint              String                       @db.VarChar(64)
  profileFingerprint            String                       @db.VarChar(64)
  grantFingerprint              String                       @db.VarChar(64)
  effectivePolicyVersion        Int
  processorFingerprint          String                       @db.VarChar(64)
  processorEndpointFingerprint String                       @db.VarChar(64)
  processorRegionFingerprint    String                       @db.VarChar(64)
  processorRetentionFingerprint String                       @db.VarChar(64)
  noRagSnapshotMarker           String                       @db.VarChar(32)
  status                        AiRunStatus                  @default(queued)
  inputBytes                    Int                          @default(0)
  outputBytes                   Int                          @default(0)
  maxInputTokens                Int                          @default(0)
  maxOutputTokens               Int                          @default(0)
  maxRequests                   Int                          @default(1)
  maxBudgetMicros               Int                          @default(0)
  inputTokens                   Int                          @default(0)
  outputTokens                  Int                          @default(0)
  requestCount                  Int                          @default(0)
  budgetUsedMicros              Int                          @default(0)
  pricingSnapshotId             String?                      @db.VarChar(128)
  budgetStatus                  AiBudgetStatus
  safeErrorCode                 AiSafeErrorCode?
  httpStatus                    Int?
  providerRequestId             String?                      @db.VarChar(512)
  providerResponseId            String?                      @db.VarChar(512)
  createdAt                     DateTime                     @default(now())
  claimedAt                    DateTime?
  sentAt                       DateTime?
  completedAt                  DateTime?
  project                       Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant                         ModelProcessingGrant         @relation(fields: [projectId, grantId, policyRevisionId], references: [projectId, id, policyRevisionId], onDelete: NoAction, onUpdate: Cascade)
  policyRevision                ProjectAiPolicyRevision       @relation(fields: [projectId, policyRevisionId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  operationGrant                ModelProcessingGrantOperation @relation(fields: [projectId, grantId, operation], references: [projectId, grantId, operation], onDelete: NoAction, onUpdate: Cascade)
  attempts                      AiRunAttempt[]
  inputSources                  AiRunInputSource[]
  auditEvents                   AiAuditEvent[]
  candidateBatch                AiCandidateBatch?

  @@unique([projectId, id])
  @@unique([projectId, id, grantId])
  @@unique([projectId, id, grantId, policyRevisionId])
  @@unique([projectId, operationKey])
  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model AiRunAttempt {
  id                  String             @id @default(uuid()) @db.Uuid
  projectId           String             @db.Uuid
  aiRunId             String             @db.Uuid
  attemptNumber       Int
  dispatchToken       String             @unique @db.VarChar(128)
  status              AiRunAttemptStatus @default(sent)
  providerRequestId   String?            @db.VarChar(512)
  providerResponseId  String?            @db.VarChar(512)
  httpStatus          Int?
  inputTokens         Int                @default(0)
  outputTokens        Int                @default(0)
  requestCount        Int                @default(1)
  safeErrorCode       AiSafeErrorCode?
  createdAt           DateTime           @default(now())
  sentAt              DateTime           @default(now())
  completedAt         DateTime?
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiRun               AiRun              @relation(fields: [projectId, aiRunId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  auditEvents         AiAuditEvent[]

  @@unique([projectId, id])
  @@unique([projectId, id, aiRunId])
  @@unique([projectId, aiRunId, attemptNumber])
  @@index([projectId, aiRunId, status])
}

model AiRunInputSource {
  id                          String                       @id @default(uuid()) @db.Uuid
  projectId                   String                       @db.Uuid
  aiRunId                     String                       @db.Uuid
  grantId                     String                       @db.Uuid
  sourceId                    String                       @db.Uuid
  contentFingerprint          String                       @db.VarChar(64)
  contentBytes                Int
  scannerVersion              String                       @db.VarChar(64)
  safeScanResult              AiSafeScanResult
  evidenceManifestFingerprint String                       @db.VarChar(64)
  createdAt                   DateTime                     @default(now())
  project                     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiRun                       AiRun                        @relation(fields: [projectId, aiRunId, grantId], references: [projectId, id, grantId], onDelete: NoAction, onUpdate: Cascade)
  grantSource                 ModelProcessingGrantSource   @relation(fields: [projectId, grantId, sourceId], references: [projectId, grantId, sourceId], onDelete: NoAction, onUpdate: Cascade)
  source                      ProjectSource                @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  candidateClaims             AiCandidateClaim[]

  @@unique([projectId, id])
  @@unique([projectId, aiRunId, sourceId])
  @@index([projectId, sourceId])
}

model AiAuditEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  projectId           String             @db.Uuid
  policyRevisionId    String             @db.Uuid
  eventType           AiAuditEventType
  safeCode            AiSafeErrorCode?
  eventFingerprint    String?            @db.VarChar(64)
  fingerprintCount    Int?
  byteCount           Int?
  tokenCount          Int?
  requestCount        Int?
  httpStatus          Int?
  grantId             String?            @db.Uuid
  aiRunId             String?            @db.Uuid
  attemptId           String?            @db.Uuid
  createdAt           DateTime           @default(now())
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant               ModelProcessingGrant? @relation(fields: [projectId, grantId, policyRevisionId], references: [projectId, id, policyRevisionId], onDelete: NoAction, onUpdate: Cascade)
  policyRevision      ProjectAiPolicyRevision @relation(fields: [projectId, policyRevisionId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  aiRun               AiRun?             @relation(fields: [projectId, aiRunId, grantId, policyRevisionId], references: [projectId, id, grantId, policyRevisionId], onDelete: NoAction, onUpdate: Cascade)
  attempt             AiRunAttempt?      @relation(fields: [projectId, attemptId, aiRunId], references: [projectId, id, aiRunId], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@index([projectId, policyRevisionId])
  @@index([projectId, eventType, createdAt])
  @@index([projectId, grantId])
  @@index([projectId, aiRunId])
  @@index([projectId, attemptId])
}

model AiCandidateBatch {
  id                       String             @id @default(uuid()) @db.Uuid
  projectId                String             @db.Uuid
  aiRunId                  String             @db.Uuid
  candidateSetFingerprint  String             @db.VarChar(64)
  candidateCount           Int
  createdAt                DateTime           @default(now())
  project                  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiRun                    AiRun              @relation(fields: [projectId, aiRunId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  claims                   AiCandidateClaim[]

  @@unique([projectId, id])
  @@unique([projectId, id, aiRunId])
  @@unique([projectId, aiRunId])
  @@index([projectId, createdAt])
}

model AiCandidateClaim {
  id                        String                    @id @default(uuid()) @db.Uuid
  projectId                 String                    @db.Uuid
  batchId                   String                    @db.Uuid
  aiRunId                   String                    @db.Uuid
  sourceId                  String                    @db.Uuid
  statement                 String                    @db.Text
  statementFingerprint      String                    @db.VarChar(64)
  sourceExcerpt             String                    @db.Text
  sourceExcerptFingerprint  String                    @db.VarChar(64)
  sourceStart               Int
  sourceEnd                 Int
  reviewStatus              AiCandidateReviewStatus   @default(candidate)
  reviewedAt                DateTime?
  reviewedBy                String?                   @db.VarChar(128)
  acceptedItemId            String?                   @db.Uuid
  createdAt                 DateTime                  @default(now())
  project                   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch                     AiCandidateBatch          @relation(fields: [projectId, batchId, aiRunId], references: [projectId, id, aiRunId], onDelete: NoAction, onUpdate: Cascade)
  runInput                   AiRunInputSource          @relation(fields: [projectId, aiRunId, sourceId], references: [projectId, aiRunId, sourceId], onDelete: NoAction, onUpdate: Cascade)
  source                     ProjectSource             @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  acceptedItem               ProjectItem?              @relation("AcceptedCandidateItem", fields: [projectId, acceptedItemId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, batchId, sourceId, statementFingerprint, sourceExcerptFingerprint])
  @@unique([projectId, acceptedItemId])
  @@index([projectId, reviewStatus, createdAt])
  @@index([projectId, sourceId])
}
