model Project {
  id                                   String                                @id @default(uuid()) @db.Uuid
  workspaceId                          String                                @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  name                                 String
  slug                                 String                                @unique
  description                          String?                               @db.Text
  archivedAt                           DateTime?
  createdAt                            DateTime                              @default(now())
  updatedAt                            DateTime                              @updatedAt
  sources                              ProjectSource[]
  assets                               ProjectAsset[]
  assetVersions                        ProjectAssetVersion[]
  assetSegments                        ProjectAssetSegment[]
  assetExtractionRuns                  ProjectAssetExtractionRun[]
  items                                ProjectItem[]
  scans                                ProjectScan[]
  snapshots                            ProjectSnapshot[]
  aiPolicy                             ProjectAiPolicy?
  aiPolicyRevisions                    ProjectAiPolicyRevision[]
  aiPolicyOperationProfiles            ProjectAiPolicyOperationProfile[]
  aiGrants                             ModelProcessingGrant[]
  aiGrantSources                       ModelProcessingGrantSource[]
  aiGrantOperations                    ModelProcessingGrantOperation[]
  aiRuns                               AiRun[]
  aiAttempts                           AiRunAttempt[]
  aiInputSources                       AiRunInputSource[]
  aiAuditEvents                        AiAuditEvent[]
  aiCandidateBatches                   AiCandidateBatch[]
  aiCandidateClaims                    AiCandidateClaim[]
  itemEvidences                        ProjectItemEvidence[]
  itemRevisions                        ProjectItemRevision[]
  itemRevisionEvidences                ProjectItemRevisionEvidence[]
  sourceChunks                         SourceChunk[]
  corpusGenerations                    ProjectCorpusGeneration[]
  indexGenerations                     IndexGeneration[]
  indexBuildAttempts                   IndexBuildAttempt[]
  indexWorkItems                       IndexWorkItem[]
  chunkEmbeddings                      ChunkEmbedding[]
  corpusIndexPointer                   ProjectCorpusIndexPointer?
  ragSnapshots                         ProjectRagSnapshot[]
  ragSnapshotPointer                   ProjectRagSnapshotPointer?
  aiDerivedArtifacts                   AiDerivedArtifact[]
  artifactDependencies                 ArtifactDependency[]
  githubConnections                    GitHubConnection[]
  gitRepositoryLinks                   ProjectGitRepositoryLink[]
  gitRepositorySnapshots               GitRepositorySnapshot[]
  gitRepositorySnapshotEntries         GitRepositorySnapshotEntry[]
  gitRepositorySnapshotPointers        GitRepositorySnapshotPointer[]
  repositoryLinks                      ProjectRepositoryLink[]
  githubSyncRuns                       ProjectGitHubSyncRun[]
  githubSyncEntries                    ProjectGitHubSyncEntry[]
  githubSyncChanges                    ProjectGitHubSyncChange[]
  githubSyncReconciliations            ProjectGitHubSyncReconciliation[]
  backgroundJobReconciliations         BackgroundJobReconciliation[]
  repositoryLinkConfigVersions         ProjectRepositoryLinkConfigVersion[]
  repositoryLinkConfigPointers         ProjectRepositoryLinkConfigPointer[]
  scanBatches                          ProjectScanBatch[]
  scanBatchEntries                     ProjectScanBatchEntry[]
  repoCodeScanRuns                     RepoCodeScanRun[]
  repositoryFiles                      RepositoryFile[]
  repositoryFileRevisions              RepositoryFileRevision[]
  repositoryCodeGenerations            RepositoryCodeGeneration[]
  repositoryCodeGenerationEntries      RepositoryCodeGenerationEntry[]
  repositoryCodeGenerationPointers     RepositoryCodeGenerationPointer[]
  repositoryCodeIndexGenerations       RepositoryCodeIndexGeneration[]
  repositoryCodeIndexInputs            RepositoryCodeIndexInput[]
  repositoryCodeIndexPointers          RepositoryCodeIndexPointer[]
  githubMaterialSyncRuns               GitHubMaterialSyncRun[]
  githubSourceVersions                 GitHubSourceVersion[]
  repositoryMaterialGenerations        RepositoryMaterialGeneration[]
  repositoryMaterialGenerationEntries  RepositoryMaterialGenerationEntry[]
  repositoryMaterialGenerationPointers RepositoryMaterialGenerationPointer[]
  repositoryMaterialModelGrants        RepositoryMaterialModelGrant[]
  repositoryMaterialGrantSources       RepositoryMaterialModelGrantSource[]
  repositoryMaterialChunks             RepositoryMaterialChunk[]
  repositoryMaterialIndexes            RepositoryMaterialIndexGeneration[]
  repositoryMaterialIndexInputs        RepositoryMaterialIndexInput[]
  repositoryMaterialIndexAttempts      RepositoryMaterialIndexAttempt[]
  repositoryMaterialEmbeddings         RepositoryMaterialEmbedding[]
  repositoryMaterialIndexPointers      RepositoryMaterialIndexPointer[]
  githubMaterialQuarantines            GitHubMaterialQuarantine[]
  repositoryRagSnapshots               RepositoryRagSnapshot[]
  repositoryRagSnapshotPointers        RepositoryRagSnapshotPointer[]
  projectRepositoryRagSnapshots        ProjectRepositoryRagSnapshot[]
  projectRepositoryRagSnapshotPointer  ProjectRepositoryRagSnapshotPointer?
  projectRepositoryRagEntries          ProjectRepositoryRagSnapshotEntry[]
  codeSnapshots                        ProjectCodeSnapshot[]
  codeSnapshotEntries                  ProjectCodeSnapshotEntry[]
  codeSnapshotPointer                  ProjectCodeSnapshotPointer?
  webAiRoutes                          ProjectAiRoute[]
  aiRouteRevisions                     ProjectAiRouteRevision[]
  webAiGrants                          WebAiGrant[]
  backgroundJobs                       BackgroundJob[]
  automationRules                      AutomationRule[]
  automationRuns                       AutomationRun[]
  notifications                        Notification[]
  actionPolicies                       ProjectActionPolicy[]
  actionPolicyRevisions                ProjectActionPolicyRevision[]
  actions                              ProjectAction[]
  mcpToolGrants                        ProjectMcpToolGrant[]
  memoryIndexGenerations               MemoryIndexGeneration[]
  memoryIndexPointer                   MemoryIndexPointer?
  memoryRecords                        MemoryRecord[]
  memoryIndexReconciliations           MemoryIndexReconciliation[]
  ragAnswers                           RagAnswer[]
  webAiCandidates                      WebAiCandidate[]
  intelligenceReports                  ProjectIntelligenceReport[]
  projectAgentRuns                     ProjectAgentRun[]
  lifecycleRevisions                   ProjectLifecycleRevision[]
  dataExportAudits                     ProjectDataExportAudit[]
  memoryQualityIssues                  MemoryQualityIssue[]
  webSources                           WebSource[]
  webSourceRevisions                   WebSourceRevision[]
  webSourcePointers                    WebSourcePointer[]
  workspace                            Workspace                             @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  memberships                          ProjectMembership[]
  invitations                          WorkspaceInvitation[]

  @@index([archivedAt, updatedAt])
  @@index([workspaceId, archivedAt, updatedAt])
  @@index([updatedAt])
}

model ProjectLifecycleRevision {
  id                 String                 @id @default(uuid()) @db.Uuid
  projectId          String                 @db.Uuid
  action             ProjectLifecycleAction
  actorId            String                 @db.Uuid
  previousArchivedAt DateTime?
  currentArchivedAt  DateTime?
  projectUpdatedAt   DateTime
  createdAt          DateTime               @default(now())
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor              AppUser                @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model ProjectDataExportAudit {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  requestedById String   @db.Uuid
  schemaVersion String   @db.VarChar(32)
  contentHash   String   @db.Char(64)
  byteCount     Int
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requestedBy   AppUser  @relation(fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@index([projectId, createdAt])
  @@index([requestedById, createdAt])
}

model GitHubConnection {
  id                    String                   @id @default(uuid()) @db.Uuid
  projectId             String                   @db.Uuid
  authRef               String                   @db.VarChar(128)
  status                GitHubConnectionStatus   @default(configured)
  connectionFingerprint String                   @db.VarChar(64)
  verifiedAt            DateTime?
  disabledAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  credentialId          String?                  @db.Uuid
  project               Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credential            ExternalCredential?      @relation(fields: [credentialId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  repositoryLinks       ProjectRepositoryLink[]
  githubSyncEntries     ProjectGitHubSyncEntry[]

  @@unique([projectId, id])
  @@unique([projectId, connectionFingerprint])
  @@index([projectId, status])
}

model GitHubRepository {
  id                 String                  @id @default(uuid()) @db.Uuid
  githubRepositoryId BigInt                  @unique
  nodeId             String                  @db.VarChar(512)
  currentOwner       String                  @db.VarChar(256)
  currentName        String                  @db.VarChar(256)
  currentFullName    String                  @db.VarChar(512)
  isPrivate          Boolean
  isArchived         Boolean                 @default(false)
  isDisabled         Boolean                 @default(false)
  defaultBranch      String                  @db.VarChar(1024)
  lastVerifiedAt     DateTime
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  repositoryLinks    ProjectRepositoryLink[]

  @@unique([id, githubRepositoryId])
  @@index([currentFullName])
}

model GitConnection {
  id                         String              @id @default(uuid()) @db.Uuid
  name                       String              @unique @db.VarChar(80)
  providerKind               GitProviderKind
  transport                  GitTransport
  baseUrl                    String              @db.VarChar(1024)
  authKind                   GitAuthKind
  username                   String?             @db.VarChar(128)
  credentialId               String?             @db.Uuid
  allowPrivateNetwork        Boolean             @default(false)
  tlsCaCertificate           String?             @db.Text
  sshKnownHost               String?             @db.Text
  resolvedAddressFingerprint String?             @db.Char(64)
  status                     GitConnectionStatus @default(configured)
  lastTestedAt               DateTime?
  lastErrorCode              String?             @db.VarChar(64)
  disabledAt                 DateTime?
  createdById                String              @db.Uuid
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  credential                 ExternalCredential? @relation(fields: [credentialId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  createdBy                  AppUser             @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  repositories               GitRepository[]

  @@index([providerKind, status])
  @@index([createdById, createdAt])
}

model GitRepository {
  id               String                     @id @default(uuid()) @db.Uuid
  gitConnectionId  String                     @db.Uuid
  repositoryPath   String                     @db.VarChar(768)
  displayName      String                     @db.VarChar(256)
  webUrl           String?                    @db.VarChar(1024)
  defaultBranch    String                     @db.VarChar(255)
  remoteIdentifier String?                    @db.VarChar(512)
  isPrivate        Boolean                    @default(true)
  lastVerifiedAt   DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  connection       GitConnection              @relation(fields: [gitConnectionId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  projectLinks     ProjectGitRepositoryLink[]

  @@unique([gitConnectionId, repositoryPath])
  @@index([gitConnectionId, updatedAt])
}

model ProjectGitRepositoryLink {
  id                         String                        @id @default(uuid()) @db.Uuid
  projectId                  String                        @db.Uuid
  gitRepositoryId            String                        @db.Uuid
  role                       ProjectRepositoryRole
  trackedRef                 String                        @db.VarChar(255)
  requiredForProjectSnapshot Boolean                       @default(true)
  codeEnabled                Boolean                       @default(true)
  metadataEnabled            Boolean                       @default(true)
  includeRoots               Json                          @default("[\".\"]") @db.JsonB
  softExcludePatterns        Json                          @default("[]") @db.JsonB
  status                     ProjectRepositoryLinkStatus   @default(active)
  createdById                String                        @db.Uuid
  disabledAt                 DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  project                    Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  repository                 GitRepository                 @relation(fields: [gitRepositoryId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  createdBy                  AppUser                       @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  snapshots                  GitRepositorySnapshot[]
  snapshotEntries            GitRepositorySnapshotEntry[]
  snapshotPointer            GitRepositorySnapshotPointer?

  @@unique([projectId, id])
  @@unique([projectId, gitRepositoryId])
  @@index([projectId, status, updatedAt])
