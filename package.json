{
  "name": "ai-project-os",
  "version": "5.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "tsx scripts/automation-worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=60 --test-coverage-branches=78 --test-coverage-functions=67 '--test-coverage-include=src/**/*.ts' '--test-coverage-include=src/**/*.tsx' '--test-coverage-exclude=src/**/*.d.ts' test/*.test.ts",
    "test:browser-e2e": "tsx scripts/run-browser-e2e.ts",
    "performance:check": "node --import tsx scripts/check-performance-budget.ts",
    "test:performance": "node --import tsx scripts/run-performance-gate.ts",
    "release:local": "node --import tsx scripts/run-local-release.ts",
    "test:ai-runtime-postgres": "tsx --test test/ai-runtime-postgres.test.ts",
    "test:v1-storage-postgres": "tsx --test test/project-item-history-postgres.test.ts",
    "test:corpus-index-postgres": "tsx --test test/corpus-index-postgres.test.ts",
    "test:github-ledger-postgres": "tsx --test test/github-ledger-postgres.test.ts",
    "test:github-material-postgres": "tsx --test test/github-material-ledger-postgres.test.ts",
    "test:github-material-sync-postgres": "tsx --test test/github-material-sync-postgres.test.ts",
    "test:github-scan-postgres": "tsx --test test/github-code-scan-postgres.test.ts",
    "test:repository-memory-postgres": "tsx --test test/repository-memory-postgres.test.ts",
    "test:project-intelligence-postgres": "tsx --test test/project-intelligence-postgres.test.ts",
    "test:action-engine-postgres": "tsx --test test/action-engine-postgres.test.ts",
    "test:mcp-capabilities-postgres": "tsx --test test/mcp-capabilities-postgres.test.ts",
    "test:project-plan-postgres": "tsx --test test/project-plan-postgres.test.ts",
    "test:project-world-postgres": "tsx --test test/project-world-postgres.test.ts",
    "test:worker-health-postgres": "tsx --test test/worker-health-postgres.test.ts",
    "test:postgres-gates": "tsx scripts/run-postgres-gates.ts",
    "project-snapshot:demo": "tsx scripts/project-snapshot-demo.ts",
    "project-ai:config": "tsx scripts/project-ai-config.ts",
    "github-repository": "tsx scripts/github-repository.ts",
    "project-memory:index": "tsx scripts/project-memory-index.ts",
    "project-memory:publish": "tsx scripts/project-memory-publish.ts",
    "project-memory:search": "tsx scripts/project-memory-search.ts",
    "repository-ai:grant": "tsx scripts/repository-model-grant.ts",
    "repository-material-ai:grant": "tsx scripts/repository-material-model-grant.ts",
    "repository-code:search": "tsx scripts/repository-code-search.ts",
    "external:acceptance": "tsx scripts/external-service-acceptance.ts",
    "db:validate": "prisma validate --config prisma.config.ts && pnpm db:migrations:validate",
    "db:migrations:validate": "tsx scripts/validate-migrations.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "jose": "6.2.10",
    "next": "16.3.3",
    "pdfjs-dist": "5.4.149",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "3.2.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "2.10.3",
    "dotenv": "16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.20.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.14.0"
}
