  printf 'PRESERVE_DEPLOY_ROLLBACK_OK tag=%s data_snapshot=%s migration_ledger=%s\n' \
    "$SOURCE_TAG" "$DATA_SNAPSHOT_BEFORE" "$MIGRATION_SNAPSHOT_BEFORE"
}

quiesce_current_writers_after_rollback_failure() {
  local writer_ids remaining_app_ids remaining_worker_ids writer_id
  writer_ids=$(
    {
      docker ps --no-trunc -q --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
        --filter "label=com.docker.compose.service=app"
      docker ps --no-trunc -q --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
        --filter "label=com.docker.compose.service=worker"
    } | sort -u
  ) || return 1

  while IFS= read -r writer_id; do
    [[ -z "$writer_id" ]] && continue
    [[ "$writer_id" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$writer_id" != "$POSTGRES_ID" ]] || return 1
    docker stop "$writer_id" >/dev/null || return 1
  done <<<"$writer_ids"

  remaining_app_ids=$(docker ps --no-trunc -q \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=app") || return 1
  remaining_worker_ids=$(docker ps --no-trunc -q \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=worker") || return 1
  [[ -z "$remaining_app_ids" && -z "$remaining_worker_ids" ]] || return 1
  assert_maintenance_isolation
}

recover_on_failure() {
  local exit_code=$? recovery_status
  trap - EXIT
  if (( exit_code == 0 )); then
    return 0
  fi
  set +e
  if (( CUTOVER_ATTEMPTED == 1 )); then
    rollback_to_source
    recovery_status=$?
    if (( recovery_status != 0 )); then
      if quiesce_current_writers_after_rollback_failure; then
        printf 'PRESERVE_DEPLOY_RECOVERY_REQUIRED phase=post-switch writers_stopped=true postgres_action=none pgdata_action=none data_backup_preserved=true\n' >&2
      else
        printf 'PRESERVE_DEPLOY_EMERGENCY phase=post-switch writers_may_be_running=true stop_verification_failed=true postgres_action=none pgdata_action=none data_backup_preserved=true action=manual_intervention_required\n' >&2
      fi
    fi
  elif (( WRITER_RECOVERY_REQUIRED == 1 )); then
    restart_source_writers
    recovery_status=$?
    if (( recovery_status != 0 )); then
      printf 'PRESERVE_DEPLOY_RECOVERY_REQUIRED phase=pre-switch old_writers_not_restarted=true data_backup_preserved=true\n' >&2
    fi
  fi
  set -e
  return "$exit_code"
}

