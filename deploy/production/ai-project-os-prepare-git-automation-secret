#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

if [[ ${ENV_FILE+x} ]]; then
  [[ "$ENV_FILE" == /etc/ai-project-os/production.env ]] || return 70
else
  readonly ENV_FILE=/etc/ai-project-os/production.env
fi
readonly ENV_DIRECTORY=/etc/ai-project-os
if [[ ${LOCK_FILE+x} ]]; then
  [[ "$LOCK_FILE" == /run/lock/ai-project-os-deploy.lock ]] || return 70
else
  readonly LOCK_FILE=/run/lock/ai-project-os-deploy.lock
fi
readonly WORKER_PASSWORD_KEY=POSTGRES_GIT_AUTOMATION_WORKER_PASSWORD

temporary_env=

configure_production_path() {
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export LC_ALL=C
}

file_metadata() {
  python3 - "$1" <<'PY'
import os
import stat
import sys

try:
    metadata = os.lstat(sys.argv[1])
except OSError:
    raise SystemExit(1)

if stat.S_ISREG(metadata.st_mode):
    kind = "file"
elif stat.S_ISDIR(metadata.st_mode):
    kind = "directory"
else:
    kind = "other"

print(f"{metadata.st_uid}:{metadata.st_gid}:{stat.S_IMODE(metadata.st_mode):o}:{kind}")
PY
}

worker_password_state() {
  python3 - "$1" "$WORKER_PASSWORD_KEY" <<'PY'
import re
import sys

with open(sys.argv[1], "rb") as environment_file:
    lines = environment_file.read().split(b"\n")

key = sys.argv[2].encode("ascii")
candidates = []
for line in lines:
    stripped = line.lstrip(b" \t")
    if stripped.startswith(b"export "):
        stripped = stripped[len(b"export "):].lstrip(b" \t")
    if stripped.startswith(key) and (
        len(stripped) == len(key) or stripped[len(key):len(key) + 1] in (b"=", b" ", b"\t")
    ):
        candidates.append(line)

if len(candidates) > 1:
    print("duplicate")
elif not candidates:
    print("missing")
elif re.fullmatch(re.escape(key) + rb"=[0-9a-f]{64}", candidates[0]):
    print("valid")
else:
    print("malformed")
PY
}

cleanup_temporary_env() {
  if [[ -n "$temporary_env" && -e "$temporary_env" ]]; then
    rm -f -- "$temporary_env"
  fi
}

fsync_path() {
  python3 - "$1" "$2" <<'PY'
import os
import sys

path, kind = sys.argv[1:]
flags = os.O_RDONLY
if kind == "directory":
    flags |= getattr(os, "O_DIRECTORY", 0)
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
descriptor = os.open(path, flags)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
}

ensure_deploy_lock_file() {
  python3 - "$LOCK_FILE" <<'PY'
import os
import stat
import sys

lock_path = sys.argv[1]
lock_directory = os.path.dirname(lock_path)
directory = os.lstat(lock_directory)
if not stat.S_ISDIR(directory.st_mode) or (directory.st_uid, directory.st_gid) != (0, 0):
    raise SystemExit(1)
if stat.S_IMODE(directory.st_mode) != 0o1777:
    raise SystemExit(1)

flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(lock_path, flags | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    descriptor = os.open(lock_path, flags)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        raise SystemExit(1)
    if (metadata.st_uid, metadata.st_gid) != (0, 0):
        raise SystemExit(1)
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise SystemExit(1)
finally:
    os.close(descriptor)
PY
}

prepare_worker_password() {
  local env_file=$1
  local expected_uid=$2
  local expected_gid=$3
  local env_directory=${env_file%/*}
  local metadata state password needs_newline

  [[ "$expected_uid" =~ ^[0-9]+$ && "$expected_gid" =~ ^[0-9]+$ ]] || {
    printf 'GIT_AUTOMATION_SECRET_EXPECTED_OWNER_INVALID\n' >&2
    return 70
  }
  [[ -f "$env_file" && ! -L "$env_file" ]] || {
    printf 'GIT_AUTOMATION_SECRET_ENV_INVALID\n' >&2
    return 70
  }
  [[ -d "$env_directory" && ! -L "$env_directory" ]] || {
    printf 'GIT_AUTOMATION_SECRET_DIRECTORY_INVALID\n' >&2
    return 70
  }

  metadata=$(file_metadata "$env_file") || {
    printf 'GIT_AUTOMATION_SECRET_ENV_METADATA_INVALID\n' >&2
    return 70
  }
  [[ "$metadata" == "$expected_uid:$expected_gid:600:file" ]] || {
    printf 'GIT_AUTOMATION_SECRET_ENV_OWNERSHIP_OR_MODE_INVALID\n' >&2
    return 70
  }
  metadata=$(file_metadata "$env_directory") || {
    printf 'GIT_AUTOMATION_SECRET_DIRECTORY_METADATA_INVALID\n' >&2
    return 70
  }
  [[ "$metadata" == "$expected_uid:$expected_gid:700:directory" ]] || {
    printf 'GIT_AUTOMATION_SECRET_DIRECTORY_OWNERSHIP_OR_MODE_INVALID\n' >&2
    return 70
  }

  state=$(worker_password_state "$env_file") || {
    printf 'GIT_AUTOMATION_SECRET_ENV_READ_FAILED\n' >&2
    return 71
  }
  case "$state" in
    valid)
      printf 'GIT_AUTOMATION_SECRET_READY\n'
      return 0
      ;;
    duplicate)
      printf 'GIT_AUTOMATION_SECRET_ENV_DUPLICATE_KEY\n' >&2
      return 71
      ;;
    malformed)
      printf 'GIT_AUTOMATION_SECRET_ENV_VALUE_INVALID\n' >&2
      return 71
      ;;
    missing) ;;
    *)
      printf 'GIT_AUTOMATION_SECRET_ENV_STATE_INVALID\n' >&2
      return 71
      ;;
  esac

  password=$(openssl rand -hex 32 2>/dev/null) || {
    printf 'GIT_AUTOMATION_SECRET_GENERATION_FAILED\n' >&2
    return 72
  }
  [[ "$password" =~ ^[0-9a-f]{64}$ ]] || {
    unset password
    printf 'GIT_AUTOMATION_SECRET_GENERATION_INVALID\n' >&2
    return 72
  }

  temporary_env=$(mktemp "$env_directory/.production.env.git-automation.XXXXXX") || {
    unset password
    printf 'GIT_AUTOMATION_SECRET_TEMP_CREATE_FAILED\n' >&2
    return 72
  }
  if ! cat -- "$env_file" > "$temporary_env"; then
    unset password
    printf 'GIT_AUTOMATION_SECRET_ENV_COPY_FAILED\n' >&2
    return 72
  fi
  needs_newline=$(python3 - "$env_file" <<'PY'
import sys

with open(sys.argv[1], "rb") as environment_file:
    environment_file.seek(0, 2)
    if environment_file.tell() == 0:
        print("no")
    else:
        environment_file.seek(-1, 2)
        print("no" if environment_file.read(1) == b"\n" else "yes")
PY
  ) || {
    unset password
    printf 'GIT_AUTOMATION_SECRET_ENV_READ_FAILED\n' >&2
    return 72
  }
  if [[ "$needs_newline" == yes ]]; then
    printf '\n' >> "$temporary_env"
  fi
  printf '%s=%s\n' "$WORKER_PASSWORD_KEY" "$password" >> "$temporary_env"
  unset password

  chmod 600 "$temporary_env" || {
    printf 'GIT_AUTOMATION_SECRET_TEMP_MODE_INVALID\n' >&2
    return 72
  }
  metadata=$(file_metadata "$temporary_env") || {
    printf 'GIT_AUTOMATION_SECRET_TEMP_METADATA_INVALID\n' >&2
    return 72
  }
  [[ "$metadata" == "$expected_uid:$expected_gid:600:file" ]] || {
    printf 'GIT_AUTOMATION_SECRET_TEMP_OWNERSHIP_OR_MODE_INVALID\n' >&2
    return 72
  }
  if [[ $(worker_password_state "$temporary_env") != valid ]]; then
    printf 'GIT_AUTOMATION_SECRET_TEMP_CONTENT_INVALID\n' >&2
    return 72
  fi
  fsync_path "$temporary_env" file || {
    printf 'GIT_AUTOMATION_SECRET_TEMP_SYNC_FAILED\n' >&2
    return 72
  }
  if ! python3 - "$temporary_env" "$env_file" <<'PY'
import os
import sys

os.replace(sys.argv[1], sys.argv[2])
PY
  then
    printf 'GIT_AUTOMATION_SECRET_ENV_REPLACE_FAILED\n' >&2
    return 72
  fi
  temporary_env=
  fsync_path "$env_directory" directory || {
    printf 'GIT_AUTOMATION_SECRET_DIRECTORY_SYNC_FAILED\n' >&2
    return 72
  }

  printf 'GIT_AUTOMATION_SECRET_READY\n'
}

main() {
  configure_production_path
  [[ $# -eq 0 ]] || {
    printf 'GIT_AUTOMATION_SECRET_USAGE\n' >&2
    return 64
  }
  [[ $EUID -eq 0 ]] || {
    printf 'GIT_AUTOMATION_SECRET_ROOT_REQUIRED\n' >&2
    return 70
  }
  [[ -d "$ENV_DIRECTORY" && ! -L "$ENV_DIRECTORY" ]] || {
    printf 'GIT_AUTOMATION_SECRET_DIRECTORY_INVALID\n' >&2
    return 70
  }
  local directory_metadata
  directory_metadata=$(file_metadata "$ENV_DIRECTORY") || {
    printf 'GIT_AUTOMATION_SECRET_DIRECTORY_METADATA_INVALID\n' >&2
    return 70
  }
  [[ "$directory_metadata" == '0:0:700:directory' ]] || {
    printf 'GIT_AUTOMATION_SECRET_DIRECTORY_OWNERSHIP_OR_MODE_INVALID\n' >&2
    return 70
  }

  if ! ensure_deploy_lock_file; then
    printf 'GIT_AUTOMATION_SECRET_DEPLOY_LOCK_INVALID\n' >&2
    return 70
  fi
  exec 9>>"$LOCK_FILE"
  if ! flock -n 9; then
    printf 'GIT_AUTOMATION_SECRET_DEPLOYMENT_IN_PROGRESS\n' >&2
    return 75
  fi

  trap cleanup_temporary_env EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  prepare_worker_password "$ENV_FILE" 0 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
