generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectSourceKind {
  document
  screenshot
  github
  manual
}

enum ProjectItemType {
  decision
  progress
  issue
  risk
}

enum ProjectItemReviewStatus {
  candidate
  confirmed
  dismissed
  superseded
}

enum ContentOriginScope {
  project
  repository_link
}

enum ProjectItemEvidenceRole {
  primary
  supporting
}

enum ProjectItemEvidenceState {
  active
  purged
}

enum ProjectEvidenceRangeUnit {
  utf8_byte
  line
}

enum ProjectItemRevisionAction {
  legacyImport   @map("legacy_import")
  manualCreated  @map("manual_created")
  aiCreated      @map("ai_created")
  edited
  confirmed
  dismissed
  reopened
  rebindSource   @map("rebind_source")
  repairEvidence @map("repair_evidence")
}

enum ProjectItemRevisionIntegrityState {
  active
  purged_redacted
}

enum EmbeddingProvider {
  openai
}

enum EmbeddingNormalization {
  unit_length
}

enum SourceChunkState {
  active
  purged
}

enum ProjectCorpusGenerationStatus {
  staging
  complete
  failed
  ineligible
  superseded
}

enum IndexGenerationKind {
  projectCorpus      @map("project_corpus")
  repositoryMaterial @map("repository_material")
  repositoryCode     @map("repository_code")
}

enum IndexGenerationStatus {
  staging
  building
  ragReady                 @map("rag_ready")
  ragReadyEmpty            @map("rag_ready_empty")
  semanticDisabledByPolicy @map("semantic_disabled_by_policy")
  failed
  unknown
  cancelled
  ineligible
  superseded
}

enum IndexInputEntryKind {
  projectCorpus      @map("project_corpus")
  repositoryMaterial @map("repository_material")
  repositoryCode     @map("repository_code")
}

enum IndexBuildAttemptStatus {
  queued
  running
  succeeded
  failed
  unknown
  cancelled
}

enum IndexWorkItemStatus {
  queued
  running
  succeeded
  failed
  unknown
  cancelled
}

enum ProjectRagSnapshotStatus {
  staging
  complete
  ineligible
  superseded
}

enum AiDerivedArtifactKind {
  sourceSummary @map("source_summary")
  projectBrief  @map("project_brief")
  ragAnswer     @map("rag_answer")
  agentReport   @map("agent_report")
}

enum AiDerivedArtifactState {
  active
  stale
  restricted
}

enum ArtifactDependencyKind {
  projectSource      @map("project_source")
  projectRagSnapshot @map("project_rag_snapshot")
}

enum ArtifactRestrictionReasonCode {
  grantIneligible    @map("GRANT_INELIGIBLE")
  policyIneligible   @map("POLICY_INELIGIBLE")
  snapshotIneligible @map("SNAPSHOT_INELIGIBLE")
  dependencyMismatch @map("DEPENDENCY_MISMATCH")
}

enum ProjectScanTrigger {
  manual
  system
}

enum ProjectScanStatus {
  running
  completed
  failed
}

enum ModelProcessingGrantSourceKind {
  manual_text
}

enum ModelProcessingGrantStatus {
  draft
  issued
  revoked
}

enum ModelProcessingGrantRevocationReasonCode {
  userRequested
  policyChanged
  expired
  scannerFinding
  budgetExceeded
  securityReview
}

enum AiOperation {
  embedding
  autoExtract
  sourceSummary
  projectAnalysis
  generateWithContext
}

enum AiRunStatus {
  queued
  running
  succeeded
  failed
  unknown
  cancelled
}

enum AiRunAttemptStatus {
  sent
  succeeded
  failed
  unknown
  cancelled
}

enum AiBudgetProfile {
  standard
}

enum AiBudgetStatus {
  pending
  allowed
  exhausted
  exceeded
  rejected
}

enum AiSafeScanResult {
  passed
  blocked
  unavailable
}

enum AiAuditEventType {
  policyCreated
  policyAdvanced
  grantIssued
  grantRevoked
  preflightRejected
  scannerRejected
  budgetRejected
  runCreated
  runClaimed
  dispatchSent
  runSucceeded
  runFailed
  runUnknown
  runCancelled
  attemptSucceeded
  attemptFailed
  attemptUnknown
  attemptCancelled
}

enum AiSafeErrorCode {
  aiDisabled                 @map("AI_DISABLED")
  aiProviderDisabled         @map("AI_PROVIDER_DISABLED")
  aiInvalidOperationKeyInput @map("AI_INVALID_OPERATION_KEY_INPUT")
  aiInvalidStateTransition   @map("AI_INVALID_STATE_TRANSITION")
  aiRedispatchForbidden      @map("AI_REDISPATCH_FORBIDDEN")
  aiProviderIncomplete       @map("AI_PROVIDER_INCOMPLETE")
  aiProviderUnknown          @map("AI_PROVIDER_UNKNOWN")
  aiProviderFailed           @map("AI_PROVIDER_FAILED")
  aiProviderCancelled        @map("AI_PROVIDER_CANCELLED")
  aiDispatchNotSent          @map("AI_DISPATCH_NOT_SENT")
  aiPolicyDenied             @map("AI_POLICY_DENIED")
  aiGrantDenied              @map("AI_GRANT_DENIED")
  aiScannerDenied            @map("AI_SCANNER_DENIED")
  aiBudgetDenied             @map("AI_BUDGET_DENIED")
  aiInvalidProviderResponse  @map("AI_INVALID_PROVIDER_RESPONSE")
  sourceInUse                @map("SOURCE_IN_USE")
}

enum AiCandidateReviewStatus {
  candidate
  accepted
  dismissed
}

enum GitHubConnectionStatus {
  configured
  verified
  disabled
  accessUnknown @map("access_unknown")
}

enum ProjectRepositoryLinkStatus {
  active
  disabled
  unlinked
  accessUnknown @map("access_unknown")
}

enum ProjectRepositoryRole {
  primary
  application
  infrastructure
  library
  documentation
  other
}

enum ProjectScanBatchStatus {
  queued
  running
  succeeded
  partial
  partialOptional @map("partial_optional")
  failed
  unknown
  cancelled
}

enum RepoCodeScanRunStatus {
  queued
  running
  succeeded
  failed
  rateLimited @map("rate_limited")
  unknown
  cancelled
}

enum RepoCodeScanStage {
  queued
  discovering
  fetching
  scanning
  publishing
  terminal
}

enum RepositoryCodeGenerationStatus {
  staging
  codeReady  @map("code_ready")
  failed
  ineligible
  superseded
}

enum ProjectCodeSnapshotStatus {
  staging
  complete
  ineligible
  superseded
}

model Project {
  id                               String                               @id @default(uuid()) @db.Uuid
  name                             String
  slug                             String                               @unique
  description                      String?                              @db.Text
  createdAt                        DateTime                             @default(now())
  updatedAt                        DateTime                             @updatedAt
  sources                          ProjectSource[]
  items                            ProjectItem[]
  scans                            ProjectScan[]
  snapshots                        ProjectSnapshot[]
  aiPolicy                         ProjectAiPolicy?
  aiPolicyRevisions                ProjectAiPolicyRevision[]
  aiPolicyOperationProfiles        ProjectAiPolicyOperationProfile[]
  aiGrants                         ModelProcessingGrant[]
  aiGrantSources                   ModelProcessingGrantSource[]
  aiGrantOperations                ModelProcessingGrantOperation[]
  aiRuns                           AiRun[]
  aiAttempts                       AiRunAttempt[]
  aiInputSources                   AiRunInputSource[]
  aiAuditEvents                    AiAuditEvent[]
  aiCandidateBatches               AiCandidateBatch[]
  aiCandidateClaims                AiCandidateClaim[]
  itemEvidences                    ProjectItemEvidence[]
  itemRevisions                    ProjectItemRevision[]
  itemRevisionEvidences            ProjectItemRevisionEvidence[]
  sourceChunks                     SourceChunk[]
  corpusGenerations                ProjectCorpusGeneration[]
  indexGenerations                 IndexGeneration[]
  indexBuildAttempts               IndexBuildAttempt[]
  indexWorkItems                   IndexWorkItem[]
  chunkEmbeddings                  ChunkEmbedding[]
  corpusIndexPointer               ProjectCorpusIndexPointer?
  ragSnapshots                     ProjectRagSnapshot[]
  ragSnapshotPointer               ProjectRagSnapshotPointer?
  aiDerivedArtifacts               AiDerivedArtifact[]
  artifactDependencies             ArtifactDependency[]
  githubConnections                GitHubConnection[]
  repositoryLinks                  ProjectRepositoryLink[]
  repositoryLinkConfigVersions     ProjectRepositoryLinkConfigVersion[]
  repositoryLinkConfigPointers     ProjectRepositoryLinkConfigPointer[]
  scanBatches                      ProjectScanBatch[]
  scanBatchEntries                 ProjectScanBatchEntry[]
  repoCodeScanRuns                 RepoCodeScanRun[]
  repositoryFiles                  RepositoryFile[]
  repositoryFileRevisions          RepositoryFileRevision[]
  repositoryCodeGenerations        RepositoryCodeGeneration[]
  repositoryCodeGenerationEntries  RepositoryCodeGenerationEntry[]
  repositoryCodeGenerationPointers RepositoryCodeGenerationPointer[]
  codeSnapshots                    ProjectCodeSnapshot[]
  codeSnapshotEntries              ProjectCodeSnapshotEntry[]
  codeSnapshotPointer              ProjectCodeSnapshotPointer?

  @@index([updatedAt])
}

model GitHubConnection {
  id                    String                  @id @default(uuid()) @db.Uuid
  projectId             String                  @db.Uuid
  authRef               String                  @db.VarChar(128)
  status                GitHubConnectionStatus  @default(configured)
  connectionFingerprint String                  @db.VarChar(64)
  verifiedAt            DateTime?
  disabledAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  project               Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLinks       ProjectRepositoryLink[]

  @@unique([projectId, id])
  @@unique([projectId, connectionFingerprint])
  @@index([projectId, status])
}

model GitHubRepository {
  id                 String                  @id @default(uuid()) @db.Uuid
  githubRepositoryId BigInt                  @unique
  nodeId             String                  @db.VarChar(512)
  currentOwner       String                  @db.VarChar(256)
  currentName        String                  @db.VarChar(256)
  currentFullName    String                  @db.VarChar(512)
  isPrivate          Boolean
  isArchived         Boolean                 @default(false)
  isDisabled         Boolean                 @default(false)
  defaultBranch      String                  @db.VarChar(1024)
  lastVerifiedAt     DateTime
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  repositoryLinks    ProjectRepositoryLink[]

  @@unique([id, githubRepositoryId])
  @@index([currentFullName])
}

model ProjectRepositoryLink {
  id                      String                               @id @default(uuid()) @db.Uuid
  projectId               String                               @db.Uuid
  githubConnectionId      String                               @db.Uuid
  githubRepositoryId      String                               @db.Uuid
  status                  ProjectRepositoryLinkStatus          @default(active)
  effectivePolicyVersion  Int                                  @default(1)
  createdAt               DateTime                             @default(now())
  updatedAt               DateTime                             @updatedAt
  disabledAt              DateTime?
  unlinkedAt              DateTime?
  project                 Project                              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubConnection        GitHubConnection                     @relation(fields: [projectId, githubConnectionId], references: [projectId, id], onDelete: NoAction, onUpdate: Cascade)
  githubRepository        GitHubRepository                     @relation(fields: [githubRepositoryId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  configVersions          ProjectRepositoryLinkConfigVersion[]
  configPointer           ProjectRepositoryLinkConfigPointer?  @relation("RepositoryLinkConfigPointer")
  scanBatchEntries        ProjectScanBatchEntry[]
  codeScanRuns            RepoCodeScanRun[]
  repositoryFiles         RepositoryFile[]
  repositoryFileRevisions RepositoryFileRevision[]
  codeGenerations         RepositoryCodeGeneration[]
  codeGenerationEntries   RepositoryCodeGenerationEntry[]
  codeGenerationPointer   RepositoryCodeGenerationPointer?     @relation("RepositoryCodeGenerationPointerLink")
  codeSnapshotEntries     ProjectCodeSnapshotEntry[]
  sources                 ProjectSource[]                      @relation("RepositoryLinkSources")
  itemEvidences           ProjectItemEvidence[]                @relation("RepositoryLinkItemEvidences")
  sourceChunks            SourceChunk[]                        @relation("RepositoryLinkChunks")

  @@unique([projectId, id])
  @@unique([projectId, githubRepositoryId])
  @@index([projectId, status])
  @@index([githubConnectionId])
  @@index([githubRepositoryId])
}

model ProjectRepositoryLinkConfigVersion {
  id                         String                              @id @default(uuid()) @db.Uuid
  projectId                  String                              @db.Uuid
  projectRepositoryLinkId    String                              @db.Uuid
  version                    Int
  role                       ProjectRepositoryRole
  requiredForProjectSnapshot Boolean                             @default(true)
  trackedRef                 String                              @db.VarChar(255)
  codeEnabled                Boolean                             @default(true)
  metadataEnabled            Boolean                             @default(true)
  readmeEnabled              Boolean                             @default(true)
  markdownEnabled            Boolean                             @default(false)
  issuesEnabled              Boolean                             @default(false)
  pullRequestsEnabled        Boolean                             @default(false)
  releasesEnabled            Boolean                             @default(false)
  includeRoots               Json                                @db.JsonB
  softExcludePatterns        Json                                @db.JsonB
  scanScopeFingerprint       String                              @db.VarChar(64)
  policyFingerprint          String                              @db.VarChar(64)
  effectivePolicyVersion     Int
  createdAt                  DateTime                            @default(now())
  project                    Project                             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink             ProjectRepositoryLink               @relation(fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepoLinkConfigVersion_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  activePointer              ProjectRepositoryLinkConfigPointer? @relation("ActiveRepositoryLinkConfig")
  scanBatchEntries           ProjectScanBatchEntry[]
  codeScanRuns               RepoCodeScanRun[]
  codeGenerations            RepositoryCodeGeneration[]
  codeGenerationPointers     RepositoryCodeGenerationPointer[]   @relation("RepositoryCodePointerConfig")
  codeSnapshotEntries        ProjectCodeSnapshotEntry[]

  @@unique([projectId, id])
  @@unique([projectId, projectRepositoryLinkId, version])
  @@unique([projectId, projectRepositoryLinkId, version, requiredForProjectSnapshot], map: "RepositoryLinkConfig_required_candidate_key")
  @@unique([projectId, projectRepositoryLinkId, version, effectivePolicyVersion], map: "RepositoryLinkConfig_policy_candidate_key")
  @@unique([projectId, projectRepositoryLinkId, version, requiredForProjectSnapshot, effectivePolicyVersion], map: "RepositoryLinkConfig_required_policy_key")
  @@index([projectId, projectRepositoryLinkId, createdAt])
}

model ProjectRepositoryLinkConfigPointer {
  projectId               String                             @db.Uuid
  projectRepositoryLinkId String                             @db.Uuid
  configVersion           Int
  effectivePolicyVersion  Int
  updatedAt               DateTime                           @updatedAt
  project                 Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink          ProjectRepositoryLink              @relation("RepositoryLinkConfigPointer", fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepoLinkConfigPointer_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  config                  ProjectRepositoryLinkConfigVersion @relation("ActiveRepositoryLinkConfig", fields: [projectId, projectRepositoryLinkId, configVersion, effectivePolicyVersion], references: [projectId, projectRepositoryLinkId, version, effectivePolicyVersion], map: "RepoLinkConfigPointer_config_fkey", onDelete: NoAction, onUpdate: Cascade)

  @@id([projectId, projectRepositoryLinkId])
  @@unique([projectId, projectRepositoryLinkId, configVersion], map: "RepoLinkConfigPointer_config_key")
  @@unique([projectId, projectRepositoryLinkId, configVersion, effectivePolicyVersion], map: "RepoLinkConfigPointer_policy_key")
  @@index([projectId, configVersion])
}

model ProjectScanBatch {
  id                          String                  @id @default(uuid()) @db.Uuid
  projectId                   String                  @db.Uuid
  status                      ProjectScanBatchStatus  @default(queued)
  requiredManifestFingerprint String                  @db.VarChar(64)
  expectedRequiredLinkCount   Int
  expectedOptionalLinkCount   Int
  completedRequiredLinkCount  Int                     @default(0)
  completedOptionalLinkCount  Int                     @default(0)
  failureCode                 String?                 @db.VarChar(64)
  startedAt                   DateTime                @default(now())
  completedAt                 DateTime?
  project                     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries                     ProjectScanBatchEntry[]
  codeScanRuns                RepoCodeScanRun[]
  codeSnapshot                ProjectCodeSnapshot?

  @@unique([projectId, id])
  @@unique([projectId, requiredManifestFingerprint, startedAt])
  @@index([projectId, status, startedAt])
}

model ProjectScanBatchEntry {
  id                         String                             @id @default(uuid()) @db.Uuid
  projectId                  String                             @db.Uuid
  projectScanBatchId         String                             @db.Uuid
  projectRepositoryLinkId    String                             @db.Uuid
  linkConfigVersion          Int
  requiredForProjectSnapshot Boolean
  effectivePolicyVersion     Int
  createdAt                  DateTime                           @default(now())
  project                    Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch                      ProjectScanBatch                   @relation(fields: [projectId, projectScanBatchId], references: [projectId, id], map: "ProjectScanBatchEntry_batch_fkey", onDelete: NoAction, onUpdate: Cascade)
  repositoryLink             ProjectRepositoryLink              @relation(fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "ProjectScanBatchEntry_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  config                     ProjectRepositoryLinkConfigVersion @relation(fields: [projectId, projectRepositoryLinkId, linkConfigVersion, requiredForProjectSnapshot, effectivePolicyVersion], references: [projectId, projectRepositoryLinkId, version, requiredForProjectSnapshot, effectivePolicyVersion], map: "ProjectScanBatchEntry_config_fkey", onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, projectScanBatchId, projectRepositoryLinkId])
  @@index([projectId, projectRepositoryLinkId, linkConfigVersion])
}

model RepoCodeScanRun {
  id                             String                             @id @default(uuid()) @db.Uuid
  projectId                      String                             @db.Uuid
  projectRepositoryLinkId        String                             @db.Uuid
  projectScanBatchId             String?                            @db.Uuid
  linkConfigVersion              Int
  expectedEffectivePolicyVersion Int
  expectedActiveGenerationId     String?                            @db.Uuid
  operationKey                   String                             @db.VarChar(64)
  status                         RepoCodeScanRunStatus              @default(queued)
  stage                          RepoCodeScanStage                  @default(queued)
  frozenCommitSha                String?                            @db.Char(40)
  rootTreeSha                    String?                            @db.Char(40)
  requestCount                   Int                                @default(0)
  visitedTreeEntryCount          Int                                @default(0)
  discoveredFileCount            Int                                @default(0)
  decodedTextBytes               Int                                @default(0)
  failureCode                    String?                            @db.VarChar(64)
  retryAt                        DateTime?
  startedAt                      DateTime                           @default(now())
  completedAt                    DateTime?
  project                        Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink                 ProjectRepositoryLink              @relation(fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepoCodeScanRun_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  config                         ProjectRepositoryLinkConfigVersion @relation(fields: [projectId, projectRepositoryLinkId, linkConfigVersion, expectedEffectivePolicyVersion], references: [projectId, projectRepositoryLinkId, version, effectivePolicyVersion], map: "RepoCodeScanRun_config_fkey", onDelete: NoAction, onUpdate: Cascade)
  batch                          ProjectScanBatch?                  @relation(fields: [projectId, projectScanBatchId], references: [projectId, id], map: "RepoCodeScanRun_batch_fkey", onDelete: NoAction, onUpdate: Cascade)
  codeGeneration                 RepositoryCodeGeneration?

  @@unique([projectId, id])
  @@unique([projectId, projectRepositoryLinkId, id])
  @@unique([projectId, operationKey])
  @@index([projectId, projectRepositoryLinkId, status, startedAt])
  @@index([projectId, projectScanBatchId])
}

model RepositoryFile {
  id                      String                   @id @default(uuid()) @db.Uuid
  projectId               String                   @db.Uuid
  projectRepositoryLinkId String                   @db.Uuid
  normalizedPath          String                   @db.VarChar(1024)
  createdAt               DateTime                 @default(now())
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink          ProjectRepositoryLink    @relation(fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepositoryFile_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  revisions               RepositoryFileRevision[]

  @@unique([projectId, id])
  @@unique([projectId, projectRepositoryLinkId, id])
  @@unique([projectId, projectRepositoryLinkId, normalizedPath])
  @@index([projectId, projectRepositoryLinkId, createdAt])
}

model RepositoryFileRevision {
  id                      String                          @id @default(uuid()) @db.Uuid
  projectId               String                          @db.Uuid
  projectRepositoryLinkId String                          @db.Uuid
  repositoryFileId        String                          @db.Uuid
  blobOid                 String                          @db.Char(40)
  contentText             String                          @db.Text
  contentHash             String                          @db.Char(64)
  contentBytes            Int
  lineCount               Int
  scannerVersion          String                          @db.VarChar(128)
  scannerFingerprint      String                          @db.VarChar(64)
  createdAt               DateTime                        @default(now())
  project                 Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink          ProjectRepositoryLink           @relation(fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepositoryFileRevision_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  repositoryFile          RepositoryFile                  @relation(fields: [projectId, projectRepositoryLinkId, repositoryFileId], references: [projectId, projectRepositoryLinkId, id], map: "RepositoryFileRevision_file_fkey", onDelete: NoAction, onUpdate: Cascade)
  generationEntries       RepositoryCodeGenerationEntry[]

  @@unique([projectId, id])
  @@unique([projectId, projectRepositoryLinkId, id])
  @@unique([projectId, projectRepositoryLinkId, repositoryFileId, blobOid])
  @@index([projectId, projectRepositoryLinkId, repositoryFileId, createdAt])
}

model RepositoryCodeGeneration {
  id                         String                             @id @default(uuid()) @db.Uuid
  projectId                  String                             @db.Uuid
  projectRepositoryLinkId    String                             @db.Uuid
  linkConfigVersion          Int
  repoCodeScanRunId          String                             @db.Uuid
  status                     RepositoryCodeGenerationStatus     @default(staging)
  generationKey              String                             @db.VarChar(64)
  capturedGitHubRepositoryId BigInt
  capturedFullName           String                             @db.VarChar(512)
  frozenCommitSha            String                             @db.Char(40)
  rootTreeSha                String                             @db.Char(40)
  scanScopeFingerprint       String                             @db.VarChar(64)
  scannerVersion             String                             @db.VarChar(128)
  scannerFingerprint         String                             @db.VarChar(64)
  effectivePolicyVersion     Int
  manifestFingerprint        String                             @db.VarChar(64)
  exclusionManifest          Json                               @db.JsonB
  fileCount                  Int
  decodedTextBytes           Int
  createdAt                  DateTime                           @default(now())
  completedAt                DateTime?
  supersededAt               DateTime?
  project                    Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink             ProjectRepositoryLink              @relation(fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepositoryCodeGeneration_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  config                     ProjectRepositoryLinkConfigVersion @relation(fields: [projectId, projectRepositoryLinkId, linkConfigVersion, effectivePolicyVersion], references: [projectId, projectRepositoryLinkId, version, effectivePolicyVersion], map: "RepositoryCodeGeneration_config_fkey", onDelete: NoAction, onUpdate: Cascade)
  scanRun                    RepoCodeScanRun                    @relation(fields: [projectId, projectRepositoryLinkId, repoCodeScanRunId], references: [projectId, projectRepositoryLinkId, id], map: "RepositoryCodeGeneration_run_fkey", onDelete: NoAction, onUpdate: Cascade)
  entries                    RepositoryCodeGenerationEntry[]
  activePointer              RepositoryCodeGenerationPointer?   @relation("ActiveRepositoryCodeGeneration")
  codeSnapshotEntries        ProjectCodeSnapshotEntry[]

  @@unique([projectId, id])
  @@unique([projectId, projectRepositoryLinkId, id], map: "RepositoryCodeGeneration_link_id_key")
  @@unique([projectId, projectRepositoryLinkId, repoCodeScanRunId], map: "RepositoryCodeGeneration_run_key")
  @@unique([projectId, generationKey])
  @@index([projectId, projectRepositoryLinkId, status, createdAt])
}

model RepositoryCodeGenerationEntry {
  id                         String                   @id @default(uuid()) @db.Uuid
  projectId                  String                   @db.Uuid
  projectRepositoryLinkId    String                   @db.Uuid
  repositoryCodeGenerationId String                   @db.Uuid
  repositoryFileRevisionId   String                   @db.Uuid
  ordinal                    Int
  normalizedPath             String                   @db.VarChar(1024)
  mode                       String                   @db.Char(6)
  blobOid                    String                   @db.Char(40)
  contentHash                String                   @db.Char(64)
  contentBytes               Int
  lineCount                  Int
  createdAt                  DateTime                 @default(now())
  project                    Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink             ProjectRepositoryLink    @relation(fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepositoryCodeGenerationEntry_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  generation                 RepositoryCodeGeneration @relation(fields: [projectId, projectRepositoryLinkId, repositoryCodeGenerationId], references: [projectId, projectRepositoryLinkId, id], map: "RepositoryCodeGenerationEntry_generation_fkey", onDelete: NoAction, onUpdate: Cascade)
  fileRevision               RepositoryFileRevision   @relation(fields: [projectId, projectRepositoryLinkId, repositoryFileRevisionId], references: [projectId, projectRepositoryLinkId, id], map: "RepositoryCodeGenerationEntry_revision_fkey", onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectId, id])
  @@unique([projectId, projectRepositoryLinkId, repositoryCodeGenerationId, normalizedPath], map: "RepositoryCodeGenerationEntry_generation_path_key")
  @@unique([projectId, projectRepositoryLinkId, repositoryCodeGenerationId, ordinal], map: "RepositoryCodeGenerationEntry_generation_ordinal_key")
  @@index([projectId, projectRepositoryLinkId, repositoryFileRevisionId])
}

model RepositoryCodeGenerationPointer {
  projectId                  String                             @db.Uuid
  projectRepositoryLinkId    String                             @db.Uuid
  repositoryCodeGenerationId String                             @db.Uuid
  linkConfigVersion          Int
  effectivePolicyVersion     Int
  updatedAt                  DateTime                           @updatedAt
  project                    Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryLink             ProjectRepositoryLink              @relation("RepositoryCodeGenerationPointerLink", fields: [projectId, projectRepositoryLinkId], references: [projectId, id], map: "RepositoryCodePointer_link_fkey", onDelete: NoAction, onUpdate: Cascade)
  generation                 RepositoryCodeGeneration           @relation("ActiveRepositoryCodeGeneration", fields: [projectId, projectRepositoryLinkId, repositoryCodeGenerationId], references: [projectId, projectRepositoryLinkId, id], map: "RepositoryCodePointer_generation_fkey", onDelete: NoAction, onUpdate: Cascade)
  config                     ProjectRepositoryLinkConfigVersion @relation("RepositoryCodePointerConfig", fields: [projectId, projectRepositoryLinkId, linkConfigVersion, effectivePolicyVersion], references: [projectId, projectRepositoryLinkId, version, effectivePolicyVersion], map: "RepositoryCodePointer_config_fkey", onDelete: NoAction, onUpdate: Cascade)

  @@id([projectId, projectRepositoryLinkId])
  @@unique([projectId, projectRepositoryLinkId, repositoryCodeGenerationId], map: "RepositoryCodePointer_generation_key")
  @@index([projectId, repositoryCodeGenerationId])
}

model ProjectCodeSnapshot {
  id                  String                      @id @default(uuid()) @db.Uuid
  projectId           String                      @db.Uuid
  projectScanBatchId  String                      @db.Uuid
