model ProjectMcpToolGrant {
  id                String                    @id @default(uuid()) @db.Uuid
  projectId         String                    @db.Uuid
  connectionId      String                    @db.Uuid
  delegationId      String?                   @db.Uuid
  controlPlaneVersion Int?
  grantVersion      Int?
  toolName          String                    @db.VarChar(128)
  toolDefinitionId  String                    @db.Uuid
  attestationId     String?                   @db.Uuid
  definitionFingerprint String?               @db.Char(64)
  networkFingerprint    String?               @db.Char(64)
  credentialFingerprint String?               @db.Char(64)
  delegationVersion Int?
  delegationFingerprint String?               @db.Char(64)
  connectionConfigurationRevision Int?
  connectionOwnerAccountAccessVersion Int?
  grantorProjectMembershipId String?          @db.Uuid
  grantorMembershipCreatedAt DateTime?
