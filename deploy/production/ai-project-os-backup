  printf 'source_quiesced=%s\n' "$([[ "$CUTOVER_MODE" == 1 ]] && printf true || printf false)"
} > "$INCOMPLETE_DIR/backup-metadata.env"

(
  cd "$INCOMPLETE_DIR"
  sha256sum postgres.dump secrets.tar.gz uploads.tar.gz host-config.tar.gz backup-metadata.env > SHA256SUMS
  sha256sum --check SHA256SUMS >/dev/null
