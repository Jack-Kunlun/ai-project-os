#!/usr/bin/env bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

readonly RELEASE_TAG=${1-}
readonly EXPECTED_REVISION=${2-}
readonly CONFIRMATION=${3-}
readonly REPOSITORY_URL=https://github.com/Jack-Kunlun/ai-project-os.git
# Tooling uses a checkout separate from the live Compose project directory so
# refreshing control-plane files cannot change the running release checkout.
readonly TOOLING_REPOSITORY_DIR=/srv/ai-project-os/tooling-repository
readonly LOCK_FILE=/run/lock/ai-project-os-deploy.lock
readonly V07_STATE_FILE=/etc/ai-project-os/release-tooling-v07-state
readonly NGINX_CONFIG_DEST=/etc/nginx/sites-available/ai-project-os.conf
readonly NGINX_ENABLED_PATH=/etc/nginx/sites-enabled/ai-project-os.conf
V07_STATUS_FILES=(
  /usr/local/sbin/ai-project-os-actions-gateway
  /usr/local/sbin/ai-project-os-install-release-tooling
  /usr/local/sbin/ai-project-os-v07-deploy
  /usr/local/sbin/ai-project-os-prepare-git-automation-secret
  /usr/local/sbin/ai-project-os-backup
  /etc/nginx/sites-available/ai-project-os.conf
  /etc/ai-project-os/compose.operations.yaml
  /etc/sudoers.d/ai-project-os-deploy
)

# New tooling is installed only from the reviewed 0.7.0 release line.
# The running 0.6 tag is verified separately by the migration deployer.
readonly RELEASE_TAG_PATTERN='^v0\.7\.0$'

fail() {
  printf '%s\n' "$1" >&2
  exit "${2-70}"
}

[[ $EUID -eq 0 ]] || fail RELEASE_TOOLING_ROOT_REQUIRED
if [[ "$RELEASE_TAG" == --status && -z "$EXPECTED_REVISION" && -z "$CONFIRMATION" ]]; then
  command -v python3 >/dev/null || fail RELEASE_TOOLING_PYTHON_REQUIRED 69
  command -v sha256sum >/dev/null || fail RELEASE_TOOLING_CHECKSUM_REQUIRED 69
  command -v cmp >/dev/null || fail RELEASE_TOOLING_COMPARE_REQUIRED 69
  command -v tail >/dev/null || fail RELEASE_TOOLING_TAIL_REQUIRED 69
  python3 - "$V07_STATE_FILE" "${V07_STATUS_FILES[@]}" <<'PY' || fail V07_TOOLING_STATUS_INVALID 70
import os
import stat
import sys

for path in sys.argv[1:]:
    current = "/"
    components = [part for part in path.split("/") if part]
    for index, part in enumerate(components):
        current = os.path.join(current, part)
        metadata = os.lstat(current)
        mode = metadata.st_mode
        if (metadata.st_uid, metadata.st_gid) != (0, 0) or mode & 0o022:
            raise SystemExit(1)
        if index < len(components) - 1 and not stat.S_ISDIR(mode):
            raise SystemExit(1)
        if index == len(components) - 1 and not stat.S_ISREG(mode):
            raise SystemExit(1)
PY
  IFS=' ' read -r state_tag state_revision < "$V07_STATE_FILE"
  [[ "$state_tag" == tag=v0.7.0 && "$state_revision" =~ ^revision=[0-9a-f]{40}$ ]] || fail V07_TOOLING_STATUS_INVALID 70
  cmp -s <(tail -n +2 "$V07_STATE_FILE") <(sha256sum "${V07_STATUS_FILES[@]}") || fail V07_TOOLING_STATUS_INVALID 70
  printf 'TOOLING_V07_READY\n'
  exit 0
fi
[[ "$RELEASE_TAG" =~ $RELEASE_TAG_PATTERN ]] || fail RELEASE_TOOLING_TAG_INVALID 64
[[ "$EXPECTED_REVISION" =~ ^[0-9a-f]{40}$ ]] || fail RELEASE_TOOLING_REVISION_INVALID 65
[[ "$CONFIRMATION" == CONFIRM_INSTALL_RELEASE_TOOLING_V1 ]] || fail RELEASE_TOOLING_CONFIRMATION_INVALID 66

command -v python3 >/dev/null || fail RELEASE_TOOLING_PYTHON_REQUIRED 69
python3 - "$LOCK_FILE" <<'PY' || fail RELEASE_TOOLING_LOCK_INVALID 70
import os
import stat
import sys

lock_path = sys.argv[1]
directory = os.lstat(os.path.dirname(lock_path))
if not stat.S_ISDIR(directory.st_mode) or (directory.st_uid, directory.st_gid) != (0, 0):
    raise SystemExit(1)
if stat.S_IMODE(directory.st_mode) != 0o1777:
    raise SystemExit(1)
flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(lock_path, flags | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    descriptor = os.open(lock_path, flags)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or (metadata.st_uid, metadata.st_gid) != (0, 0):
        raise SystemExit(1)
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise SystemExit(1)
finally:
    os.close(descriptor)
PY
exec 9>>"$LOCK_FILE"
flock -n 9 || fail RELEASE_TOOLING_DEPLOYMENT_IN_PROGRESS 75

for required_command in bash chown cp curl dirname flock git grep install mktemp mv nginx python3 readlink rm sha256sum stat systemctl tar visudo; do
  command -v "$required_command" >/dev/null || fail RELEASE_TOOLING_COMMAND_MISSING 69
done

install -d -o root -g root -m 0755 /srv/ai-project-os

if [[ ! -d "$TOOLING_REPOSITORY_DIR/.git" ]]; then
  temporary_repository="${TOOLING_REPOSITORY_DIR}.init.$$"
  trap 'rm -rf -- "${temporary_repository-}"' EXIT
  git clone --filter=blob:none --no-checkout "$REPOSITORY_URL" "$temporary_repository"
  chown -R root:root "$temporary_repository"
  mv -- "$temporary_repository" "$TOOLING_REPOSITORY_DIR"
  trap - EXIT
fi

[[ ! -L "$TOOLING_REPOSITORY_DIR" && ! -L "$TOOLING_REPOSITORY_DIR/.git" ]] || fail RELEASE_TOOLING_REPOSITORY_INVALID
[[ "$(stat -c %U:%G "$TOOLING_REPOSITORY_DIR")" == root:root ]] || fail RELEASE_TOOLING_REPOSITORY_OWNER_INVALID
[[ "$(stat -c %U:%G "$TOOLING_REPOSITORY_DIR/.git")" == root:root ]] || fail RELEASE_TOOLING_REPOSITORY_OWNER_INVALID
[[ "$(git -C "$TOOLING_REPOSITORY_DIR" remote get-url origin)" == "$REPOSITORY_URL" ]] || fail RELEASE_TOOLING_REPOSITORY_ORIGIN_INVALID

git -C "$TOOLING_REPOSITORY_DIR" fetch --force --no-tags origin \
  "refs/tags/$RELEASE_TAG:refs/tags/$RELEASE_TAG"

[[ "$(git -C "$TOOLING_REPOSITORY_DIR" cat-file -t "refs/tags/$RELEASE_TAG")" == tag ]] || \
  fail RELEASE_TOOLING_TAG_NOT_ANNOTATED 67

resolved_revision=$(git -C "$TOOLING_REPOSITORY_DIR" rev-parse "refs/tags/$RELEASE_TAG^{}")
[[ "$resolved_revision" == "$EXPECTED_REVISION" ]] || fail RELEASE_TOOLING_TAG_REVISION_MISMATCH 68

# Require the same successful tag-push CI evidence used by the deployment
# entry point before any candidate file is promoted to a root-owned path.
ci_runs_url="https://api.github.com/repos/Jack-Kunlun/ai-project-os/actions/workflows/ci.yml/runs?event=push&status=success&head_sha=$EXPECTED_REVISION&per_page=100"
ci_runs_json=$(curl --fail --silent --show-error \
  --header 'Accept: application/vnd.github+json' \
  --header 'X-GitHub-Api-Version: 2022-11-28' \
  "$ci_runs_url")

if ! python3 -c '
import json
import sys

payload = json.load(sys.stdin)
revision, tag = sys.argv[1:3]
accepted = any(
    run.get("head_sha") == revision
    and run.get("head_branch") == tag
    and run.get("event") == "push"
    and run.get("status") == "completed"
    and run.get("conclusion") == "success"
    for run in payload.get("workflow_runs", [])
)
raise SystemExit(0 if accepted else 1)
' "$EXPECTED_REVISION" "$RELEASE_TAG" <<<"$ci_runs_json"; then
  fail RELEASE_TOOLING_SUCCESSFUL_CI_NOT_FOUND 72
fi

candidate_root=$(mktemp -d /srv/ai-project-os/.release-tooling.XXXXXX)
STAGED_FILES=()
IS_V07_RELEASE=false
NGINX_CONFIG_PROMOTED=false
NGINX_CONFIG_COMMITTED=false
NGINX_BACKUP_PATH=""
NGINX_WAS_ACTIVE=false
if [[ "$RELEASE_TAG" == v0.7.0 ]]; then
  IS_V07_RELEASE=true
fi

rollback_nginx_configuration() {
  local rollback_failed=false
  if [[ -n "$NGINX_BACKUP_PATH" && -f "$NGINX_BACKUP_PATH" && ! -L "$NGINX_BACKUP_PATH" ]]; then
    if mv -f -- "$NGINX_BACKUP_PATH" "$NGINX_CONFIG_DEST"; then
      NGINX_BACKUP_PATH=""
    else
      rollback_failed=true
    fi
  else
    rollback_failed=true
  fi
  if [[ "$rollback_failed" == false ]] && ! nginx -t >/dev/null 2>&1; then
    rollback_failed=true
  fi
  if [[ "$rollback_failed" == false && "$NGINX_WAS_ACTIVE" == true ]]; then
    if systemctl is-active --quiet nginx; then
      systemctl reload nginx >/dev/null 2>&1 || rollback_failed=true
    else
      systemctl start nginx >/dev/null 2>&1 || rollback_failed=true
    fi
    systemctl is-active --quiet nginx || rollback_failed=true
  fi
  if [[ "$rollback_failed" == true ]]; then
    printf '%s\n' RELEASE_TOOLING_NGINX_ROLLBACK_FAILED >&2
    [[ -z "$NGINX_BACKUP_PATH" ]] || printf 'rollback_backup=%s\n' "$NGINX_BACKUP_PATH" >&2
  fi
}

# Remove only process-owned temporary paths. Installed destinations are never
# removed by cleanup, including when a later rename fails.
cleanup() {
  local staged
  if [[ "$NGINX_CONFIG_PROMOTED" == true && "$NGINX_CONFIG_COMMITTED" != true ]]; then
    rollback_nginx_configuration
  elif [[ -n "$NGINX_BACKUP_PATH" ]]; then
    rm -f -- "$NGINX_BACKUP_PATH"
  fi
  rm -rf -- "${candidate_root-}"
  for staged in "${STAGED_FILES[@]}"; do
    [[ -z "$staged" ]] || rm -f -- "$staged"
  done
}
trap cleanup EXIT

# Archive only the fixed allowlist. Extracting the whole deployment directory
# would unnecessarily admit unrelated candidate-controlled paths.
ARCHIVE_PATHS=(
  package.json \
  deploy/production/ai-project-os-actions-gateway \
  deploy/production/ai-project-os-install-release-tooling \
  deploy/production/ai-project-os-deploy \
  deploy/production/ai-project-os-v06-deploy \
  deploy/production/ai-project-os-v06-patch-deploy \
  deploy/production/ai-project-os-v06-next-deploy \
  deploy/production/ai-project-os-v06-default-memory-deploy \
  deploy/production/ai-project-os-app-deploy \
  deploy/production/ai-project-os-preserve-deploy \
  deploy/production/ai-project-os-backup \
  deploy/production/ai_project_os_backup_artifact.py \
  deploy/production/ai-project-os-restore \
  deploy/production/ai-project-os-configure-github-oauth \
  deploy/production/nginx/ai-project-os.conf \
  deploy/production/compose.operations.yaml \
  deploy/production/ai-project-os-deploy.sudoers \
  scripts/production-v06-patch-upgrade-preflight.ts \
  scripts/production-v06-next-upgrade-preflight.ts \
  scripts/production-v06-default-memory-upgrade-preflight.ts \
  scripts/production-app-upgrade-preflight.ts
)
if [[ "$IS_V07_RELEASE" == true ]]; then
  ARCHIVE_PATHS+=(
    deploy/production/ai-project-os-v07-deploy
    deploy/production/ai-project-os-prepare-git-automation-secret
    scripts/production-v07-upgrade-preflight.ts
  )
fi
git -C "$TOOLING_REPOSITORY_DIR" archive --format=tar "$EXPECTED_REVISION" -- \
  "${ARCHIVE_PATHS[@]}" | \
  tar --extract --file=- --directory "$candidate_root" --no-same-owner --no-same-permissions

package_version=$(python3 -c '
import json
import pathlib
import sys

value = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
version = value.get("version")
if not isinstance(version, str):
    raise SystemExit(1)
print(version, end="")
' "$candidate_root/package.json") || fail RELEASE_TOOLING_PACKAGE_INVALID 68
[[ "v$package_version" == "$RELEASE_TAG" ]] || fail RELEASE_TOOLING_PACKAGE_VERSION_MISMATCH 68

readonly CANDIDATE_DIR=$candidate_root/deploy/production
readonly GATEWAY=$CANDIDATE_DIR/ai-project-os-actions-gateway
readonly UPDATER=$CANDIDATE_DIR/ai-project-os-install-release-tooling
readonly DEPLOYER=$CANDIDATE_DIR/ai-project-os-deploy
readonly V06_DEPLOYER=$CANDIDATE_DIR/ai-project-os-v06-deploy
readonly V06_PATCH_DEPLOYER=$CANDIDATE_DIR/ai-project-os-v06-patch-deploy
readonly V06_NEXT_DEPLOYER=$CANDIDATE_DIR/ai-project-os-v06-next-deploy
readonly V06_DEFAULT_MEMORY_DEPLOYER=$CANDIDATE_DIR/ai-project-os-v06-default-memory-deploy
readonly APP_DEPLOYER=$CANDIDATE_DIR/ai-project-os-app-deploy
readonly PRESERVE_DEPLOYER=$CANDIDATE_DIR/ai-project-os-preserve-deploy
readonly BACKUP=$CANDIDATE_DIR/ai-project-os-backup
readonly BACKUP_ARTIFACT_HELPER=$CANDIDATE_DIR/ai_project_os_backup_artifact.py
readonly RESTORE=$CANDIDATE_DIR/ai-project-os-restore
readonly OAUTH_CONFIGURATOR=$CANDIDATE_DIR/ai-project-os-configure-github-oauth
readonly V07_DEPLOYER=$CANDIDATE_DIR/ai-project-os-v07-deploy
readonly GIT_AUTOMATION_SECRET_PREPARER=$CANDIDATE_DIR/ai-project-os-prepare-git-automation-secret
readonly NGINX_CONFIG=$CANDIDATE_DIR/nginx/ai-project-os.conf
readonly V07_PREFLIGHT=$candidate_root/scripts/production-v07-upgrade-preflight.ts
readonly COMPOSE_OVERRIDE=$CANDIDATE_DIR/compose.operations.yaml
readonly SUDOERS=$CANDIDATE_DIR/ai-project-os-deploy.sudoers

# Reject missing files, symlinks, and empty placeholders before validating any
# content. The candidate cannot choose an install source or destination path.
for candidate in \
  "$GATEWAY" \
  "$UPDATER" \
  "$DEPLOYER" \
  "$V06_DEPLOYER" \
  "$V06_PATCH_DEPLOYER" \
  "$V06_NEXT_DEPLOYER" \
  "$V06_DEFAULT_MEMORY_DEPLOYER" \
  "$APP_DEPLOYER" \
  "$PRESERVE_DEPLOYER" \
  "$BACKUP" \
  "$BACKUP_ARTIFACT_HELPER" \
  "$RESTORE" \
  "$OAUTH_CONFIGURATOR" \
  "$NGINX_CONFIG" \
  "$COMPOSE_OVERRIDE" \
  "$SUDOERS"; do
  [[ -f "$candidate" && ! -L "$candidate" && -s "$candidate" ]] || fail RELEASE_TOOLING_CANDIDATE_INVALID 69
done

if [[ "$IS_V07_RELEASE" == true ]]; then
  for candidate in "$V07_DEPLOYER" "$GIT_AUTOMATION_SECRET_PREPARER" "$V07_PREFLIGHT"; do
    [[ -f "$candidate" && ! -L "$candidate" && -s "$candidate" ]] || fail RELEASE_TOOLING_V07_CANDIDATE_INVALID 69
  done
fi

for script in "$GATEWAY" "$UPDATER" "$DEPLOYER" "$V06_DEPLOYER" "$V06_PATCH_DEPLOYER" "$V06_NEXT_DEPLOYER" "$V06_DEFAULT_MEMORY_DEPLOYER" "$APP_DEPLOYER" "$PRESERVE_DEPLOYER" "$BACKUP" "$RESTORE" "$OAUTH_CONFIGURATOR"; do
  bash -n "$script" || fail RELEASE_TOOLING_SCRIPT_INVALID 69
done
if [[ "$IS_V07_RELEASE" == true ]]; then
  bash -n "$V07_DEPLOYER" || fail RELEASE_TOOLING_V07_DEPLOYER_INVALID 69
  bash -n "$GIT_AUTOMATION_SECRET_PREPARER" || fail RELEASE_TOOLING_V07_SECRET_PREPARER_INVALID 69
fi
python3 -m py_compile "$BACKUP_ARTIFACT_HELPER" || fail RELEASE_TOOLING_BACKUP_HELPER_INVALID 69

# The refreshed gateway must retain this stable updater entry. Otherwise one
# release could silently require interactive server access again.
grep -Fq 'CONFIRM_INSTALL_RELEASE_TOOLING_V1' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fq '/usr/local/sbin/ai-project-os-install-release-tooling' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fq 'CONFIRM_V06_MIGRATION_V1' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fq '/usr/local/sbin/ai-project-os-v06-deploy' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fq 'v0.6.0-dev.6' "$V06_DEPLOYER" || fail RELEASE_TOOLING_V06_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'scripts/production-v06-upgrade-preflight.ts' "$V06_DEPLOYER" || fail RELEASE_TOOLING_V06_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'v0.6.0-dev.7' "$V06_PATCH_DEPLOYER" || fail RELEASE_TOOLING_V06_PATCH_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'scripts/production-v06-patch-upgrade-preflight.ts' "$V06_PATCH_DEPLOYER" || fail RELEASE_TOOLING_V06_PATCH_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'CONFIRM_V06_PATCH_V1' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
[[ -s "$candidate_root/scripts/production-v06-patch-upgrade-preflight.ts" ]] || fail RELEASE_TOOLING_PATCH_PREFLIGHT_INVALID 69
grep -Fq 'v0.6.0-dev.8' "$V06_NEXT_DEPLOYER" || fail RELEASE_TOOLING_V06_NEXT_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'scripts/production-v06-next-upgrade-preflight.ts' "$V06_NEXT_DEPLOYER" || fail RELEASE_TOOLING_V06_NEXT_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'CONFIRM_V06_NEXT_MIGRATION_V1' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
[[ -s "$candidate_root/scripts/production-v06-next-upgrade-preflight.ts" ]] || fail RELEASE_TOOLING_NEXT_PREFLIGHT_INVALID 69
grep -Fq 'v0.6.0-dev.11' "$V06_DEFAULT_MEMORY_DEPLOYER" || fail RELEASE_TOOLING_V06_DEFAULT_MEMORY_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'scripts/production-v06-default-memory-upgrade-preflight.ts' "$V06_DEFAULT_MEMORY_DEPLOYER" || fail RELEASE_TOOLING_V06_DEFAULT_MEMORY_DEPLOY_CONTRACT_INVALID 69
grep -Fq 'CONFIRM_V06_DEFAULT_MEMORY_MIGRATION_V1' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
[[ -s "$candidate_root/scripts/production-v06-default-memory-upgrade-preflight.ts" ]] || fail RELEASE_TOOLING_DEFAULT_MEMORY_PREFLIGHT_INVALID 69
grep -Fq 'CONFIRM_APP_NO_MIGRATION_V1' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fq 'scripts/production-app-upgrade-preflight.ts' "$APP_DEPLOYER" || fail RELEASE_TOOLING_APP_DEPLOY_CONTRACT_INVALID 69
[[ -s "$candidate_root/scripts/production-app-upgrade-preflight.ts" ]] || fail RELEASE_TOOLING_APP_PREFLIGHT_INVALID 69
# Until the 0.6 migration path is separately approved, a tooling refresh must
# preserve every command used by the current v0.5 production workflow.
grep -Fq 'CONFIRM_PRESERVE_DATA_V1' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fq '/usr/local/sbin/ai-project-os-preserve-deploy' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fq 'configure-github-oauth' "$GATEWAY" || fail RELEASE_TOOLING_GATEWAY_CONTRACT_INVALID 69
grep -Fqx 'limit_req_zone $binary_remote_addr zone=ai_project_os_auth:10m rate=10r/m;' "$NGINX_CONFIG" || \
  fail RELEASE_TOOLING_NGINX_CONFIG_CONTRACT_INVALID 69
python3 - "$NGINX_CONFIG" <<'PY' || fail RELEASE_TOOLING_NGINX_CONFIG_CONTRACT_INVALID 69
import re
import sys

configuration = open(sys.argv[1], encoding="utf-8").read()
oauth_zone = "limit_req_zone $binary_remote_addr zone=ai_project_os_oauth_authorize:10m rate=3r/m;"
locations = re.findall(r"(?ms)^    location = /oauth/authorize \{\n(?P<body>.*?)^    \}", configuration)
if configuration.count(oauth_zone) != 1 or len(locations) != 1:
    raise SystemExit(1)
body = locations[0]
for directive in (
    "limit_req zone=ai_project_os_oauth_authorize burst=3 nodelay;",
    "limit_req_status 429;",
    "include /etc/nginx/snippets/ai-project-os-proxy.conf;",
):
    if body.count(directive) != 1:
        raise SystemExit(1)
if "zone=ai_project_os_auth" in body:
    raise SystemExit(1)
PY
if [[ "$IS_V07_RELEASE" == true ]]; then
  grep -Fq '^deploy-v07\ (v0\.6\.0-dev\.[1-9][0-9]+)\ (v0\.7\.0)\ ([0-9a-f]{40})\ ([0-9a-f]{40})\ (CONFIRM_V07_MIGRATION_V1)$' "$GATEWAY" || \
    fail RELEASE_TOOLING_V07_GATEWAY_CONTRACT_INVALID 69
  grep -Fq 'exec sudo -n /usr/local/sbin/ai-project-os-v07-deploy' "$GATEWAY" || \
    fail RELEASE_TOOLING_V07_GATEWAY_CONTRACT_INVALID 69
  grep -Fq '"${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[5]}" "${BASH_REMATCH[6]}"' "$GATEWAY" || \
    fail RELEASE_TOOLING_V07_GATEWAY_CONTRACT_INVALID 69
  grep -Fq 'scripts/production-v07-upgrade-preflight.ts' "$V07_DEPLOYER" || \
    fail RELEASE_TOOLING_V07_DEPLOY_CONTRACT_INVALID 69
  grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-v07-deploy' "$SUDOERS" || \
    fail RELEASE_TOOLING_V07_SUDOERS_CONTRACT_INVALID 69
fi
grep -Fq 'v0.5.0-dev.1' "$PRESERVE_DEPLOYER" || fail RELEASE_TOOLING_PRESERVE_CONTRACT_INVALID 69
grep -Fq 'v0.5.0-dev.4' "$PRESERVE_DEPLOYER" || fail RELEASE_TOOLING_PRESERVE_CONTRACT_INVALID 69
grep -Fq 'CONFIRM_PRESERVE_DATA_V1' "$PRESERVE_DEPLOYER" || fail RELEASE_TOOLING_PRESERVE_CONTRACT_INVALID 69
grep -Fq 'v0.6.0-dev.6' "$BACKUP" || fail RELEASE_TOOLING_BACKUP_CONTRACT_INVALID 69
if ! python3 - "$BACKUP_ARTIFACT_HELPER" <<'PY'
import ast
import re
import sys

tree = ast.parse(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1])
pattern = None
for node in tree.body:
    targets = node.targets if isinstance(node, ast.Assign) else []
    if any(isinstance(target, ast.Name) and target.id == "BACKUP_NAME" for target in targets):
        value = node.value
        if (
            isinstance(value, ast.Call)
            and isinstance(value.func, ast.Attribute)
            and isinstance(value.func.value, ast.Name)
            and value.func.value.id == "re"
            and value.func.attr == "compile"
            and len(value.args) == 1
        ):
            pattern = re.compile(ast.literal_eval(value.args[0]))
            break
if pattern is None:
    raise SystemExit(1)
sample = "20260922T000000Z-pre-deploy-to-v0.6.0-dev.7.Abc123"
next_sample = "20260923T000000Z-pre-deploy-to-v0.6.0-dev.8.Abc123"
app_sample = "20260923T000000Z-pre-deploy-to-v0.6.0-dev.9.Abc123"
next_app_sample = "20260924T000000Z-pre-deploy-to-v0.6.0-dev.10.Abc123"
raise SystemExit(0 if all(pattern.fullmatch(item) is not None for item in (sample, next_sample, app_sample, next_app_sample)) else 1)
PY
then
  fail RELEASE_TOOLING_BACKUP_HELPER_CONTRACT_INVALID 69
fi
grep -Fq 'pre-deploy-to-v0\.6\.0-dev\.6' "$RESTORE" || fail RELEASE_TOOLING_RESTORE_CONTRACT_INVALID 69
grep -Fq 'pre-deploy-to-v0\.6\.0-dev\.7' "$RESTORE" || fail RELEASE_TOOLING_RESTORE_CONTRACT_INVALID 69
grep -Fq 'pre-deploy-to-v0\.6\.0-dev\.8' "$RESTORE" || fail RELEASE_TOOLING_RESTORE_CONTRACT_INVALID 69

visudo -cf "$SUDOERS" >/dev/null || fail RELEASE_TOOLING_SUDOERS_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-install-release-tooling' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-v06-deploy' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-v06-patch-deploy' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-v06-next-deploy' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-v06-default-memory-deploy' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-app-deploy' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-preserve-deploy' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
grep -Fqx 'ai-project-os-actions ALL=(root) NOPASSWD: /usr/local/sbin/ai-project-os-configure-github-oauth' "$SUDOERS" || \
  fail RELEASE_TOOLING_SUDOERS_CONTRACT_INVALID 69
if grep -Eq '(ALL=\(ALL|/bin/(ba)?sh|/usr/bin/(ba)?sh|\*)' "$SUDOERS"; then
  fail RELEASE_TOOLING_SUDOERS_TOO_BROAD 69
fi

# Refuse symlinked or non-root destination directories before creating any
# staged root file. Group/world-writable control directories fail closed.
for target_directory in /usr/local/sbin /usr/local/libexec/ai-project-os /etc/ai-project-os /etc/sudoers.d /etc/nginx/sites-available /etc/nginx/sites-enabled; do
  [[ -d "$target_directory" && ! -L "$target_directory" ]] || fail RELEASE_TOOLING_TARGET_DIRECTORY_INVALID 69
  [[ "$(stat -c %U:%G "$target_directory")" == root:root ]] || fail RELEASE_TOOLING_TARGET_DIRECTORY_INVALID 69
  target_permissions=$(stat -c %A "$target_directory")
  [[ "${target_permissions:5:1}" != w && "${target_permissions:8:1}" != w ]] || fail RELEASE_TOOLING_TARGET_DIRECTORY_INVALID 69
done

for destination in \
  /usr/local/sbin/ai-project-os-install-release-tooling \
  /usr/local/sbin/ai-project-os-deploy \
  /usr/local/sbin/ai-project-os-v06-deploy \
  /usr/local/sbin/ai-project-os-v06-patch-deploy \
  /usr/local/sbin/ai-project-os-v06-next-deploy \
  /usr/local/sbin/ai-project-os-v06-default-memory-deploy \
  /usr/local/sbin/ai-project-os-v07-deploy \
  /usr/local/sbin/ai-project-os-prepare-git-automation-secret \
  /usr/local/sbin/ai-project-os-app-deploy \
  /usr/local/sbin/ai-project-os-preserve-deploy \
  /usr/local/sbin/ai-project-os-backup \
  /usr/local/libexec/ai-project-os/backup-artifact.py \
  /usr/local/sbin/ai-project-os-restore \
  /usr/local/sbin/ai-project-os-configure-github-oauth \
  /etc/nginx/sites-available/ai-project-os.conf \
  /etc/ai-project-os/compose.operations.yaml \
  /etc/sudoers.d/ai-project-os-deploy \
  /usr/local/sbin/ai-project-os-actions-gateway; do
  [[ ! -e "$destination" || ( -f "$destination" && ! -L "$destination" ) ]] || fail RELEASE_TOOLING_TARGET_INVALID 69
done

[[ -f "$NGINX_CONFIG_DEST" && ! -L "$NGINX_CONFIG_DEST" ]] || fail RELEASE_TOOLING_NGINX_TARGET_INVALID 69
[[ "$(stat -c %U:%G "$NGINX_CONFIG_DEST")" == root:root ]] || fail RELEASE_TOOLING_NGINX_TARGET_INVALID 69
nginx_config_permissions=$(stat -c %A "$NGINX_CONFIG_DEST")
[[ "${nginx_config_permissions:5:1}" != w && "${nginx_config_permissions:8:1}" != w ]] || fail RELEASE_TOOLING_NGINX_TARGET_INVALID 69
[[ -L "$NGINX_ENABLED_PATH" && "$(readlink -- "$NGINX_ENABLED_PATH")" == "$NGINX_CONFIG_DEST" ]] || \
  fail RELEASE_TOOLING_NGINX_TARGET_INVALID 69

# Stage every file on its destination filesystem before the first rename. This
# catches validation, permission, and free-space failures while the old toolset
# is still fully intact.
stage_install() {
  local source=$1 destination=$2 mode=$3 output_variable=$4 temporary
  temporary=$(mktemp "$(dirname "$destination")/.release-tooling.XXXXXX")
  install -o root -g root -m "$mode" "$source" "$temporary"
  STAGED_FILES+=("$temporary")
  printf -v "$output_variable" '%s' "$temporary"
}

# Programs land before policy; the gateway lands last so every command it can
# expose already has both a validated binary and validated sudo rule.
stage_install "$UPDATER" /usr/local/sbin/ai-project-os-install-release-tooling 0755 staged_updater
stage_install "$DEPLOYER" /usr/local/sbin/ai-project-os-deploy 0755 staged_deployer
stage_install "$V06_DEPLOYER" /usr/local/sbin/ai-project-os-v06-deploy 0755 staged_v06_deployer
stage_install "$V06_PATCH_DEPLOYER" /usr/local/sbin/ai-project-os-v06-patch-deploy 0755 staged_v06_patch_deployer
stage_install "$V06_NEXT_DEPLOYER" /usr/local/sbin/ai-project-os-v06-next-deploy 0755 staged_v06_next_deployer
stage_install "$V06_DEFAULT_MEMORY_DEPLOYER" /usr/local/sbin/ai-project-os-v06-default-memory-deploy 0755 staged_v06_default_memory_deployer
stage_install "$APP_DEPLOYER" /usr/local/sbin/ai-project-os-app-deploy 0755 staged_app_deployer
stage_install "$PRESERVE_DEPLOYER" /usr/local/sbin/ai-project-os-preserve-deploy 0755 staged_preserve
stage_install "$BACKUP" /usr/local/sbin/ai-project-os-backup 0755 staged_backup
stage_install "$BACKUP_ARTIFACT_HELPER" /usr/local/libexec/ai-project-os/backup-artifact.py 0755 staged_backup_artifact
stage_install "$RESTORE" /usr/local/sbin/ai-project-os-restore 0755 staged_restore
stage_install "$OAUTH_CONFIGURATOR" /usr/local/sbin/ai-project-os-configure-github-oauth 0755 staged_oauth
stage_install "$NGINX_CONFIG" "$NGINX_CONFIG_DEST" 0644 staged_nginx_config
if [[ "$IS_V07_RELEASE" == true ]]; then
  stage_install "$V07_DEPLOYER" /usr/local/sbin/ai-project-os-v07-deploy 0755 staged_v07_deployer
  stage_install "$GIT_AUTOMATION_SECRET_PREPARER" /usr/local/sbin/ai-project-os-prepare-git-automation-secret 0755 staged_git_automation_secret_preparer
fi
stage_install "$COMPOSE_OVERRIDE" /etc/ai-project-os/compose.operations.yaml 0644 staged_compose
stage_install "$SUDOERS" /etc/sudoers.d/ai-project-os-deploy 0440 staged_sudoers
stage_install "$GATEWAY" /usr/local/sbin/ai-project-os-actions-gateway 0755 staged_gateway

mv -f -- "$staged_updater" /usr/local/sbin/ai-project-os-install-release-tooling
mv -f -- "$staged_deployer" /usr/local/sbin/ai-project-os-deploy
mv -f -- "$staged_v06_deployer" /usr/local/sbin/ai-project-os-v06-deploy
mv -f -- "$staged_v06_patch_deployer" /usr/local/sbin/ai-project-os-v06-patch-deploy
mv -f -- "$staged_v06_next_deployer" /usr/local/sbin/ai-project-os-v06-next-deploy
mv -f -- "$staged_v06_default_memory_deployer" /usr/local/sbin/ai-project-os-v06-default-memory-deploy
mv -f -- "$staged_app_deployer" /usr/local/sbin/ai-project-os-app-deploy
mv -f -- "$staged_preserve" /usr/local/sbin/ai-project-os-preserve-deploy
mv -f -- "$staged_backup" /usr/local/sbin/ai-project-os-backup
mv -f -- "$staged_backup_artifact" /usr/local/libexec/ai-project-os/backup-artifact.py
mv -f -- "$staged_restore" /usr/local/sbin/ai-project-os-restore
mv -f -- "$staged_oauth" /usr/local/sbin/ai-project-os-configure-github-oauth
if [[ "$IS_V07_RELEASE" == true ]]; then
  mv -f -- "$staged_v07_deployer" /usr/local/sbin/ai-project-os-v07-deploy
  mv -f -- "$staged_git_automation_secret_preparer" /usr/local/sbin/ai-project-os-prepare-git-automation-secret
fi
mv -f -- "$staged_compose" /etc/ai-project-os/compose.operations.yaml
mv -f -- "$staged_sudoers" /etc/sudoers.d/ai-project-os-deploy
visudo -cf /etc/sudoers.d/ai-project-os-deploy >/dev/null
mv -f -- "$staged_gateway" /usr/local/sbin/ai-project-os-actions-gateway
STAGED_FILES=("$staged_nginx_config")

NGINX_BACKUP_PATH=$(mktemp /etc/nginx/sites-available/.ai-project-os.conf.rollback.XXXXXX)
cp --preserve=mode,ownership -- "$NGINX_CONFIG_DEST" "$NGINX_BACKUP_PATH"
if systemctl is-active --quiet nginx; then
  NGINX_WAS_ACTIVE=true
fi
NGINX_CONFIG_PROMOTED=true
mv -f -- "$staged_nginx_config" "$NGINX_CONFIG_DEST"
nginx -t || fail RELEASE_TOOLING_NGINX_CONFIG_INVALID 69
if [[ "$NGINX_WAS_ACTIVE" == true ]]; then
  systemctl reload nginx || fail RELEASE_TOOLING_NGINX_RELOAD_FAILED 69
  systemctl is-active --quiet nginx || fail RELEASE_TOOLING_NGINX_RELOAD_FAILED 69
fi

# The marker is created only after all replacements succeed. Its checksums
# make a partially refreshed or subsequently modified toolchain fail status.
state_temporary=$(mktemp /etc/ai-project-os/.release-tooling-v07-state.XXXXXX)
printf 'tag=%s revision=%s\n' "$RELEASE_TAG" "$EXPECTED_REVISION" > "$state_temporary"
sha256sum "${V07_STATUS_FILES[@]}" >> "$state_temporary"
chown root:root "$state_temporary"
chmod 0600 "$state_temporary"
mv -f -- "$state_temporary" "$V07_STATE_FILE"
rm -f -- "$NGINX_BACKUP_PATH"
NGINX_BACKUP_PATH=""
NGINX_CONFIG_COMMITTED=true

printf 'RELEASE_TOOLING_INSTALL_OK tag=%s revision=%s\n' "$RELEASE_TAG" "$EXPECTED_REVISION"
